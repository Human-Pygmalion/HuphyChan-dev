--- /dev/null
+++ b/src/mjlab/tasks/velocity/evaluation/metrics.py
@@ -0,0 +1,857 @@
+"""Metric accumulation for velocity evaluation."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any
+
+import torch
+
+if TYPE_CHECKING:
+  from mjlab.entity import Entity
+  from mjlab.envs import ManagerBasedRlEnv
+  from mjlab.sensor import ContactSensor
+
+
+@dataclass(frozen=True)
+class MetricNames:
+  """Resolved robot names used by the evaluator."""
+
+  joint_names: tuple[str, ...]
+  actuator_names: tuple[str, ...]
+  body_names: tuple[str, ...]
+  foot_names: tuple[str, ...]
+
+
+@dataclass
+class PlotSamples:
+  """Downsampled rollout samples for plots."""
+
+  tau_cmd: list[torch.Tensor] = field(default_factory=list)
+  actuator_force: list[torch.Tensor] = field(default_factory=list)
+  qvel: list[torch.Tensor] = field(default_factory=list)
+  actuator_index: list[torch.Tensor] = field(default_factory=list)
+  scenario_index: list[torch.Tensor] = field(default_factory=list)
+  _count: int = 0
+
+  def append(
+    self,
+    *,
+    tau_cmd: torch.Tensor,
+    actuator_force: torch.Tensor,
+    qvel: torch.Tensor,
+    actuator_index: torch.Tensor,
+    scenario_index: torch.Tensor,
+    limit: int,
+  ) -> None:
+    """Append samples up to ``limit`` total rows."""
+    remaining = limit - self._count
+    if remaining <= 0:
+      return
+    if tau_cmd.numel() > remaining:
+      tau_cmd = tau_cmd[:remaining]
+      actuator_force = actuator_force[:remaining]
+      qvel = qvel[:remaining]
+      actuator_index = actuator_index[:remaining]
+      scenario_index = scenario_index[:remaining]
+    self.tau_cmd.append(tau_cmd.detach().cpu())
+    self.actuator_force.append(actuator_force.detach().cpu())
+    self.qvel.append(qvel.detach().cpu())
+    self.actuator_index.append(actuator_index.detach().cpu())
+    self.scenario_index.append(scenario_index.detach().cpu())
+    self._count += int(tau_cmd.numel())
+
+  def to_dict(self) -> dict[str, list[float] | list[int]]:
+    """Return JSON-friendly sampled data."""
+    if self._count == 0:
+      return {
+        "tau_cmd": [],
+        "actuator_force": [],
+        "qvel": [],
+        "actuator_index": [],
+        "scenario_index": [],
+      }
+    return {
+      "tau_cmd": torch.cat(self.tau_cmd).tolist(),
+      "actuator_force": torch.cat(self.actuator_force).tolist(),
+      "qvel": torch.cat(self.qvel).tolist(),
+      "actuator_index": torch.cat(self.actuator_index).tolist(),
+      "scenario_index": torch.cat(self.scenario_index).tolist(),
+    }
+
+
+class ChunkMetricAccumulator:
+  """Accumulate per-env rollout metrics for one vectorized evaluation chunk."""
+
+  def __init__(
+    self,
+    env: ManagerBasedRlEnv,
+    scenario_ids: torch.Tensor,
+    *,
+    slip_speed_threshold: float,
+    plot_sample_limit: int,
+    plot_sample_stride: int,
+  ) -> None:
+    self.env = env
+    self.robot: Entity = env.scene["robot"]
+    self.scenario_ids = scenario_ids
+    self.device = env.device
+    self.num_envs = env.num_envs
+    self.num_scenarios = int(scenario_ids.max().item()) + 1
+    self.num_joints = self.robot.num_joints
+    self.num_actuators = self.robot.num_actuators
+    self.num_bodies = self.robot.num_bodies
+    self.slip_speed_threshold = slip_speed_threshold
+    self.plot_sample_limit = plot_sample_limit
+    self.plot_sample_stride = max(1, plot_sample_stride)
+    self.samples = PlotSamples()
+
+    foot_ids, foot_names = self.robot.find_sites(
+      ("left_foot", "right_foot"), preserve_order=True
+    )
+    self.foot_site_ids = torch.tensor(foot_ids, device=self.device, dtype=torch.long)
+    self.foot_names = tuple(foot_names)
+    self.num_feet = len(foot_names)
+
+    self.act_to_joint_idx = self._resolve_actuator_joint_indices()
+    self.effort_limit, self.kp, self.kd = self._read_actuator_constants()
+    self.body_weight = self._read_body_weight()
+
+    self.count = torch.zeros(self.num_envs, device=self.device)
+    self.tracking_lin_error_sum = torch.zeros_like(self.count)
+    self.tracking_lin_error_sq_sum = torch.zeros_like(self.count)
+    self.tracking_lin_error_max = torch.zeros_like(self.count)
+    self.tracking_ang_error_sum = torch.zeros_like(self.count)
+    self.tracking_ang_error_sq_sum = torch.zeros_like(self.count)
+    self.tracking_ang_error_max = torch.zeros_like(self.count)
+    self.actual_lin_vel_sum = torch.zeros(self.num_envs, 2, device=self.device)
+    self.actual_ang_vel_sum = torch.zeros_like(self.count)
+    self.base_height_min = torch.full_like(self.count, float("inf"))
+
+    self.joint_pos_abs_sum = self._zeros_joint()
+    self.joint_pos_sq_sum = self._zeros_joint()
+    self.joint_pos_abs_max = self._zeros_joint()
+    self.joint_vel_abs_sum = self._zeros_joint()
+    self.joint_vel_sq_sum = self._zeros_joint()
+    self.joint_vel_abs_max = self._zeros_joint()
+    self.joint_acc_abs_sum = self._zeros_joint()
+    self.joint_acc_sq_sum = self._zeros_joint()
+    self.joint_acc_abs_max = self._zeros_joint()
+
+    self.tau_cmd_abs_sum = self._zeros_actuator()
+    self.tau_cmd_sq_sum = self._zeros_actuator()
+    self.tau_cmd_abs_max = self._zeros_actuator()
+    self.actuator_force_abs_sum = self._zeros_actuator()
+    self.actuator_force_sq_sum = self._zeros_actuator()
+    self.actuator_force_abs_max = self._zeros_actuator()
+    self.qfrc_actuator_abs_sum = self._zeros_actuator()
+    self.qfrc_actuator_sq_sum = self._zeros_actuator()
+    self.qfrc_actuator_abs_max = self._zeros_actuator()
+    self.torque_saturation_count = self._zeros_actuator()
+    self.torque_soft_limit_count = self._zeros_actuator()
+    self.power_abs_sum = self._zeros_actuator()
+    self.power_abs_max = self._zeros_actuator()
+
+    self.prev_contact = torch.zeros(
+      self.num_envs, self.num_feet, device=self.device, dtype=torch.bool
+    )
+    self.prev_contact_force = torch.zeros(
+      self.num_envs, self.num_feet, device=self.device
+    )
+    self.contact_count = self._zeros_foot()
+    self.contact_force_sum = self._zeros_foot()
+    self.contact_force_sq_sum = self._zeros_foot()
+    self.contact_force_max = self._zeros_foot()
+    self.contact_force_norm_sum = self._zeros_foot()
+    self.contact_force_norm_max = self._zeros_foot()
+    self.contact_impulse_sum = self._zeros_foot()
+    self.contact_impulse_norm_sum = self._zeros_foot()
+    self.loading_rate_max = self._zeros_foot()
+    self.loading_rate_norm_max = self._zeros_foot()
+    self.landing_count = self._zeros_foot()
+    self.landing_force_sum = self._zeros_foot()
+    self.landing_force_max = self._zeros_foot()
+    self.landing_force_norm_sum = self._zeros_foot()
+    self.landing_force_norm_max = self._zeros_foot()
+    self.landing_loading_rate_max = self._zeros_foot()
+    self.landing_loading_rate_norm_max = self._zeros_foot()
+
+    self.slip_speed_sum = self._zeros_foot()
+    self.slip_speed_sq_sum = self._zeros_foot()
+    self.slip_speed_max = self._zeros_foot()
+    self.slip_distance_sum = self._zeros_foot()
+    self.slip_over_threshold_count = self._zeros_foot()
+
+    self.cfrc_int_wrench_sum = self._zeros_body()
+    self.cfrc_int_wrench_max = self._zeros_body()
+    self.cfrc_int_force_sum = self._zeros_body()
+    self.cfrc_int_force_max = self._zeros_body()
+    self.cfrc_int_torque_sum = self._zeros_body()
+    self.cfrc_int_torque_max = self._zeros_body()
+    self.cfrc_ext_wrench_sum = self._zeros_body()
+    self.cfrc_ext_wrench_max = self._zeros_body()
+    self.cfrc_ext_force_sum = self._zeros_body()
+    self.cfrc_ext_force_max = self._zeros_body()
+    self.cfrc_ext_torque_sum = self._zeros_body()
+    self.cfrc_ext_torque_max = self._zeros_body()
+    self.has_cfrc_int = hasattr(env.sim.data, "cfrc_int")
+    self.has_cfrc_ext = hasattr(env.sim.data, "cfrc_ext")
+
+  @property
+  def names(self) -> MetricNames:
+    """Return resolved metric names."""
+    return MetricNames(
+      joint_names=self.robot.joint_names,
+      actuator_names=self.robot.actuator_names,
+      body_names=self.robot.body_names,
+      foot_names=self.foot_names,
+    )
+
+  def update(
+    self,
+    *,
+    active: torch.Tensor,
+    command: torch.Tensor,
+    step_index: int,
+  ) -> None:
+    """Accumulate metrics for active envs at the current state."""
+    if not active.any():
+      return
+    mask = active.float()
+    self.count += mask
+
+    actual_lin = self.robot.data.root_link_lin_vel_b[:, :2]
+    actual_ang = self.robot.data.root_link_ang_vel_b[:, 2]
+    lin_error = torch.norm(actual_lin - command[:, :2], dim=-1)
+    ang_error = torch.abs(actual_ang - command[:, 2])
+    self.tracking_lin_error_sum += lin_error * mask
+    self.tracking_lin_error_sq_sum += torch.square(lin_error) * mask
+    self.tracking_lin_error_max = torch.maximum(
+      self.tracking_lin_error_max, torch.where(active, lin_error, 0.0)
+    )
+    self.tracking_ang_error_sum += ang_error * mask
+    self.tracking_ang_error_sq_sum += torch.square(ang_error) * mask
+    self.tracking_ang_error_max = torch.maximum(
+      self.tracking_ang_error_max, torch.where(active, ang_error, 0.0)
+    )
+    self.actual_lin_vel_sum += actual_lin * mask[:, None]
+    self.actual_ang_vel_sum += actual_ang * mask
+    self.base_height_min = torch.minimum(
+      self.base_height_min,
+      torch.where(
+        active,
+        self.robot.data.root_link_pos_w[:, 2],
+        torch.full_like(self.base_height_min, float("inf")),
+      ),
+    )
+
+    self._accumulate_abs_sq_max(
+      self.robot.data.joint_pos,
+      active,
+      self.joint_pos_abs_sum,
+      self.joint_pos_sq_sum,
+      self.joint_pos_abs_max,
+    )
+    self._accumulate_abs_sq_max(
+      self.robot.data.joint_vel,
+      active,
+      self.joint_vel_abs_sum,
+      self.joint_vel_sq_sum,
+      self.joint_vel_abs_max,
+    )
+    self._accumulate_abs_sq_max(
+      self.robot.data.joint_acc,
+      active,
+      self.joint_acc_abs_sum,
+      self.joint_acc_sq_sum,
+      self.joint_acc_abs_max,
+    )
+
+    tau_cmd, actuator_force, qfrc_actuator, actuator_vel = self.actuator_quantities()
+    self._accumulate_abs_sq_max(
+      tau_cmd,
+      active,
+      self.tau_cmd_abs_sum,
+      self.tau_cmd_sq_sum,
+      self.tau_cmd_abs_max,
+    )
+    self._accumulate_abs_sq_max(
+      actuator_force,
+      active,
+      self.actuator_force_abs_sum,
+      self.actuator_force_sq_sum,
+      self.actuator_force_abs_max,
+    )
+    self._accumulate_abs_sq_max(
+      qfrc_actuator,
+      active,
+      self.qfrc_actuator_abs_sum,
+      self.qfrc_actuator_sq_sum,
+      self.qfrc_actuator_abs_max,
+    )
+    abs_tau = torch.abs(tau_cmd)
+    self.torque_saturation_count += (
+      abs_tau >= self.effort_limit[None, :] * 0.999
+    ).float() * mask[:, None]
+    self.torque_soft_limit_count += (
+      abs_tau >= self.effort_limit[None, :] * 0.7
+    ).float() * mask[:, None]
+    abs_power = torch.abs(actuator_force * actuator_vel)
+    self.power_abs_sum += abs_power * mask[:, None]
+    self.power_abs_max = torch.maximum(
+      self.power_abs_max, torch.where(active[:, None], abs_power, 0.0)
+    )
+
+    self._accumulate_contacts(active)
+    self._accumulate_cfrc(active)
+    self._maybe_sample_tau_v(
+      step_index=step_index,
+      active=active,
+      tau_cmd=tau_cmd,
+      actuator_force=actuator_force,
+      actuator_vel=actuator_vel,
+    )
+
+  def _zeros_joint(self) -> torch.Tensor:
+    return torch.zeros(self.num_envs, self.num_joints, device=self.device)
+
+  def _zeros_actuator(self) -> torch.Tensor:
+    return torch.zeros(self.num_envs, self.num_actuators, device=self.device)
+
+  def _zeros_body(self) -> torch.Tensor:
+    return torch.zeros(self.num_envs, self.num_bodies, device=self.device)
+
+  def _zeros_foot(self) -> torch.Tensor:
+    return torch.zeros(self.num_envs, self.num_feet, device=self.device)
+
+  def _accumulate_abs_sq_max(
+    self,
+    value: torch.Tensor,
+    active: torch.Tensor,
+    abs_sum: torch.Tensor,
+    sq_sum: torch.Tensor,
+    abs_max: torch.Tensor,
+  ) -> None:
+    mask = active[:, None]
+    abs_value = torch.abs(value)
+    abs_sum += abs_value * mask
+    sq_sum += torch.square(value) * mask
+    abs_max[:] = torch.maximum(abs_max, torch.where(mask, abs_value, 0.0))
+
+  def _resolve_actuator_joint_indices(self) -> torch.Tensor:
+    name_to_joint = {name: i for i, name in enumerate(self.robot.joint_names)}
+    return torch.tensor(
+      [name_to_joint[name] for name in self.robot.actuator_names],
+      device=self.device,
+      dtype=torch.long,
+    )
+
+  def _read_actuator_constants(self) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    ctrl_ids = self.robot.indexing.ctrl_ids
+    forcerange = self.env.sim.get_default_field("actuator_forcerange")[ctrl_ids]
+    effort_limit = torch.maximum(forcerange[:, 0].abs(), forcerange[:, 1].abs())
+    effort_limit = torch.where(
+      effort_limit > 0.0, effort_limit, torch.full_like(effort_limit, 1.0e9)
+    )
+    gainprm = self.env.sim.get_default_field("actuator_gainprm")[ctrl_ids]
+    biasprm = self.env.sim.get_default_field("actuator_biasprm")[ctrl_ids]
+    kp = gainprm[:, 0]
+    kd = -biasprm[:, 2]
+    return effort_limit, kp, kd
+
+  def _read_body_weight(self) -> torch.Tensor:
+    body_ids = self.robot.indexing.body_ids
+    body_mass = self.env.sim.model.body_mass
+    if body_mass.ndim == 1:
+      mass = body_mass[body_ids].sum().expand(self.num_envs)
+    else:
+      mass = body_mass[:, body_ids].sum(dim=-1)
+    return mass * 9.80665
+
+  def actuator_quantities(
+    self,
+  ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    ctrl_ids = self.robot.indexing.ctrl_ids
+    ctrl = self.env.sim.data.ctrl[:, ctrl_ids]
+    joint_pos = self.robot.data.joint_pos[:, self.act_to_joint_idx]
+    joint_vel = self.robot.data.joint_vel[:, self.act_to_joint_idx]
+    tau_cmd = self.kp[None, :] * (ctrl - joint_pos) - self.kd[None, :] * joint_vel
+    actuator_force = self.robot.data.actuator_force
+    qfrc_actuator = self.robot.data.qfrc_actuator[:, self.act_to_joint_idx]
+    return tau_cmd, actuator_force, qfrc_actuator, joint_vel
+
+  def _accumulate_contacts(self, active: torch.Tensor) -> None:
+    contact_sensor: ContactSensor = self.env.scene["feet_ground_contact"]
+    data = contact_sensor.data
+    assert data.found is not None
+    assert data.force is not None
+    in_contact = data.found > 0
+    force_mag = torch.norm(data.force, dim=-1)
+    if force_mag.shape[1] != self.num_feet:
+      force_mag = force_mag[:, : self.num_feet]
+      in_contact = in_contact[:, : self.num_feet]
+    active_contact = active[:, None] & in_contact
+    contact_float = active_contact.float()
+    force = torch.where(active_contact, force_mag, 0.0)
+    normalized_force = force / self.body_weight[:, None].clamp(min=1.0e-6)
+
+    self.contact_count += contact_float
+    self.contact_force_sum += force
+    self.contact_force_sq_sum += torch.square(force)
+    self.contact_force_max = torch.maximum(self.contact_force_max, force)
+    self.contact_force_norm_sum += normalized_force
+    self.contact_force_norm_max = torch.maximum(
+      self.contact_force_norm_max, normalized_force
+    )
+    self.contact_impulse_sum += force * self.env.step_dt
+    self.contact_impulse_norm_sum += normalized_force * self.env.step_dt
+
+    loading_rate = torch.clamp(
+      (force_mag - self.prev_contact_force) / self.env.step_dt, min=0.0
+    )
+    loading_rate = torch.where(active_contact, loading_rate, 0.0)
+    loading_rate_norm = loading_rate / self.body_weight[:, None].clamp(min=1.0e-6)
+    self.loading_rate_max = torch.maximum(self.loading_rate_max, loading_rate)
+    self.loading_rate_norm_max = torch.maximum(
+      self.loading_rate_norm_max, loading_rate_norm
+    )
+
+    first_contact = active[:, None] & in_contact & ~self.prev_contact
+    first_contact_float = first_contact.float()
+    landing_force = torch.where(first_contact, force_mag, 0.0)
+    landing_force_norm = landing_force / self.body_weight[:, None].clamp(min=1.0e-6)
+    landing_loading_rate = torch.where(first_contact, loading_rate, 0.0)
+    landing_loading_rate_norm = landing_loading_rate / self.body_weight[:, None].clamp(
+      min=1.0e-6
+    )
+    self.landing_count += first_contact_float
+    self.landing_force_sum += landing_force
+    self.landing_force_max = torch.maximum(self.landing_force_max, landing_force)
+    self.landing_force_norm_sum += landing_force_norm
+    self.landing_force_norm_max = torch.maximum(
+      self.landing_force_norm_max, landing_force_norm
+    )
+    self.landing_loading_rate_max = torch.maximum(
+      self.landing_loading_rate_max, landing_loading_rate
+    )
+    self.landing_loading_rate_norm_max = torch.maximum(
+      self.landing_loading_rate_norm_max, landing_loading_rate_norm
+    )
+
+    foot_vel_xy = self.robot.data.site_lin_vel_w[:, self.foot_site_ids, :2]
+    slip_speed = torch.norm(foot_vel_xy, dim=-1)
+    slip_speed_contact = torch.where(active_contact, slip_speed, 0.0)
+    self.slip_speed_sum += slip_speed_contact
+    self.slip_speed_sq_sum += torch.square(slip_speed_contact)
+    self.slip_speed_max = torch.maximum(self.slip_speed_max, slip_speed_contact)
+    self.slip_distance_sum += slip_speed_contact * self.env.step_dt
+    self.slip_over_threshold_count += (
+      slip_speed > self.slip_speed_threshold
+    ).float() * contact_float
+
+    self.prev_contact = torch.where(active[:, None], in_contact, self.prev_contact)
+    self.prev_contact_force = torch.where(
+      active[:, None], force_mag, self.prev_contact_force
+    )
+
+  def _accumulate_cfrc(self, active: torch.Tensor) -> None:
+    if self.has_cfrc_int:
+      wrench = self.env.sim.data.cfrc_int[:, self.robot.indexing.body_ids]
+      self._accumulate_wrench(
+        wrench,
+        active,
+        self.cfrc_int_wrench_sum,
+        self.cfrc_int_wrench_max,
+        self.cfrc_int_force_sum,
+        self.cfrc_int_force_max,
+        self.cfrc_int_torque_sum,
+        self.cfrc_int_torque_max,
+      )
+    if self.has_cfrc_ext:
+      wrench = self.env.sim.data.cfrc_ext[:, self.robot.indexing.body_ids]
+      self._accumulate_wrench(
+        wrench,
+        active,
+        self.cfrc_ext_wrench_sum,
+        self.cfrc_ext_wrench_max,
+        self.cfrc_ext_force_sum,
+        self.cfrc_ext_force_max,
+        self.cfrc_ext_torque_sum,
+        self.cfrc_ext_torque_max,
+      )
+
+  def _accumulate_wrench(
+    self,
+    wrench: torch.Tensor,
+    active: torch.Tensor,
+    wrench_sum: torch.Tensor,
+    wrench_max: torch.Tensor,
+    force_sum: torch.Tensor,
+    force_max: torch.Tensor,
+    torque_sum: torch.Tensor,
+    torque_max: torch.Tensor,
+  ) -> None:
+    mask = active[:, None]
+    # MuJoCo spatial cfrc vectors are ordered as rotational then translational.
+    torque_norm = torch.norm(wrench[..., :3], dim=-1)
+    force_norm = torch.norm(wrench[..., 3:], dim=-1)
+    wrench_norm = torch.norm(wrench, dim=-1)
+    wrench_sum += wrench_norm * mask
+    wrench_max[:] = torch.maximum(wrench_max, torch.where(mask, wrench_norm, 0.0))
+    force_sum += force_norm * mask
+    force_max[:] = torch.maximum(force_max, torch.where(mask, force_norm, 0.0))
+    torque_sum += torque_norm * mask
+    torque_max[:] = torch.maximum(torque_max, torch.where(mask, torque_norm, 0.0))
+
+  def _maybe_sample_tau_v(
+    self,
+    *,
+    step_index: int,
+    active: torch.Tensor,
+    tau_cmd: torch.Tensor,
+    actuator_force: torch.Tensor,
+    actuator_vel: torch.Tensor,
+  ) -> None:
+    if step_index % self.plot_sample_stride != 0:
+      return
+    active_ids = active.nonzero(as_tuple=False).flatten()
+    if len(active_ids) == 0:
+      return
+    active_ids = active_ids[:32]
+    tau = tau_cmd[active_ids].flatten()
+    force = actuator_force[active_ids].flatten()
+    vel = actuator_vel[active_ids].flatten()
+    actuator_index = torch.arange(
+      self.num_actuators, device=self.device, dtype=torch.long
+    ).repeat(len(active_ids))
+    scenario_index = self.scenario_ids[active_ids].repeat_interleave(self.num_actuators)
+    self.samples.append(
+      tau_cmd=tau,
+      actuator_force=force,
+      qvel=vel,
+      actuator_index=actuator_index,
+      scenario_index=scenario_index,
+      limit=self.plot_sample_limit,
+    )
+
+
+class GlobalMetricAccumulator:
+  """Merge successful chunk metrics by command scenario."""
+
