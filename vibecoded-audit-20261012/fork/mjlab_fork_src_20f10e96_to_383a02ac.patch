@@ -0,0 +1,94 @@
+"""Command scenarios for velocity evaluation."""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Literal
+
+from mjlab.tasks.velocity.evaluation.config import CommandGridConfig
+
+ScenarioKind = Literal["linear", "angular"]
+
+
+@dataclass(frozen=True)
+class VelocityCommandScenario:
+  """A fixed body-frame velocity command scenario."""
+
+  name: str
+  kind: ScenarioKind
+  lin_vel_x: float
+  lin_vel_y: float
+  ang_vel_z: float
+  speed: float
+  direction: str | None = None
+
+  @property
+  def command(self) -> tuple[float, float, float]:
+    """Return ``(lin_vel_x, lin_vel_y, ang_vel_z)``."""
+    return (self.lin_vel_x, self.lin_vel_y, self.ang_vel_z)
+
+
+# Body-frame convention: +x is forward, +y is robot-left, +z yaw is positive.
+_DIRECTION_VECTORS: dict[str, tuple[float, float]] = {
+  "N": (1.0, 0.0),
+  "NE": (1.0, -1.0),
+  "E": (0.0, -1.0),
+  "SE": (-1.0, -1.0),
+  "S": (-1.0, 0.0),
+  "SW": (-1.0, 1.0),
+  "W": (0.0, 1.0),
+  "NW": (1.0, 1.0),
+}
+
+
+def build_command_scenarios(cfg: CommandGridConfig) -> list[VelocityCommandScenario]:
+  """Build the default linear and angular command grid."""
+  scenarios: list[VelocityCommandScenario] = []
+  for speed in cfg.linear_speeds:
+    for direction in cfg.directions:
+      direction = direction.upper()
+      if direction not in _DIRECTION_VECTORS:
+        valid = ", ".join(_DIRECTION_VECTORS)
+        raise ValueError(f"Unknown direction '{direction}'. Valid directions: {valid}.")
+      unit_x, unit_y = _normalize_xy(_DIRECTION_VECTORS[direction])
+      scenarios.append(
+        VelocityCommandScenario(
+          name=f"lin_vel_{_format_speed(speed)}_{direction}",
+          kind="linear",
+          lin_vel_x=speed * unit_x,
+          lin_vel_y=speed * unit_y,
+          ang_vel_z=0.0,
+          speed=speed,
+          direction=direction,
+        )
+      )
+
+  for speed in cfg.angular_speeds:
+    for sign, label in ((-1.0, "neg"), (1.0, "pos")):
+      scenarios.append(
+        VelocityCommandScenario(
+          name=f"ang_vel_{_format_speed(speed)}_{label}",
+          kind="angular",
+          lin_vel_x=0.0,
+          lin_vel_y=0.0,
+          ang_vel_z=sign * speed,
+          speed=speed,
+        )
+      )
+  return scenarios
+
+
+def _normalize_xy(value: tuple[float, float]) -> tuple[float, float]:
+  x, y = value
+  norm = math.hypot(x, y)
+  if norm == 0.0:
+    return (0.0, 0.0)
+  return (x / norm, y / norm)
+
+
+def _format_speed(value: float) -> str:
+  text = f"{value:.6f}".rstrip("0").rstrip(".")
+  if "." not in text:
+    text = f"{text}.0"
+  return text.replace("-", "m").replace(".", "p")
