diff --git a/src/mjlab/tasks/velocity/config/pygmalion/delayed_action.py b/src/mjlab/tasks/velocity/config/pygmalion/delayed_action.py
new file mode 100644
index 00000000..20073069
--- /dev/null
+++ b/src/mjlab/tasks/velocity/config/pygmalion/delayed_action.py
@@ -0,0 +1,96 @@
+"""**명령이 조금 늦게 도착하는 것**과 **명령에 잡음이 섞이는 것**을 학습에 넣는다.
+
+2026-09-17 · 열린 일 #11. 조사한 실물 구현들은 전부 이걸 쓰는데 우리에겐 아예
+없었습니다. 그리고 사용자가 본 증상과 바로 이어집니다 —
+*"정책 실행하다가 로봇을 공중에 들 때가 있는데, 이러면 다리가 막 흔들리네."*
+
+## 왜 이것이 흔들림과 이어지나
+
+시뮬레이터에서는 정책이 낸 명령이 **그 순간** 모터에 닿습니다. 실물은 아닙니다.
+정책 계산 -> 통신 -> 모터 드라이버까지 시간이 걸립니다. 늦게 닿는 명령으로 되먹임을
+돌리면, 되먹임 이득이 같아도 **위상이 밀려서** 흔들리기 쉬워집니다. 특히 발이 땅에서
+떨어지면 관절이 떠받칠 것이 없어져 같은 명령에도 훨씬 크게 움직이므로(실효 이득이
+올라감), 지연이 있으면 그때 진동이 납니다. 시뮬에서 지연 없이 배운 정책은
+**이 위험을 아예 겪어 본 적이 없습니다.**
+
+그래서 학습에 지연을 넣는 것은 "혹시 몰라서" 가 아니라, 우리가 지금 보고 있는
+증상에 대한 곧바른 처방입니다. 조사한 자료도 같은 말을 합니다 — 지연 무작위화가
+*"prevent the robot from jittering caused by uncertainty delay during policy
+execution"* (2026-09-17 조사, docs/148 §2).
+
+## 어떻게 구현했나 — 남의 구현을 그대로 따른다
+
+`humanoid-gym` (roboterax) 의 `humanoid_env.py:194-196` 이 쓰는 방식 그대로입니다.
+
+    delay = torch.rand((self.num_envs, 1)) * self.cfg.domain_rand.action_delay
+    actions = (1 - delay) * actions + delay * self.actions
+    actions += self.cfg.domain_rand.action_noise * torch.randn_like(actions) * actions
+
+즉 **이번 명령과 지난 명령을 섞습니다.** 섞는 비율이 곧 지연량이고, 0~0.5 스텝처럼
+**한 스텝보다 짧은 지연**도 표현됩니다 (정수 스텝 버퍼로는 못 하는 일입니다).
+비율은 환경마다 다르고 **매 스텝 새로 뽑습니다** — 지연이 일정하지 않은 실물과 같습니다.
+그 저장소의 기본값은 `action_delay = 0.5`, `action_noise = 0.02` 입니다.
+
+잡음이 **곱셈**인 것도 그대로입니다 (`noise * randn * actions`). 명령이 클수록 오차도
+크다는 뜻으로, 모터 드라이버의 비례오차에 해당합니다.
+
+## 정책이 보는 값
+
+섞은 뒤의 명령을 `_raw_actions` 에 넣습니다. 그래서 관찰의 `actions` 항목에도
+**실제로 적용된 명령**이 들어갑니다. humanoid-gym 도 같습니다(`self.actions` 가 섞은
+뒤 값). 정책이 자기가 낸 값과 실제로 적용된 값 중 후자를 보게 되는 것이 맞습니다 —
+그래야 "내 명령이 그대로 안 갔다" 는 것을 관찰에서 알 수 있습니다.
+
+## 끄면 완전히 예전 그대로
+
+`max_delay`, `noise` 가 둘 다 0 이면 이 클래스는 부모와 **한 글자도 다르지 않게**
+동작합니다. 기존 학습의 재현성이 깨지지 않습니다.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+from mjlab.envs.mdp.actions import JointPositionAction, JointPositionActionCfg
+
+
+@dataclass(kw_only=True)
+class DelayedJointPositionActionCfg(JointPositionActionCfg):
+  """지연·잡음이 붙은 관절위치 명령.
+
+  ``max_delay``: 섞는 비율의 **최댓값**. 제어 스텝 단위입니다 (우리 제어는 50 Hz 라
+  1 스텝 = 20 ms). humanoid-gym 기본값 0.5 = 최대 10 ms.
+  ``noise``: 명령에 곱해지는 상대 잡음의 표준편차. humanoid-gym 기본값 0.02 = 2 %.
+  """
+
+  max_delay: float = 0.0
+  noise: float = 0.0
+
+  def build(self, env):                                    # type: ignore[override]
+    return DelayedJointPositionAction(self, env)
+
+
+class DelayedJointPositionAction(JointPositionAction):
+  def __init__(self, cfg: DelayedJointPositionActionCfg, env):
+    super().__init__(cfg=cfg, env=env)
+    self.max_delay = float(cfg.max_delay)
+    self.noise = float(cfg.noise)
+    self._prev = torch.zeros_like(self._raw_actions)
+
+  def process_actions(self, actions: torch.Tensor):
+    if self.max_delay > 0.0:
+      # 환경마다 다른 비율, **매 스텝 새로** 뽑는다 (실물 지연은 일정하지 않다).
+      d = torch.rand((actions.shape[0], 1), device=actions.device) * self.max_delay
+      actions = (1.0 - d) * actions + d * self._prev
+    if self.noise > 0.0:
+      actions = actions + self.noise * torch.randn_like(actions) * actions
+    self._prev = actions.detach().clone()
+    super().process_actions(actions)
+
+  def reset(self, env_ids=None) -> None:
+    super().reset(env_ids)
+    # 리셋한 환경은 "지난 명령" 이 없다. 0 으로 두면 기준자세를 뜻한다
+    # (명령 0 -> 목표 = default_q). 이전 에피소드의 명령이 새 에피소드로 새는 것을 막는다.
+    self._prev[env_ids if env_ids is not None else slice(None)] = 0.0
diff --git a/src/mjlab/tasks/velocity/config/pygmalion/env_cfgs.py b/src/mjlab/tasks/velocity/config/pygmalion/env_cfgs.py
new file mode 100755
index 00000000..b3522e20
--- /dev/null
+++ b/src/mjlab/tasks/velocity/config/pygmalion/env_cfgs.py
@@ -0,0 +1,1015 @@
+"""Pygmalion velocity environment configurations."""
+
+import dataclasses
+import math
+import os
+from pathlib import Path
+
+from mjlab import MJLAB_SRC_PATH
+from mjlab.asset_zoo.robots import (
+  PYG_ACTION_SCALE,
+  PYG_MOTOR_OBS_JOINT_NAMES,
+  PYG_OBS_JOINT_NAMES,
+  PYG_POSE_JOINT_NAMES,
+  get_pygmalion_robot_cfg,
+)
+from mjlab.asset_zoo.robots.pygmalion.pygmalion_constants import (
+  ANKLE_MODE,
+  ANKLE_RP_ENVELOPE,
+  safe_target_clip,
+)
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.envs import mdp as envs_mdp
+from mjlab.envs.mdp import dr
+from mjlab.envs.mdp.actions import JointPositionActionCfg
+from mjlab.managers.curriculum_manager import CurriculumTermCfg
+from mjlab.managers.event_manager import EventTermCfg
+from mjlab.managers.observation_manager import ObservationTermCfg
+from mjlab.managers.reward_manager import RewardTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+from mjlab.managers.termination_manager import TerminationTermCfg
+from mjlab.sensor import (
+  ContactMatch,
+  ContactSensorCfg,
+  ObjRef,
+  RayCastSensorCfg,
+  RingPatternCfg,
+  TerrainHeightSensorCfg,
+)
+from mjlab.tasks.velocity import mdp
+from mjlab.tasks.velocity.mdp import UniformVelocityCommandCfg
+from mjlab.tasks.velocity.velocity_env_cfg import make_velocity_env_cfg
+
+
+def pygmalion_rough_env_cfg(play: bool = False) -> ManagerBasedRlEnvCfg:
+  """Create Pygmalion rough terrain velocity configuration."""
+  cfg = make_velocity_env_cfg()
+
+  # MEMORY (2026-07-03): the EPA/CCD buffer scales as naccdmax(=nconmax*nworld)
+  # x ccd_iterations; ccd_iterations=500 + nconmax=150 demanded 37 GB at 8192
+  # envs (OOM even at 2048 on 16 GB). Flat trains fine at ccd_iterations=50;
+  # use 100 on rough for heightfield robustness headroom.
+  cfg.sim.mujoco.ccd_iterations = 100
+  cfg.sim.contact_sensor_maxmatch = 500
+  # Pygmalion's full self-collision set plus 10 foot capsules generate ~89
+  # contacts per world at init (more than G1's 70), so allocate extra headroom.
+  cfg.sim.nconmax = 150
+
+  cfg.scene.entities = {"robot": get_pygmalion_robot_cfg()}
+
+  # Set raycast sensor frame to Pygmalion trunk (base_link).
+  for sensor in cfg.scene.sensors or ():
+    if sensor.name == "terrain_scan":
+      assert isinstance(sensor, RayCastSensorCfg)
+      assert isinstance(sensor.frame, ObjRef)
+      sensor.frame.name = "base_link"
+
+  site_names = ("left_foot", "right_foot")
+  # Foot collision geoms: pygmalion_v2 has five capsules per foot (L_foot2..6_collision),
+  # the v3_printed / loop builds a single box sole (L_foot1_collision) - match by regex so
+  # the friction DR never silently targets a geom set that does not exist (2026-08-23).
+  geom_names = tuple(rf"{side}_foot\d+_collision" for side in ("L", "R"))
+
+  # Wire foot height scan to per-foot sites.
+  for sensor in cfg.scene.sensors or ():
+    if sensor.name == "foot_height_scan":
+      assert isinstance(sensor, TerrainHeightSensorCfg)
+      sensor.frame = tuple(
+        ObjRef(type="site", name=s, entity="robot") for s in site_names
+      )
+      sensor.pattern = RingPatternCfg.single_ring(radius=0.03, num_samples=6)
+
+  feet_ground_cfg = ContactSensorCfg(
+    name="feet_ground_contact",
+    primary=ContactMatch(
+      mode="subtree",
+      pattern=r"^(L_foot_link|R_foot_link)$",
+      entity="robot",
+    ),
+    secondary=ContactMatch(mode="body", pattern="terrain"),
+    fields=("found", "force"),
+    reduce="netforce",
+    num_slots=1,
+    track_air_time=True,
+    # 50 Hz policy steps otherwise see only one instantaneous contact sample.
+    # Keep four samples (80 ms) for loading-rate/impact diagnostics and rewards.
+    history_length=4,
+  )
+  self_collision_cfg = ContactSensorCfg(
+    name="self_collision",
+    primary=ContactMatch(mode="subtree", pattern="base_link", entity="robot"),
+    secondary=ContactMatch(mode="subtree", pattern="base_link", entity="robot"),
+    fields=("found", "force"),
+    reduce="none",
+    num_slots=1,
+    history_length=4,
+  )
+  cfg.scene.sensors = (cfg.scene.sensors or ()) + (
+    feet_ground_cfg,
+    self_collision_cfg,
+  )
+
+  if cfg.scene.terrain is not None and cfg.scene.terrain.terrain_generator is not None:
+    cfg.scene.terrain.terrain_generator.curriculum = True
+
+  joint_pos_action = cfg.actions["joint_pos"]
+  assert isinstance(joint_pos_action, JointPositionActionCfg)
+  joint_pos_action.scale = PYG_ACTION_SCALE
+  if os.environ.get("PYG_SAFE_TARGET_CLIP"):
+    # Clip the processed position target (not the raw policy output) to the same
+    # centered 90% mechanical envelope used by Entity.soft_joint_pos_limits.
+    # This leaves a stop margin and gives the deployment runtime an exact clamp
+    # contract. Previous-action observation intentionally remains the raw action.
+    # 2026-09-03: derived PER JOINT from the model instead of a hand-written regex table.
+    # The old table had one knee tuple, (-114, -6) deg, correct for a [-120, 0] knee and
+    # EMPTY against v30's mirrored [0, +120] left knee - the policy could not command a
+    # single reachable left-knee angle for 5,700 iterations. Values are unchanged on every
+    # model whose legs share a convention; the mode branch is gone because the derivation
+    # already covers exactly the joints this run actuates (cranks in AB, ankles in RP).
+    # docs/reward_research/2026-09-03_stiff_knee_root_cause.md
+    joint_pos_action.clip = safe_target_clip()
+
+  # PYG_ANKLE_LOOP (2026-08-23): the closed-loop ankle adds passive joints to the tree -
+  # per leg the two ankle hinges plus four rod universal hinges. The policy only sees the
+  # joints the hardware can report (motors + ankle via the mechanism's FK), and the pose
+  # reward shapes the same set minus the cranks (the foot pose is what matters, not the
+  # motor angle). In serial mode both tuples are (".*",) and nothing changes.
+  for grp in ("actor", "critic"):
+    for term in ("joint_pos", "joint_vel"):
+      cfg.observations[grp].terms[term].params = {
+        "asset_cfg": SceneEntityCfg("robot", joint_names=PYG_OBS_JOINT_NAMES)
+      }
+  cfg.rewards["pose"].params["asset_cfg"] = SceneEntityCfg(
+    "robot", joint_names=PYG_POSE_JOINT_NAMES
+  )
+
+  # Sim-to-real: base linear velocity has no IMU equivalent on hardware (the
