+          "y": (-0.7, 0.7),
+          "z": (-0.4, 0.4),
+          "roll": (-0.52, 0.52),
+          "pitch": (-0.52, 0.52),
+          "yaw": (-0.78, 0.78),
+        },
+        "friction_max": (0.3, 1.2),
+        "encoder_max": (-0.015, 0.015),
+        "com_max": {0: (-0.025, 0.025), 1: (-0.025, 0.025), 2: (-0.03, 0.03)},
+      },
