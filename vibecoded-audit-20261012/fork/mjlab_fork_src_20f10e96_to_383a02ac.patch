@@ -0,0 +1,232 @@
+"""Raw rollout recording for velocity evaluation."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, cast
+
+import numpy as np
+import torch
+
+from mjlab.tasks.velocity.evaluation.metrics import ChunkMetricAccumulator
+from mjlab.tasks.velocity.evaluation.scenarios import VelocityCommandScenario
+
+if TYPE_CHECKING:
+  from mjlab.envs import ManagerBasedRlEnv
+
+
+class RawScenarioRecorder:
+  """Record per-step raw arrays for one command scenario."""
+
+  def __init__(
+    self,
+    env: ManagerBasedRlEnv,
+    metrics: ChunkMetricAccumulator,
+    scenario: VelocityCommandScenario,
+    command: torch.Tensor,
+    *,
+    max_steps: int,
+    warmup_steps: int,
+    save_cfrc_components: bool,
+  ) -> None:
+    self.env = env
+    self.metrics = metrics
+    self.robot = env.scene["robot"]
+    self.scenario = scenario
+    self.max_steps = max_steps
+    self.warmup_steps = warmup_steps
+    self.save_cfrc_components = save_cfrc_components
+    self.num_envs = env.num_envs
+    self.num_joints = self.robot.num_joints
+    self.num_actuators = self.robot.num_actuators
+    self.num_feet = metrics.num_feet
+    self.num_bodies = self.robot.num_bodies
+    self.command = command.detach().cpu().numpy().astype(np.float32)
+
+    t = max_steps
+    e = self.num_envs
+    j = self.num_joints
+    a = self.num_actuators
+    f = self.num_feet
+    b = self.num_bodies
+
+    self.active = np.zeros((t, e), dtype=bool)
+    self.measured = np.zeros((t, e), dtype=bool)
+    self.root_lin_vel_b = _nan_array(t, e, 2)
+    self.root_ang_vel_b_z = _nan_array(t, e)
+    self.base_height = _nan_array(t, e)
+    self.joint_pos = _nan_array(t, e, j)
+    self.joint_vel = _nan_array(t, e, j)
+    self.joint_acc = _nan_array(t, e, j)
+    self.tau_cmd_unclipped = _nan_array(t, e, a)
+    self.actuator_force = _nan_array(t, e, a)
+    self.qfrc_actuator = _nan_array(t, e, a)
+    self.actuator_velocity = _nan_array(t, e, a)
+    self.foot_contact = np.zeros((t, e, f), dtype=bool)
+    self.foot_force = _nan_array(t, e, f)
+    self.slip_speed = _nan_array(t, e, f)
+    self.cfrc_int_wrench_norm = _nan_array(t, e, b)
+    self.cfrc_int_force_norm = _nan_array(t, e, b)
+    self.cfrc_int_torque_norm = _nan_array(t, e, b)
+    self.cfrc_ext_wrench_norm = _nan_array(t, e, b)
+    self.cfrc_ext_force_norm = _nan_array(t, e, b)
+    self.cfrc_ext_torque_norm = _nan_array(t, e, b)
+    self.cfrc_int = _nan_array(t, e, b, 6) if save_cfrc_components else None
+    self.cfrc_ext = _nan_array(t, e, b, 6) if save_cfrc_components else None
+
+  def record(self, step: int, active: torch.Tensor, measured: torch.Tensor) -> None:
+    """Record current simulator state at ``step``."""
+    if step >= self.max_steps:
+      return
+    active_np = active.detach().cpu().numpy().astype(bool)
+    measured_np = measured.detach().cpu().numpy().astype(bool)
+    self.active[step] = active_np
+    self.measured[step] = measured_np
+    if not active.any():
+      return
+
+    active_ids = active.nonzero(as_tuple=False).flatten()
+    active_np_ids = active_ids.detach().cpu().numpy()
+    tau_cmd, actuator_force, qfrc_actuator, actuator_velocity = (
+      self.metrics.actuator_quantities()
+    )
+    self.root_lin_vel_b[step, active_np_ids] = _cpu_np(
+      self.robot.data.root_link_lin_vel_b[active_ids, :2]
+    )
+    self.root_ang_vel_b_z[step, active_np_ids] = _cpu_np(
+      self.robot.data.root_link_ang_vel_b[active_ids, 2]
+    )
+    self.base_height[step, active_np_ids] = _cpu_np(
+      self.robot.data.root_link_pos_w[active_ids, 2]
+    )
+    self.joint_pos[step, active_np_ids] = _cpu_np(self.robot.data.joint_pos[active_ids])
+    self.joint_vel[step, active_np_ids] = _cpu_np(self.robot.data.joint_vel[active_ids])
+    self.joint_acc[step, active_np_ids] = _cpu_np(self.robot.data.joint_acc[active_ids])
+    self.tau_cmd_unclipped[step, active_np_ids] = _cpu_np(tau_cmd[active_ids])
+    self.actuator_force[step, active_np_ids] = _cpu_np(actuator_force[active_ids])
+    self.qfrc_actuator[step, active_np_ids] = _cpu_np(qfrc_actuator[active_ids])
+    self.actuator_velocity[step, active_np_ids] = _cpu_np(actuator_velocity[active_ids])
+
+    contact_sensor = self.env.scene["feet_ground_contact"]
+    contact_data = contact_sensor.data
+    assert contact_data.found is not None
+    assert contact_data.force is not None
+    foot_contact = contact_data.found[:, : self.num_feet] > 0
+    foot_force = torch.norm(contact_data.force[:, : self.num_feet], dim=-1)
+    foot_vel_xy = self.robot.data.site_lin_vel_w[:, self.metrics.foot_site_ids, :2]
+    slip_speed = torch.norm(foot_vel_xy, dim=-1)
+    self.foot_contact[step, active_np_ids] = _cpu_np(foot_contact[active_ids])
+    self.foot_force[step, active_np_ids] = _cpu_np(foot_force[active_ids])
+    self.slip_speed[step, active_np_ids] = _cpu_np(slip_speed[active_ids])
+
+    self._record_cfrc(step, active_ids, active_np_ids)
+
+  def save(
+    self,
+    path: Path,
+    *,
+    success: torch.Tensor,
+    failed: torch.Tensor,
+    failure_reasons: dict[str, torch.Tensor],
+  ) -> None:
+    """Save raw arrays to compressed NPZ."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    payload: dict[str, Any] = {
+      "time": np.arange(self.max_steps, dtype=np.float32) * self.env.step_dt,
+      "warmup_steps": np.asarray(self.warmup_steps, dtype=np.int32),
+      "command": self.command,
+      "success": success.detach().cpu().numpy().astype(bool),
+      "failed": failed.detach().cpu().numpy().astype(bool),
+      "joint_names": np.asarray(self.robot.joint_names),
+      "actuator_names": np.asarray(self.robot.actuator_names),
+      "body_names": np.asarray(self.robot.body_names),
+      "foot_names": np.asarray(self.metrics.foot_names),
+      "failure_reason_names": np.asarray(tuple(failure_reasons.keys())),
+      "failure_reason_values": np.stack(
+        [v.detach().cpu().numpy().astype(bool) for v in failure_reasons.values()],
+        axis=0,
+      ),
+      "active": self.active,
+      "measured": self.measured,
+      "root_lin_vel_b": self.root_lin_vel_b,
+      "root_ang_vel_b_z": self.root_ang_vel_b_z,
+      "base_height": self.base_height,
+      "joint_pos": self.joint_pos,
+      "joint_vel": self.joint_vel,
+      "joint_acc": self.joint_acc,
+      "tau_cmd_unclipped": self.tau_cmd_unclipped,
+      "actuator_force": self.actuator_force,
+      "qfrc_actuator": self.qfrc_actuator,
+      "actuator_velocity": self.actuator_velocity,
+      "foot_contact": self.foot_contact,
+      "foot_force": self.foot_force,
+      "slip_speed": self.slip_speed,
+      "cfrc_int_wrench_norm": self.cfrc_int_wrench_norm,
+      "cfrc_int_force_norm": self.cfrc_int_force_norm,
+      "cfrc_int_torque_norm": self.cfrc_int_torque_norm,
+      "cfrc_ext_wrench_norm": self.cfrc_ext_wrench_norm,
+      "cfrc_ext_force_norm": self.cfrc_ext_force_norm,
+      "cfrc_ext_torque_norm": self.cfrc_ext_torque_norm,
+    }
+    if self.cfrc_int is not None:
+      payload["cfrc_int"] = self.cfrc_int
+    if self.cfrc_ext is not None:
+      payload["cfrc_ext"] = self.cfrc_ext
+    np.savez_compressed(path, **cast(Any, payload))
+
+  def _record_cfrc(
+    self, step: int, active_ids: torch.Tensor, active_np_ids: np.ndarray
+  ) -> None:
+    if self.metrics.has_cfrc_int:
+      cfrc_int = self.env.sim.data.cfrc_int[:, self.robot.indexing.body_ids]
+      self._record_wrench_norms(
+        step,
+        active_ids,
+        active_np_ids,
+        cfrc_int,
+        self.cfrc_int_wrench_norm,
+        self.cfrc_int_force_norm,
+        self.cfrc_int_torque_norm,
+      )
+      if self.cfrc_int is not None:
+        self.cfrc_int[step, active_np_ids] = _cpu_np(cfrc_int[active_ids])
+    if self.metrics.has_cfrc_ext:
+      cfrc_ext = self.env.sim.data.cfrc_ext[:, self.robot.indexing.body_ids]
+      self._record_wrench_norms(
+        step,
+        active_ids,
+        active_np_ids,
+        cfrc_ext,
+        self.cfrc_ext_wrench_norm,
+        self.cfrc_ext_force_norm,
+        self.cfrc_ext_torque_norm,
+      )
+      if self.cfrc_ext is not None:
+        self.cfrc_ext[step, active_np_ids] = _cpu_np(cfrc_ext[active_ids])
+
+  def _record_wrench_norms(
+    self,
+    step: int,
+    active_ids: torch.Tensor,
+    active_np_ids: np.ndarray,
+    wrench: torch.Tensor,
+    wrench_norm_dest: np.ndarray,
+    force_norm_dest: np.ndarray,
+    torque_norm_dest: np.ndarray,
+  ) -> None:
+    active_wrench = wrench[active_ids]
+    wrench_norm_dest[step, active_np_ids] = _cpu_np(torch.norm(active_wrench, dim=-1))
+    torque_norm_dest[step, active_np_ids] = _cpu_np(
+      torch.norm(active_wrench[..., :3], dim=-1)
+    )
+    force_norm_dest[step, active_np_ids] = _cpu_np(
+      torch.norm(active_wrench[..., 3:], dim=-1)
+    )
+
+
+def _nan_array(*shape: int) -> np.ndarray:
+  return np.full(shape, np.nan, dtype=np.float32)
+
+
+def _cpu_np(value: torch.Tensor) -> np.ndarray:
+  return value.detach().cpu().numpy().astype(np.float32)
