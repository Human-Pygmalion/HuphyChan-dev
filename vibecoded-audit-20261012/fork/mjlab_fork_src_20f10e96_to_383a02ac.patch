+def gait_clock(env: ManagerBasedRlEnv, period: float = 1.0) -> torch.Tensor:
+  """Observation: [sin 2*pi*phi, cos 2*pi*phi] of the shared gait clock."""
+  phi = _gait_phase(env, period)
+  two_pi = 2.0 * torch.pi
+  return torch.stack([torch.sin(two_pi * phi), torch.cos(two_pi * phi)], dim=-1)
+
