@@ -0,0 +1,92 @@
+"""Output writing for velocity policy evaluation runs."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+from mjlab.tasks.velocity.evaluation.config import VelocityEvalConfig
+from mjlab.tasks.velocity.evaluation.metrics import GlobalMetricAccumulator
+from mjlab.tasks.velocity.evaluation.report import build_scenario_summary
+from mjlab.tasks.velocity.evaluation.scenarios import VelocityCommandScenario
+from mjlab.tasks.velocity.evaluation.visualization import (
+  write_overview_plots,
+  write_scenario_plots,
+)
+
+ACTUATOR_NOTE_DOC = "docs/my_docs/pygmalion_actuator_gear.md"
+
+
+def write_evaluation_outputs(
+  *,
+  cfg: VelocityEvalConfig,
+  scenarios: list[VelocityCommandScenario],
+  metrics: GlobalMetricAccumulator,
+  model_audit: dict[str, Any],
+  output_root: Path,
+  raw_files_by_scenario: dict[str, list[Path]],
+) -> dict[str, Any]:
+  """Write root and per-scenario JSON files plus reusable diagnostic plots."""
+  output_root.mkdir(parents=True, exist_ok=True)
+  scenario_summaries: list[dict[str, Any]] = []
+
+  for scenario_index, scenario in enumerate(scenarios):
+    scenario_dir = output_root / scenario.name
+    scenario_dir.mkdir(parents=True, exist_ok=True)
+    scenario_summary = build_scenario_summary(metrics, scenario, scenario_index)
+    raw_files = raw_files_by_scenario.get(scenario.name, [])
+    scenario_summary["scenario_dir"] = str(scenario_dir)
+    scenario_summary["raw_files"] = [str(path) for path in raw_files]
+    scenario_summary["plots"] = {}
+    if cfg.save_plots:
+      scenario_summary["plots"] = write_scenario_plots(
+        scenario_dir, scenario_summary, model_audit
+      )
+    _write_json(
+      scenario_dir / "summary.json",
+      {
+        "config": cfg.to_dict(),
+        "actuator_note_doc": ACTUATOR_NOTE_DOC,
+        "model_audit": model_audit,
+        "scenario": scenario_summary,
+      },
+    )
+    scenario_summaries.append(scenario_summary)
+
+  overview_plots = (
+    write_overview_plots(output_root, scenario_summaries) if cfg.save_plots else {}
+  )
+  summary = {
+    "config": cfg.to_dict(),
+    "output_root": str(output_root),
+    "actuator_note_doc": ACTUATOR_NOTE_DOC,
+    "overall": _overall_summary(metrics),
+    "plots": overview_plots,
+    "model_audit": model_audit,
+    "scenarios": scenario_summaries,
+    "raw_aggregates": metrics.to_summary(),
+  }
+  _write_json(output_root / "summary.json", summary)
+  _write_json(output_root / "config.json", cfg.to_dict())
+  _write_json(output_root / "model_audit.json", model_audit)
+  return summary
+
+
+def _overall_summary(metrics: GlobalMetricAccumulator) -> dict[str, int | float]:
+  episodes = float(metrics.episodes.sum().item())
+  successes = float(metrics.successes.sum().item())
+  failures = float(metrics.failures.sum().item())
+  success_rate = successes / episodes if episodes > 0.0 else 0.0
+  return {
+    "episodes": int(episodes),
+    "successes": int(successes),
+    "failures": int(failures),
+    "success_rate": float(success_rate),
+  }
+
+
+def _write_json(path: Path, value: Any) -> None:
+  path.parent.mkdir(parents=True, exist_ok=True)
+  with path.open("w") as f:
+    json.dump(value, f, indent=2)
