+class foot_loading_rate:
+  """Penalise the vertical LOADING RATE just after touchdown, not the touchdown speed.
+
+  Why this exists: penalising touchdown speed has one cheapest answer - land on a leg that
+  is already bent - and that is exactly what the c3 policies learned (touchdown knee -30 to
+  -38 deg against a human -5, no M-shaped GRF, docs/104). A human lands on a nearly straight
+  leg and absorbs eccentrically; what stays low is dF/dt, not the foot speed. So the target
+  is the rate.
+
+  cost = sum_feet max over the first ``window_s`` after touchdown of relu(dF_z/dt) / BW,
+  squared. Only the rising edge counts (relu), so lifting off is free.
+
+  ONE STEP OF WARNING (docs/reward_research/2026-08-26_human_landing_bundle.md s3c): the
+  degenerate answer to a loading-rate penalty is NEVER LEAVING THE GROUND - dF/dt is zero if
+  the foot never lands. air_time / flight_frac / stride MUST be watched as gate metrics.
+  At 50 Hz this underestimates the true rate (the 200 Hz impact_probe is the reference);
+  it is a shaped signal, not a calibrated one.
+  """
+
+  def __init__(self, cfg: RewardTermCfg, env: ManagerBasedRlEnv):
+    contact_sensor = env.scene[cfg.params["sensor_name"]]
+    n_feet = contact_sensor.data.force.shape[1]
+    self._prev_f = torch.zeros(env.num_envs, n_feet, device=env.device)
+    self._peak = torch.zeros(env.num_envs, n_feet, device=env.device)
+    self._age = torch.full((env.num_envs, n_feet), 1e3, device=env.device)
+
+  def __call__(
+    self,
+    env: ManagerBasedRlEnv,
+    sensor_name: str,
+    body_weight: float = 346.8,
+    window_s: float = 0.06,
+    contact_threshold: float = 7.0,
+    command_name: str | None = None,
+    command_threshold: float = 0.05,
+  ) -> torch.Tensor:
+    contact_sensor: ContactSensor = env.scene[sensor_name]
+    assert contact_sensor.data.force is not None
+    # SIGN: the feet sensor is reduce="netforce", so `force` is a global-frame 3-vector whose
+    # z component is NEGATIVE while the foot is loaded (-577..0 N measured, docs/reward_research/
+    # 2026-08-26_human_landing_bundle.md s12). Every other contact reward here takes
+    # torch.norm(), which hides that; this term was the only one to read a signed component and
+    # it read it the wrong way round, so `in_contact` was never true and the term was silently
+    # dead for three runs. Negate, then clamp.
+    f = (-contact_sensor.data.force[..., 2]).clamp(min=0.0)  # [B, F] vertical load
+    in_contact = f > contact_threshold
+    rate = torch.clamp(f - self._prev_f, min=0.0) / env.step_dt / body_weight  # BW/s
+    self._prev_f = f.clone()
+
+    touchdown = in_contact & (self._age > window_s)
+    self._age = torch.where(
+      touchdown, torch.zeros_like(self._age), self._age + env.step_dt
+    )
+    self._age = torch.where(in_contact, self._age, torch.full_like(self._age, 1e3))
+    inside = in_contact & (self._age <= window_s)
+    self._peak = torch.where(
+      touchdown, rate, torch.where(inside, torch.maximum(self._peak, rate), self._peak)
+    )
+
+    scored = inside & (self._age >= window_s - env.step_dt)  # score once, at window end
+    cost = torch.sum((self._peak * scored.float()) ** 2, dim=1)
+    if scored.any():
+      env.extras["log"]["Metrics/loading_rate_mean"] = self._peak[scored].mean()
+      env.extras["log"]["Metrics/loading_rate_max"] = self._peak[scored].max()
+    if command_name is not None:
+      command = env.command_manager.get_command(command_name)
+      if command is not None:
+        active = (
+          torch.norm(command[:, :2], dim=1) + torch.abs(command[:, 2])
+          > command_threshold
+        ).float()
+        cost = cost * active
+    return cost
+
