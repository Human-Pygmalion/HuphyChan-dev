+"""Reusable visualization utilities for saved velocity evaluation outputs."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+def regenerate_plots_from_output(output_root: Path) -> dict[str, Any]:
+  """Regenerate plots for an existing evaluation output directory."""
+  summary_path = output_root / "summary.json"
+  with summary_path.open() as f:
+    summary = json.load(f)
+  model_audit = summary.get("model_audit", {})
+  scenario_summaries = list(summary.get("scenarios", []))
+  for scenario_summary in scenario_summaries:
+    scenario_dir = Path(
+      str(scenario_summary.get("scenario_dir", output_root / scenario_summary["name"]))
+    )
+    scenario_summary["plots"] = write_scenario_plots(
+      scenario_dir, scenario_summary, model_audit
+    )
+    scenario_json = scenario_dir / "summary.json"
+    if scenario_json.exists():
+      with scenario_json.open() as f:
+        scenario_payload = json.load(f)
+      scenario_payload["scenario"] = scenario_summary
+      with scenario_json.open("w") as f:
+        json.dump(scenario_payload, f, indent=2)
+  summary["scenarios"] = scenario_summaries
+  summary["plots"] = write_overview_plots(output_root, scenario_summaries)
+  with summary_path.open("w") as f:
+    json.dump(summary, f, indent=2)
+  return summary
+
+
+def write_overview_plots(
+  output_root: Path,
+  scenario_summaries: list[dict[str, Any]],
+) -> dict[str, str]:
+  """Write overview plots from scenario summaries."""
+  plt = _pyplot()
+  if plt is None:
+    return {}
+  plot_dir = output_root / "plots"
+  plot_dir.mkdir(parents=True, exist_ok=True)
+  labels = [s["name"] for s in scenario_summaries]
+  x = np.arange(len(labels))
+  success = np.asarray([s["success_rate"] for s in scenario_summaries], dtype=float)
+  lin_error = np.asarray(
+    [s["tracking"]["linear_error_mean"] for s in scenario_summaries], dtype=float
+  )
+  ang_error = np.asarray(
+    [s["tracking"]["angular_error_mean"] for s in scenario_summaries], dtype=float
+  )
+
+  fig, axes = plt.subplots(3, 1, figsize=(14, 9), constrained_layout=True)
+  axes[0].bar(x, success, color="#3a7ca5")
+  axes[0].set_ylabel("success rate")
+  axes[0].set_ylim(0.0, 1.05)
+  axes[1].bar(x, lin_error, color="#4f8f5b")
+  axes[1].set_ylabel("linear error [m/s]")
+  axes[2].bar(x, ang_error, color="#a6683a")
+  axes[2].set_ylabel("yaw error [rad/s]")
+  axes[2].set_xticks(x, labels, rotation=70, ha="right")
+  path = plot_dir / "overview_success_tracking.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return {"overview_success_tracking": str(path)}
