diff --git a/src/mjlab/rl/connectome_policy.py b/src/mjlab/rl/connectome_policy.py
new file mode 100644
index 00000000..2d3a5494
--- /dev/null
+++ b/src/mjlab/rl/connectome_policy.py
@@ -0,0 +1,504 @@
+"""A policy whose recurrent core is a piece of a real fly's wiring diagram.
+
+Where the ordinary actor is a 45 -> 512 -> 256 -> 128 -> 12 multilayer network, this one is
+
+    observation -> small learned ENCODER -> [fly middle-leg circuit, wiring FIXED] -> small
+    learned DECODER -> 12 joint targets
+
+The core is the graph written by `analysis/connectome/extract_vnc_leg_graph.py`: the two
+middle-leg networks of the male fly's ventral nerve cord (motor neurons, their premotor
+neurons), the descending neurons that command them, and the leg sensory neurons that feed
+them - about 4,700 neurons and 150,000 connections. Who connects to whom, and whether a
+connection excites or inhibits, is taken from the connectome and never trained. What IS
+trained: a gain per connection (or per presynaptic neuron), a time constant, threshold,
+gain and bias per neuron, the encoder, and the decoder. The plan and its controls are in
+docs/151.
+
+Each neuron is a firing rate r in [0, 1], updated K times per 20 ms control step
+(Pugliese et al. 2025 rate model, normalised):
+
+    input_i = b * sum_j W_ij r_j + u_i + bias_i
+    target_i = relu(tanh(a_i * (input_i - theta_i)))
+    r_i <- (1 - alpha_i) r_i + alpha_i * target_i           alpha = dt / tau
+
+W_ij = sign(j) * synapses(j -> i) / total synapses into i * exp(g_ij). u is the encoder's
+injection: joint angles into the leg sensory neurons of the same side, the velocity command
+into the named command neurons (DNp09 forward, MDN backward, DNa02 left/right turn, DNg100
+walking drive), and - because a fly's leg circuit has nothing to receive them - the body's
+angular velocity, gravity direction and last action into ALL descending neurons through one
+dense layer, the "brain stand-in", which can be switched off to measure what it does.
+
+The decoder reads only the motor neurons. "anatomical" pools them by the muscle each one
+drives (thorax-coxa -> hip, coxa-trochanter -> knee, femur-tibia -> ankle pitch, tarsus ->
+ankle roll) with one trainable gain per joint; "linear" is a free linear read-out, kept as
+the control that tells whether the anatomy carried information.
+
+Everything is chosen through PYG_* environment variables so that a run's launch manifest
+records it, like every other switch in this project:
+
+    PYG_CONNECTOME=1                          use this actor (rl_cfg.py reads it)
+    PYG_CONNECTOME_GRAPH=<path.npz>           default analysis/connectome/graphs/malecns_v1_T2_leg_syn5.npz
+    PYG_CONNECTOME_SUBSTEPS=4                 integration substeps per control step
+    PYG_CONNECTOME_TAU_MS=20                  initial neuron time constant
+    PYG_CONNECTOME_LEAK=0                     gradient slope below threshold (0 = exact
+                                              relu(tanh); 0.05 lets silent cells learn)
+    PYG_CONNECTOME_GAINS=edge|cell|none       what the trainable synaptic gain is attached to
+    PYG_CONNECTOME_DECODER=anatomical|linear
+    PYG_CONNECTOME_BRAIN=1|0                  the dense IMU/command/action -> descending layer
+    PYG_CONNECTOME_PROPRIO_ONLY=0|1           inject joints only into proprioceptive sensory cells
+    PYG_CONNECTOME_JOINTS=<12 names>          action order; default is today's model order
+
+This class fills the rsl_rl model contract (`rsl_rl/models/rnn_model.py`): is_recurrent,
+forward(obs, masks, hidden_state), reset(dones), get_hidden_state(), detach_hidden_state().
+The hidden state is the whole rate vector, shape (1, num_envs, num_neurons), so the rollout
+storage keeps num_steps copies of it - at 16,384 environments that is 24 x 16,384 x 4,709
+floats = 7.4 GB. The first smoke test therefore runs at 1,024 environments (0.46 GB).
+"""
+
+from __future__ import annotations
+
+import copy
+import math
+import os
+import warnings
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn as nn
+from rsl_rl.models.mlp_model import MLPModel
+from rsl_rl.modules import EmpiricalNormalization, HiddenState
+from rsl_rl.utils import resolve_callable, unpad_trajectories
+from tensordict import TensorDict
+from torch.utils.checkpoint import checkpoint
+
+warnings.filterwarnings("ignore", message="Sparse CSR tensor support is in beta")
+
+REPO = Path(__file__).resolve().parents[3]
+DEFAULT_GRAPH = REPO / "analysis/connectome/graphs/malecns_v1_T2_leg_syn5.npz"
+DEFAULT_JOINTS = (
+  "R_hip_pitch_joint,R_hip_roll_joint,R_hip_yaw_joint,R_knee_joint,R_crank_A_joint,"
+  "R_crank_B_joint,L_hip_pitch_joint,L_hip_roll_joint,L_hip_yaw_joint,L_knee_joint,"
+  "L_crank_A_joint,L_crank_B_joint"
+)
+# actor observation layout of the Pygmalion velocity task (params/env.yaml, actor group):
+# base_ang_vel 3 | projected_gravity 3 | motor_pos_history 2 x 12 | actions 12 | command 3
+OBS_DIM = 45
+SL_ANG, SL_GRAV = slice(0, 3), slice(3, 6)
+SL_MPOS = (slice(6, 18), slice(18, 30))
+SL_ACT, SL_CMD = slice(30, 42), slice(42, 45)
+ROLE = {"mn": 0, "premotor": 1, "dn": 2, "sens": 3, "hop2": 4}
+CHANNELS = ("hip_pitch", "hip_roll", "hip_yaw", "knee", "ankle_pitch", "ankle_roll")
+
+
+def _env(name: str, default: str) -> str:
+  return os.environ.get(name, default)
+
+
+class ConnectomeActor(MLPModel):
+  """rsl_rl actor with a connectome-constrained recurrent core (see module docstring)."""
+
+  is_recurrent: bool = True
+
+  def __init__(
+    self,
+    obs: TensorDict,
+    obs_groups: dict[str, list[str]],
+    obs_set: str,
+    output_dim: int,
+    hidden_dims=(512, 256, 128),  # accepted for config compatibility; unused
+    activation: str = "elu",  # idem
+    obs_normalization: bool = False,
+    distribution_cfg: dict | None = None,
+    **_unused,
+  ) -> None:
+    nn.Module.__init__(self)
+    self.obs_groups, self.obs_dim = self._get_obs_dim(obs, obs_groups, obs_set)
+    if self.obs_dim != OBS_DIM or output_dim != 12:
+      raise ValueError(
+        f"ConnectomeActor expects the 45-D actor observation and 12 actions of the "
+        f"Pygmalion velocity task, got obs {self.obs_dim} / actions {output_dim}"
+      )
+    # Kept so the ONNX view can build a fresh twin and load weights into it: deepcopy
+    # of a live actor fails on the non-leaf tensors PPO leaves behind (hidden state,
+    # the distribution's last parameters).
+    self._ctor = dict(
+      obs_groups=obs_groups,
+      obs_set=obs_set,
+      output_dim=output_dim,
+      obs_normalization=obs_normalization,
+      distribution_cfg=copy.deepcopy(distribution_cfg),
+    )
+    self._obs_template = TensorDict(
+      {k: torch.zeros(1, obs[k].shape[-1]) for k in obs_groups[obs_set]}, batch_size=[1]
+    )
+    self.obs_normalization = obs_normalization
+    self.obs_normalizer = (
+      EmpiricalNormalization(self.obs_dim) if obs_normalization else nn.Identity()
+    )
+    if distribution_cfg is not None:
+      cfg = dict(distribution_cfg)
+      dist_class = resolve_callable(cfg.pop("class_name"))
+      self.distribution = dist_class(output_dim, **cfg)
+    else:
+      self.distribution = None
+
+    # ---- switches ------------------------------------------------------------------
+    self.graph_path = Path(_env("PYG_CONNECTOME_GRAPH", str(DEFAULT_GRAPH)))
+    self.substeps = int(_env("PYG_CONNECTOME_SUBSTEPS", "4"))
+    tau_ms = float(_env("PYG_CONNECTOME_TAU_MS", "20"))
+    # relu(tanh(x)) has zero slope for x <= 0, so a cell pushed below threshold can never
+    # be pulled back by the policy gradient. The 300-iteration smoke (2026-09-18) ended
+    # with half the motor neurons silent at every step and the robot unable to walk. With
+    # a leak the forward pass is unchanged (rates stay in [0, 1]); only the gradient sees
+    # a small slope below threshold, as in a leaky ReLU.
+    self.leak = float(_env("PYG_CONNECTOME_LEAK", "0"))
+    self.gain_mode = _env("PYG_CONNECTOME_GAINS", "edge")
+    self.decoder_mode = _env("PYG_CONNECTOME_DECODER", "anatomical")
+    self.use_brain = _env("PYG_CONNECTOME_BRAIN", "1") == "1"
+    self.proprio_only = _env("PYG_CONNECTOME_PROPRIO_ONLY", "0") == "1"
+    # Memory of one training batch, CPU-measured 2026-09-18 at 256 trajectories x 24
+    # steps x 4 substeps: 2.5 GB held by autograd (about six N-vectors per substep). It
+    # scales linearly with trajectories per minibatch - 4,096 would need ~40 GB - so at
+    # full scale the minibatch count goes up (num_mini_batches 16 -> 1,024 trajectories,
+    # ~10 GB) or the substep is rewritten as a custom autograd function that saves one
+    # vector. torch.utils.checkpoint was tried first and made it WORSE with sparse ops
+    # (4.8 GB held, 4.5x slower), so it stays off unless asked for.
+    self.use_ckpt = _env("PYG_CONNECTOME_CKPT", "0") == "1"
+    joints = _env("PYG_CONNECTOME_JOINTS", DEFAULT_JOINTS).split(",")
+    if len(joints) != 12:
+      raise ValueError("PYG_CONNECTOME_JOINTS must name 12 joints")
+    self.joint_names = joints
+
+    # ---- the graph -----------------------------------------------------------------
+    g = np.load(self.graph_path, allow_pickle=False)
+    n = int(len(g["body_id"]))
+    self.n = n
+    role = g["role"].astype(np.int64)
+    side = g["side"].astype(np.int64)  # 0 L, 1 R, 2 midline, 3 unknown
+    sign = g["sign"].astype(np.float32)
+    indptr = g["indptr"].astype(np.int64)
+    pre = g["indices"].astype(np.int64)
+    syn = g["syn"].astype(np.float32)
+    post = np.repeat(np.arange(n), np.diff(indptr))
+    key = post.astype(np.int64) * n + pre
+    if len(np.unique(key)) != len(key):
+      raise ValueError(
+        f"{self.graph_path.name}: duplicate (post, pre) entries - the sparse backward "
+        "needs unique pairs; rebuild the graph with extract_vnc_leg_graph.py"
+      )
+    total_in = np.zeros(n, dtype=np.float32)
+    np.add.at(total_in, post, syn)
+    w_base = sign[pre] * syn / np.maximum(total_in[post], 1.0)
+    self.register_buffer("crow", torch.tensor(indptr, dtype=torch.int64))
+    self.register_buffer("col", torch.tensor(pre, dtype=torch.int64))
+    self.register_buffer("pre_of_edge", torch.tensor(pre, dtype=torch.int64))
+    self.register_buffer("w_base", torch.tensor(w_base))
+    self.register_buffer("w_dense_cache", torch.zeros(0))  # filled only for ONNX export
+    types = [str(t) for t in g["type"]]
+    cls = [str(c) for c in g["cls"]]
+    joint = [str(j) for j in g["joint"]]
+    joint_sign = g["joint_sign"].astype(np.float32)
+
+    # ---- trainable neuron and synapse parameters -------------------------------------
+    if self.gain_mode == "edge":
+      self.gain = nn.Parameter(torch.zeros(len(syn)))
+    elif self.gain_mode == "cell":
+      self.gain = nn.Parameter(torch.zeros(n))
+    elif self.gain_mode == "none":
+      self.gain = None
+    else:
+      raise ValueError(f"PYG_CONNECTOME_GAINS={self.gain_mode!r}")
+    dt_ms = 20.0 / self.substeps
+    alpha0 = min(dt_ms / tau_ms, 0.95)
+    self.alpha_logit = nn.Parameter(torch.full((n,), math.log(alpha0 / (1 - alpha0))))
+    self.a = nn.Parameter(torch.ones(n))
+    # Threshold at zero and a small positive resting drive: relu(tanh(x)) has zero slope
+    # at and below x = 0, so a silent neuron can never learn to fire. With bias 0.02
+    # every cell sits just above threshold at rest and gradients reach the whole graph
+    # (the transparency test found the motor pool dead with theta = 0.1, bias = 0).
+    self.theta = nn.Parameter(torch.zeros(n))
+    self.bias = nn.Parameter(torch.full((n,), 0.02))
+    self.log_b = nn.Parameter(torch.tensor(math.log(2.0)))
+
+    # ---- encoder: which neurons receive what ---------------------------------------
+    jside = torch.tensor([0 if j.startswith("L_") else 1 for j in joints])
+    self.register_buffer("joint_side", jside)
+    self._joint_side_py = [int(v) for v in jside]
+    self.register_buffer("joints_L", torch.where(jside == 0)[0])
+    self.register_buffer("joints_R", torch.where(jside == 1)[0])
+    sens = role == ROLE["sens"]
+    if self.proprio_only:
+      sens &= np.array([c == "mechanosensory_proprioceptive" for c in cls])
+    self.register_buffer("sens_L", torch.tensor(np.where(sens & (side == 0))[0]))
+    self.register_buffer("sens_R", torch.tensor(np.where(sens & (side == 1))[0]))
+    self.register_buffer("sens_X", torch.tensor(np.where(sens & (side >= 2))[0]))
+    self.enc_L = nn.Linear(12, len(self.sens_L))
+    self.enc_R = nn.Linear(12, len(self.sens_R))
+    self.enc_X = nn.Linear(24, max(len(self.sens_X), 1))
+    dn = np.where(role == ROLE["dn"])[0]
+    self.register_buffer("dn_idx", torch.tensor(dn))
+    self.brain = nn.Linear(21, len(dn), bias=False) if self.use_brain else None
+    if self.brain is not None:
+      nn.init.normal_(self.brain.weight, std=0.1)
+
+    def named(t: str, s: int | None = None) -> torch.Tensor:
+      ix = [i for i in range(n) if types[i] == t and (s is None or side[i] == s)]
+      return torch.tensor(ix, dtype=torch.int64)
+
+    self.register_buffer("dn_fwd", named("DNp09"))
+    self.register_buffer("dn_back", named("MDN"))
+    self.register_buffer("dn_turn_L", named("DNa02", 0))
+    self.register_buffer("dn_turn_R", named("DNa02", 1))
+    self.register_buffer("dn_walk", named("DNg100"))
+    self.cmd_gain = nn.Parameter(torch.ones(4))  # forward, backward, turn, walk
+
+    # ---- decoder: motor neurons -> joints -------------------------------------------
+    mn = np.where(role == ROLE["mn"])[0]
+    self.register_buffer("mn_idx", torch.tensor(mn))
+    if self.decoder_mode == "linear":
+      self.dec_linear = nn.Linear(len(mn), 12)
+    elif self.decoder_mode == "anatomical":
+      pool = torch.zeros(2, len(CHANNELS), len(mn))  # side, channel, mn
+      un = [[], []]
+      for k, i in enumerate(mn):
+        s = int(side[i])
+        if s > 1:
+          continue
+        if joint[i] in CHANNELS:
+          pool[s, CHANNELS.index(joint[i]), k] = float(joint_sign[i])
+        else:
+          un[s].append(k)
+      self.register_buffer("pool", pool)
+      self.register_buffer("un_L", torch.tensor(un[0], dtype=torch.int64))
+      self.register_buffer("un_R", torch.tensor(un[1], dtype=torch.int64))
+      self.dec_un_L = nn.Linear(max(len(un[0]), 1), 6)
+      self.dec_un_R = nn.Linear(max(len(un[1]), 1), 6)
+      for lin in (self.dec_un_L, self.dec_un_R):
+        nn.init.zeros_(lin.weight)
+        nn.init.zeros_(lin.bias)
+      self._has_un = (len(un[0]) > 0, len(un[1]) > 0)
+      self.dec_gain = nn.Parameter(
+        torch.ones(2, 4)
+      )  # side x (hip_pitch, hip_roll, hip_yaw, knee)
+      self.dec_mix = nn.Parameter(
+        torch.tensor([[[1.0, 1.0], [1.0, -1.0]]] * 2)
+      )  # side x crank(A,B) x (pitch, roll)
+      self.dec_bias = nn.Parameter(torch.zeros(12))
+    else:
+      raise ValueError(f"PYG_CONNECTOME_DECODER={self.decoder_mode!r}")
+
+    self.hidden_state: torch.Tensor | None = None
+    n_train = sum(p.numel() for p in self.parameters() if p.requires_grad)
+    print(
+      f"[connectome] {self.graph_path.name}: {n} neurons, {len(syn)} edges | motor {len(mn)} "
+      f"descending {len(dn)} sensory L/R/other {len(self.sens_L)}/{len(self.sens_R)}/{len(self.sens_X)} | "
+      f"command cells fwd {len(self.dn_fwd)} back {len(self.dn_back)} turn {len(self.dn_turn_L)}+{len(self.dn_turn_R)} "
+      f"walk {len(self.dn_walk)} | substeps {self.substeps} tau {tau_ms} ms gains={self.gain_mode} "
+      f"decoder={self.decoder_mode} brain={'on' if self.use_brain else 'off'} | trainable {n_train:,}",
+      flush=True,
+    )
+
+  # ------------------------------------------------------------------ core pieces --
+  def _edge_values(self) -> torch.Tensor:
+    if self.gain is None:
+      return self.w_base
+    if self.gain_mode == "edge":
+      return self.w_base * torch.exp(self.gain)
+    return self.w_base * torch.exp(self.gain)[self.pre_of_edge]
+
+  def _sparse_matmul(self, h: torch.Tensor) -> torch.Tensor:
+    """(B, N) -> (B, N): sum over presynaptic rates, through the fixed wiring."""
+    W = torch.sparse_csr_tensor(
+      self.crow, self.col, self._edge_values(), (self.n, self.n)
+    )
+    return torch.sparse.mm(W, h.transpose(0, 1)).transpose(0, 1)
+
+  def _dense_matmul(self, h: torch.Tensor) -> torch.Tensor:
+    return h @ self.w_dense_cache.transpose(0, 1)
+
+  def _injection(self, x: torch.Tensor, raw: torch.Tensor) -> torch.Tensor:
+    """Encoder: build the input current u (B, N) from normalised obs x and raw obs."""
+    B = x.shape[0]
+    u = x.new_zeros(B, self.n)
+    m1, m2 = x[:, SL_MPOS[0]], x[:, SL_MPOS[1]]
+    fL = torch.cat([m1[:, self.joints_L], m2[:, self.joints_L]], dim=1)
+    fR = torch.cat([m1[:, self.joints_R], m2[:, self.joints_R]], dim=1)
+    u = u.index_add(1, self.sens_L, self.enc_L(fL))
+    u = u.index_add(1, self.sens_R, self.enc_R(fR))
+    if len(self.sens_X):
+      u = u.index_add(1, self.sens_X, self.enc_X(torch.cat([m1, m2], dim=1)))
+    if self.brain is not None:
+      u = u.index_add(
+        1,
+        self.dn_idx,
+        self.brain(
+          torch.cat([x[:, SL_ANG], x[:, SL_GRAV], x[:, SL_CMD], x[:, SL_ACT]], 1)
+        ),
+      )
+    cmd = raw[:, SL_CMD]  # vx, vy, wz in physical units, sign intact
+    vx, wz = cmd[:, 0:1], cmd[:, 2:3]
+    g = self.cmd_gain
+    drive = cmd.abs().sum(dim=1, keepdim=True)
+    for idx, val in (
+      (self.dn_fwd, g[0] * torch.relu(vx)),
+      (self.dn_back, g[1] * torch.relu(-vx)),
+      (self.dn_turn_L, g[2] * torch.relu(wz)),
+      (self.dn_turn_R, g[2] * torch.relu(-wz)),
+      (self.dn_walk, g[3] * drive),
+    ):
+      if len(idx):
+        u = u.index_add(1, idx, val.expand(B, len(idx)))
+    return u
+
+  def _core(self, h: torch.Tensor, u: torch.Tensor, matmul) -> torch.Tensor:
+    alpha = torch.sigmoid(self.alpha_logit)
+    b = torch.exp(self.log_b)
+    for _ in range(self.substeps):
+      inp = b * matmul(h) + u + self.bias
+      t = torch.tanh(self.a * (inp - self.theta))
+      target = torch.relu(t)
+      if self.leak > 0:
+        soft = torch.where(t > 0, t, self.leak * t)
+        target = soft - (soft - target).detach()  # value relu(t), gradient leaky
+      h = (1 - alpha) * h + alpha * target
+    return h
+
+  def _decode(self, h: torch.Tensor) -> torch.Tensor:
+    r = h[:, self.mn_idx]
+    if self.decoder_mode == "linear":
+      return self.dec_linear(r)
+    out = []
+    pooled = torch.einsum("scm,bm->bsc", self.pool, r)  # (B, side, channel)
+    un = (
+      self.dec_un_L(r[:, self.un_L]) if self._has_un[0] else 0.0,
+      self.dec_un_R(r[:, self.un_R]) if self._has_un[1] else 0.0,
+    )
+    for j, name in enumerate(self.joint_names):
+      s = self._joint_side_py[j]
+      p = pooled[:, s] + un[s]
+      if "crank_A" in name:
+        v = p[:, 4] * self.dec_mix[s, 0, 0] + p[:, 5] * self.dec_mix[s, 0, 1]
+      elif "crank_B" in name:
+        v = p[:, 4] * self.dec_mix[s, 1, 0] + p[:, 5] * self.dec_mix[s, 1, 1]
+      else:
+        c = CHANNELS.index(name[2:-6])  # strip "L_"/"R_" and "_joint"
+        v = p[:, c] * self.dec_gain[s, c]
+      out.append(v + self.dec_bias[j])
+    return torch.stack(out, dim=1)
+
+  def _step(
+    self, obs_flat: torch.Tensor, h: torch.Tensor, matmul=None
+  ) -> tuple[torch.Tensor, torch.Tensor]:
+    x = self.obs_normalizer(obs_flat)
+    u = self._injection(x, obs_flat)
+    h = self._core(h, u, matmul or self._sparse_matmul)
+    return self._decode(h), h
+
+  # --------------------------------------------------------------- rsl_rl contract --
+  def forward(
+    self,
+    obs: TensorDict,
+    masks: torch.Tensor | None = None,
+    hidden_state: HiddenState = None,
+    stochastic_output: bool = False,
+  ) -> torch.Tensor:
+    flat = torch.cat([obs[k] for k in self.obs_groups], dim=-1)
+    if (
+      masks is not None
+    ):  # batch mode: padded trajectories (T, Btraj, obs), initial hidden (1, Btraj, N)
+      if hidden_state is None:
+        raise ValueError("hidden state must be passed in batch mode")
+      h = hidden_state[0]
+      outs = []
+      for t in range(flat.shape[0]):
+        if self.use_ckpt and torch.is_grad_enabled():
+          o, h = checkpoint(self._step, flat[t], h, use_reentrant=False)
+        else:
+          o, h = self._step(flat[t], h)
+        outs.append(o)
+      out = unpad_trajectories(torch.stack(outs, dim=0), masks)
+    else:  # rollout mode: one step for every environment
+      if self.hidden_state is None:
+        self.hidden_state = flat.new_zeros(1, flat.shape[0], self.n)
+      out, h = self._step(flat, self.hidden_state[0])
+      self.hidden_state = h.unsqueeze(0)
+    if self.distribution is not None:
+      if stochastic_output:
+        self.distribution.update(out)
+        return self.distribution.sample()
+      return self.distribution.deterministic_output(out)
+    return out
+
+  def reset(
+    self, dones: torch.Tensor | None = None, hidden_state: HiddenState = None
+  ) -> None:
+    if dones is None:
+      self.hidden_state = None if hidden_state is None else hidden_state
+    elif self.hidden_state is not None:
+      if hidden_state is not None:
+        raise NotImplementedError("custom hidden state on partial reset")
+      self.hidden_state[..., dones == 1, :] = 0.0
+
+  def get_hidden_state(self) -> HiddenState:
+    return self.hidden_state
+
+  def detach_hidden_state(self, dones: torch.Tensor | None = None) -> None:
+    if self.hidden_state is None:
+      return
+    if dones is None:
+      self.hidden_state = self.hidden_state.detach()
+    else:
+      self.hidden_state[..., dones == 1, :] = self.hidden_state[
+        ..., dones == 1, :
+      ].detach()
+
+  def as_jit(self) -> nn.Module:
+    raise NotImplementedError("ConnectomeActor: use ONNX export")
+
+  def as_onnx(self, verbose: bool = False) -> nn.Module:
+    return _OnnxConnectomeActor(self, verbose)
+
+
+class _OnnxConnectomeActor(nn.Module):
+  """ONNX view: the sparse core densified (N x N, ~90 MB at 4.7k neurons), hidden state as
+  an explicit input/output so the robot-side runtime carries it between control steps."""
+
+  is_recurrent: bool = True
+
+  def __init__(self, model: ConnectomeActor, verbose: bool) -> None:
+    super().__init__()
+    self.verbose = verbose
+    m = ConnectomeActor(model._obs_template, **model._ctor)
+    m.load_state_dict(model.state_dict())
+    m = m.cpu().eval()
+    with torch.no_grad():
+      W = torch.sparse_csr_tensor(
+        m.crow, m.col, m._edge_values(), (m.n, m.n)
+      ).to_dense()
+      m.w_dense_cache = W.contiguous()
+    self.m = m
+    self.n = m.n
+    self.input_size = m.obs_dim
+    self.deterministic_output = (
+      m.distribution.as_deterministic_output_module()
+      if m.distribution is not None
+      else nn.Identity()
+    )
+
+  def forward(
+    self, obs: torch.Tensor, h_in: torch.Tensor
+  ) -> tuple[torch.Tensor, torch.Tensor]:
+    out, h = self.m._step(obs, h_in, matmul=self.m._dense_matmul)
+    return self.deterministic_output(out), h
+
+  def get_dummy_inputs(self) -> tuple[torch.Tensor, torch.Tensor]:
+    return (torch.zeros(1, self.input_size), torch.zeros(1, self.n))
+
+  @property
+  def input_names(self) -> list[str]:
+    return ["obs", "h_in"]
+
+  @property
+  def output_names(self) -> list[str]:
+    return ["actions", "h_out"]
