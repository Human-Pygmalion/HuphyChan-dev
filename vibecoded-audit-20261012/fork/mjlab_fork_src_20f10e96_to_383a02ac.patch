@@ -0,0 +1,439 @@
+"""**정책이 관측 잡음을 행동으로 증폭하지 않게** 하는 정규화 (CAPS).
+
+2026-09-17 · 우리 측정에서 나온 문제: 외력 강건화 학습(v7b)이 같은 센서 잡음에
+이전 정책보다 **19 배** 크게 반응합니다. 잡음을 끄면 **완벽히 멈추므로**(0.00 rad/s)
+스스로 진동하는 것이 아니라 **입력의 흔들림을 출력으로 키우는** 것입니다
+(docs/reward_research/2026-09-17_standing_tremble.md).
+
+## 무엇을 더하나 — 논문 그대로
+
+**Regularizing Action Policies for Smooth Control with Reinforcement Learning**
+(arXiv 2012.06644, CAPS). 매끄러움을 두 종류로 나눕니다.
+
+* **공간 평활** `L_S = E_{s, s̄~N(s,σ)} [ ‖ π(s) − π(s̄) ‖₂ ]`
+  — "비슷한 상태면 비슷한 명령". **우리 문제에 정확히 겨눈 항**입니다.
+* **시간 평활** `L_T = E_{s_t, s_{t+1}} [ ‖ π(s_t) − π(s_{t+1}) ‖₂ ]`
+  — "연속한 명령이 비슷해야". 우리 `action_rate_l2` 보상과 같은 뜻이라 기본은 끕니다.
+
+`J_CAPS = J − λ_T·L_T − λ_S·L_S`
+
+논문의 실물 결과: 쿼드로터에서 **소비전력 약 80% 감소**, 게다가 학습이 **8 배 빠르고
+표본이 90% 덜** 들었습니다 — 매끄러움을 넣어 성능이 *올라간* 사례입니다.
+
+### 왜 시간 평활이 아니라 공간 평활인가
+
+시간 평활만 누르면 "천천히 움직여라" 가 되어 **반응이 굼떠집니다.** 립시츠 논문이 그 대가를
+숫자로 보여 줍니다 — 계수를 0.002 에서 0.01 로 올리자 과제 점수 **26.03 → 16.11 (−38%)**.
+우리에게 그 "과제 점수" 는 방금 얻은 외력 강건성입니다. 공간 평활 항은 **반응 속도를 전혀
+건드리지 않고** 잡음 증폭만 줄입니다.
+
+## σ 를 어디에 주나 — **정규화된 공간**
+
+관측은 단위가 제각각입니다 (라디안, 라디안/초, 무차원 중력방향). 절대 σ 하나를 쓰면
+어떤 항목은 거의 안 흔들리고 어떤 항목은 부서집니다. 그래서 **관측 정규화를 통과한 뒤**
+흔듭니다. 거기서는 모든 항목이 대략 표준편차 1 이므로, `σ = 0.1` 은 **"어느 항목이든
+그 항목의 표준편차의 10%" ** 라는 한 가지 뜻을 갖습니다.
+
+정규화는 **한 번만** 통과시키고 그 결과를 둘로 나눠 씁니다. 두 번 통과시키면 정규화의
+누적 통계가 두 번 갱신되어 학습이 미묘하게 달라집니다.
+
+## 부모 코드를 옮겨 온 이유와 안전장치
+
+CAPS 항은 **PPO 손실 안**에 들어가야 합니다 (논문 그대로). rsl_rl 의 `PPO.update` 에는
+손실에 끼어들 수 있는 자리가 없어서, **그 함수를 그대로 옮기고 한 군데만** 더했습니다.
+
+옮긴 코드는 시간이 지나면 원본과 어긋납니다. 그래서 **원본의 해시를 검사**합니다 —
+라이브러리가 바뀌면 조용히 낡은 논리로 도는 대신 **바로 멈춥니다.**
+
+## 끄면 예전 그대로
+
+`lambda_s`, `lambda_t` 가 둘 다 0 이면 손실에 아무것도 안 더합니다.
+`PYG_CAPS_S` / `PYG_CAPS_T` / `PYG_CAPS_SIGMA` 로 켭니다.
+
+## LCP — 같은 목표를 기울기로
+
+**Learning Smooth Humanoid Locomotion through Lipschitz-Constrained Policies**
+(arXiv 2410.11825). CAPS 공간 평활과 **뜻이 같습니다** — "관측이 조금 바뀌었다고 행동이
+확 바뀌지 마라" — 그런데 표본 두 개를 비교하는 대신 **기울기를 직접** 벌합니다.
+
+`J_LCP = J − λ_gp · E[ ‖ ∇_s log π(a|s) ‖² ]`,  논문 값 λ_gp = **0.002**
+
+대가는 **메모리**입니다 (2 차 미분이 필요해 그래프를 남겨야 함). 스펙트럼 정규화
+논문이 LCP 를 두고 *"significant GPU memory overhead"* 라고 지적하는 이유입니다.
+다만 우리 학습은 16384 환경에서도 그래픽카드 메모리를 7 GB 밖에 안 써서(24 GB 중)
+**그 대가가 우리에겐 문제가 아닙니다** (2026-09-18 사용자 판단).
+
+기울기도 **정규화된 관측 공간**에서 잽니다 — CAPS 의 σ 와 같은 이유입니다. 원 논문은
+날 것의 상태에 대해 재지만, 단위가 섞인 관측에서는 정규화 공간이 항목 간 저울을 맞춰
+줍니다. 바꾼 점이므로 여기 적어 둡니다.
+
+`PYG_LCP` 로 켭니다. CAPS 와 **동시에 켜지 않습니다** — 같은 것을 두 번 누르면 어느
+쪽이 효과인지 못 가립니다.
+
+## 스펙트럼 정규화 — 벌점이 아니라 **구조로** 묶는다
+
+**Spectral Normalization for Lipschitz-Constrained Policies on Learning Humanoid
+Locomotion** (arXiv 2504.08246).
+
+앞의 둘은 "민감하면 벌점" 이라 **벌점과 과제 점수가 줄다리기**를 합니다. 이쪽은 아예
+**민감해질 수 없게** 만듭니다. 각 층의 가중치 행렬을 가장 큰 특이값으로 나눠
+(`W ← λ · W / σ(W)`) 그 층이 입력을 늘릴 수 있는 배율의 **상한을 λ 로 못박습니다.**
+층을 지날 때마다 곱해지므로 신경망 전체의 립시츠 상수가 구조적으로 묶입니다.
+
+논문이 재 준 것 (TOCABI 휴머노이드, 키 1.8 m · 100 kg · **하체 12 관절** — 우리와 비슷):
+
+| 토크 차이 (작을수록 매끄러움) | 값 | 그래픽카드 메모리 (4096 환경, RTX 4090) |
+|---|---:|---|
+| 아무것도 안 함 | 27.36 ± 36.66 | (기준) |
+| 정규화 보상 | 18.29 ± 19.89 | |
+| 기울기 벌점(LCP) | 9.80 ± 12.58 | **74% ≈ 18.98 GB** |
+| **스펙트럼 정규화 (λ=0.2)** | **9.25 ± 8.48** | **47% ≈ 12.08 GB** |
+
+LCP 와 같거나 조금 나은 결과를 **메모리 2/3** 로 냅니다.
+
+### 주의: 저장본 모양이 달라진다
+
+정규화를 걸면 가중치가 `parametrizations.weight.original` 로 바뀌어 저장됩니다. 그래서
+**스펙트럼 정규화로 학습한 저장본은 안 건 환경에 그대로 못 싣습니다.** 내보내기(ONNX)는
+한 번 통과시킨 결과를 쓰므로 배포에는 영향이 없습니다.
+
+### ★ λ 는 **신경망 전체**의 상한이다 — 층마다가 아니다
+
+2026-09-20 에 이걸 틀렸습니다. 층마다 `W ← λ·W/σ(W)` 를 걸면 층을 지날 때마다 곱해져서
+신경망 전체의 상한이 **λ^(층 수)** 가 됩니다. 우리 정책은 선형 층이 4 개라 λ=0.2 면
+전체 상한이 **0.2⁴ = 0.0016** 이었습니다. 입력이 아무리 바뀌어도 출력이 그만큼밖에 못
+움직이니 정책이 쓸 만한 명령을 낼 수가 없고, **보상이 107 에서 4 로 무너졌습니다.**
+
+그래서 지금은 `PYG_SN` 을 **전체 상한**으로 읽고, 층마다 거는 값은
+`λ_layer = λ^(1/층 수)` 로 나눠 겁니다. λ=1.0 이면 층마다도 1.0 이라 "각 층이 입력을
+키우지 않는다" 는 뜻이 되고, 이것이 논문이 말하는 립시츠 상수 1 입니다.
+
+`PYG_SN` 으로 켭니다. 다른 둘과 **동시에 켜지 않습니다.**
+"""
+
+from __future__ import annotations
+
+import hashlib
+import inspect
+import os
+
+import torch
+import torch.nn as nn  # noqa: F401  (옮겨 온 부모 코드가 쓴다)
+import torch.nn.utils.parametrize as P
+from itertools import chain
+from rsl_rl.algorithms.ppo import PPO
+
+
+class _Scale(nn.Module):
+  """스펙트럼 정규화 뒤에 배율 하나를 더 건다.
+
+  파이토치의 `spectral_norm` 은 가장 큰 특이값을 **1 로** 맞춥니다. 논문이 쓰는 λ 는
+  그보다 크거나 작게 두고 싶다는 뜻이라, 정규화 **뒤에** 배율을 하나 더 겁니다.
+  파이토치의 매개화(parametrization)는 등록한 순서대로 이어 붙으므로, 이 모듈은
+  정규화가 낸 가중치를 받아 λ 를 곱합니다.
+  """
+
+  def __init__(self, coeff: float):
+    super().__init__()
+    self.coeff = float(coeff)
+
+  def forward(self, w: torch.Tensor) -> torch.Tensor:
+    return self.coeff * w
+
+# 2026-09-17 기준 rsl_rl 의 PPO.update 소스 해시. 여기가 바뀌면 아래 옮겨 온 사본이
+# 낡은 것이므로, 조용히 도는 대신 멈춘다.
+PARENT_UPDATE_SHA = "4ed015b3985bf551"
+
+
+def _parent_sha() -> str:
+  return hashlib.sha256(inspect.getsource(PPO.update).encode()).hexdigest()[:16]
+
+
+class SmoothPPO(PPO):
+  """PPO + CAPS 정규화. 계수가 0 이면 PPO 와 완전히 같다."""
+
+  def __init__(self, *args, **kwargs):
+    super().__init__(*args, **kwargs)
+    self.caps_lambda_s = float(os.environ.get("PYG_CAPS_S", 0.0) or 0.0)
+    self.caps_lambda_t = float(os.environ.get("PYG_CAPS_T", 0.0) or 0.0)
+    self.caps_sigma = float(os.environ.get("PYG_CAPS_SIGMA", 0.1) or 0.1)
+    self.lcp_lambda = float(os.environ.get("PYG_LCP", 0.0) or 0.0)
+    self.sn_coeff = float(os.environ.get("PYG_SN", 0.0) or 0.0)
+    _on = [n for n, v in (("PYG_CAPS_S", self.caps_lambda_s), ("PYG_LCP", self.lcp_lambda),
+                          ("PYG_SN", self.sn_coeff)) if v > 0.0]
+    if len(_on) > 1:
+      raise ValueError(
+        f"{' 와 '.join(_on)} 를 같이 켰습니다. 셋은 같은 것(관측 민감도)을 누르는 서로 "
+        "다른 방법이라, 같이 켜면 어느 쪽이 효과인지 못 가립니다. 하나만 켜십시오."
+      )
+    if self.sn_coeff > 0.0:
+      n_layers = self._apply_spectral_norm(self.actor, self.sn_coeff)
+      self.sn_per_layer = self._sn_per_layer
+      # 매개화를 걸면 `weight` 가 `parametrizations.weight.original` 로 바뀝니다.
+      # 최적화기는 **예전 이름표를 들고 있어서** 다시 만들지 않으면 그 층들이 영영
+      # 안 배웁니다 — 오류 없이, 조용히.
+      self.optimizer = type(self.optimizer)(
+        chain(self.actor.parameters(), self.critic.parameters()), lr=self.learning_rate)
+      print(f"[SMOOTH] 스펙트럼 정규화 전체 λ={self.sn_coeff} · 층 {n_layers} 개 · "
+            f"층마다 {self._sn_per_layer:.4f} (= λ^(1/{n_layers})) · 최적화기 다시 만듦",
+            flush=True)
+    if self.lcp_lambda > 0.0 and self.caps_lambda_s > 0.0:
+      raise ValueError(
+        "PYG_LCP 와 PYG_CAPS_S 를 같이 켰습니다. 둘은 같은 것을 누르는 서로 다른 "
+        "방법이라, 같이 켜면 어느 쪽이 효과인지 못 가립니다. 하나만 켜십시오."
+      )
+    if self.caps_lambda_s > 0.0 or self.caps_lambda_t > 0.0 or self.lcp_lambda > 0.0:
+      got = _parent_sha()
+      if got != PARENT_UPDATE_SHA:
+        raise RuntimeError(
+          "rsl_rl 의 PPO.update 가 바뀌었습니다 "
+          f"(기대 {PARENT_UPDATE_SHA}, 지금 {got}). smooth_ppo.py 의 옮겨 온 사본이 "
+          "낡았을 수 있으니 대조한 뒤 PARENT_UPDATE_SHA 를 올리십시오."
+        )
+      print(f"[SMOOTH] CAPS 공간 평활 {self.caps_lambda_s} · 시간 평활 {self.caps_lambda_t} · "
+            f"sigma {self.caps_sigma} | LCP {self.lcp_lambda} (전부 정규화 공간)",
+            flush=True)
+
+  def _apply_spectral_norm(self, actor, coeff: float) -> int:
+    """정책 신경망의 선형 층을 묶어 **신경망 전체**의 립시츠 상한을 `coeff` 로 만든다.
+
+    층마다 거는 값은 `coeff^(1/층 수)` 입니다. 층을 지날 때마다 곱해지기 때문입니다 —
+    4 개 층에 0.2 씩 걸면 전체가 0.0016 이 되고 정책이 죽습니다(2026-09-20 에 실제로
+    보상이 107 에서 4 로 무너졌습니다). 건 층 수를 돌려줍니다.
+
+    **정책에만** 겁니다. 비평가(critic)는 행동을 내지 않으므로 매끄러울 이유가 없고,
+    묶으면 값 추정만 나빠집니다.
+    """
+    layers = [m for m in actor.modules()
+              if isinstance(m, nn.Linear) and not P.is_parametrized(m, "weight")]
+    if not layers:
+      self._sn_per_layer = 1.0
+      return 0
+    per = float(coeff) ** (1.0 / len(layers))
+    self._sn_per_layer = per
+    for mod in layers:
+      nn.utils.parametrizations.spectral_norm(mod, name="weight")
+      P.register_parametrization(mod, "weight", _Scale(per))
+    return len(layers)
+
+  # ------------------------------------------------------------------ CAPS
+  def _caps_loss(self, batch, n: int) -> torch.Tensor:
+    """`λ_S·L_S + λ_T·L_T`. 관측 정규화를 **한 번만** 통과시킨다."""
+    actor = self.actor
+    obs = batch.observations
+    latent = actor.get_latent(obs)                      # 정규화 통과 (1회)
+    if latent.shape[0] > n:
+      latent = latent[:n]                               # 대칭 증강분은 뺀다
+
+    def head(z):
+      out = actor.mlp(z)
+      dist = getattr(actor, "distribution", None)
+      return dist.deterministic_output(out) if dist is not None else out
+
+    a = head(latent)
+    total = latent.new_zeros(())
+    if self.caps_lambda_s > 0.0:
+      noisy = latent + self.caps_sigma * torch.randn_like(latent)
+      total = total + self.caps_lambda_s * (a - head(noisy)).norm(dim=-1).mean()
+    if self.caps_lambda_t > 0.0:
+      # 같은 미니배치 안의 **이웃 표본**을 다음 시점으로 본다. 저장소가 시간 순서로
+      # 채워지므로 한 칸 민 것이 대체로 다음 스텝이다 — 정확한 쌍이 아니라 근사다.
+      total = total + self.caps_lambda_t * (a[1:] - a[:-1]).norm(dim=-1).mean()
+    if self.lcp_lambda > 0.0:
+      total = total + self._lcp(batch, latent, n)
+    return total
+
+  def _lcp(self, batch, latent: torch.Tensor, n: int) -> torch.Tensor:
+    """`λ_gp · E[ ‖∇_z log π(a|z)‖² ]`. z 는 정규화된 관측.
+
+    `latent` 을 떼어 내(`detach`) 잎으로 만든 뒤 그것에 대한 기울기를 구합니다. 정규화는
+    배울 것이 없으므로 떼어도 잃는 것이 없고, 신경망 가중치로 가는 길은
+    `create_graph=True` 로 살아 있습니다.
+
+    분포를 `update` 하므로 이 함수가 끝나면 `actor.distribution` 은 **제 값**으로
+    바뀝니다. 부모 코드가 손실 줄 이후로 분포를 다시 읽지 않는 것을 확인했습니다
+    (읽는 것은 `parameters()` 뿐).
+    """
+    actor = self.actor
+    dist = getattr(actor, "distribution", None)
+    if dist is None:
+      return latent.new_zeros(())
+    z = latent.detach().requires_grad_(True)
+    dist.update(actor.mlp(z))
+    logp = dist.log_prob(batch.actions[:n])
+    if logp.dim() > 1:
+      logp = logp.sum(dim=-1)
+    g = torch.autograd.grad(logp.sum(), z, create_graph=True)[0]
+    return self.lcp_lambda * (g ** 2).sum(dim=-1).mean()
+
+  # --------------------------------------------------------------------------
+  # 아래는 rsl_rl 의 PPO.update 를 **그대로 옮긴 것**입니다 (해시 검사로 지킵니다).
+  # 우리가 더한 곳은 `CAPS 공간 평활 항` 주석이 붙은 세 줄과 `mean_caps_loss` 뿐입니다.
+  # 들여쓰기만 우리 규약(2칸)에 맞췄습니다 — 4칸 그대로 두면 클래스가 아니라
+  # 바로 위 메서드 안의 중첩 함수가 되어, 문법은 통과하고 조용히 부모 것이 돕니다
+  # (2026-09-17 에 실제로 그렇게 났고, 손실 로그에 caps 가 안 나와서 잡았습니다).
+  # --------------------------------------------------------------------------
+  def update(self) -> dict[str, float]:
+      """부모 PPO.update 를 그대로 옮기고 CAPS 항 한 줄만 더한다."""
+      mean_caps_loss = 0.0
+      mean_value_loss = 0
+      mean_surrogate_loss = 0
+      mean_entropy = 0
+      # RND loss
+      mean_rnd_loss = 0 if self.rnd else None
+      # Symmetry loss
+      mean_symmetry_loss = 0 if self.symmetry else None
+
+      # Get mini-batch generator
+      if self.actor.is_recurrent or self.critic.is_recurrent:
+          generator = self.storage.recurrent_mini_batch_generator(self.num_mini_batches, self.num_learning_epochs)
+      else:
+          generator = self.storage.mini_batch_generator(self.num_mini_batches, self.num_learning_epochs)
+
+      # Iterate over mini-batches
+      for batch in generator:
+          original_batch_size = batch.observations.batch_size[0]
+
+          # Check if we should normalize advantages per mini-batch
+          if self.normalize_advantage_per_mini_batch:
+              with torch.no_grad():
+                  batch.advantages = (batch.advantages - batch.advantages.mean()) / (batch.advantages.std() + 1e-8)  # type: ignore
+
+          # Perform symmetric augmentation if enabled
+          if self.symmetry:
+              self.symmetry.augment_batch(batch, original_batch_size)
+
+          # Recompute actions log prob and entropy for current batch of transitions
+          # Note: We need to do this because we updated the policy with new parameters
+          self.actor(
+              batch.observations,
+              masks=batch.masks,
+              hidden_state=batch.hidden_states[0],
+              stochastic_output=True,
+          )
+          actions_log_prob = self.actor.get_output_log_prob(batch.actions)  # type: ignore
+          values = self.critic(batch.observations, masks=batch.masks, hidden_state=batch.hidden_states[1])
+          # Note: We only keep the following tensors for the original samples in case of symmetry augmentation
+          distribution_params = tuple(p[:original_batch_size] for p in self.actor.output_distribution_params)
+          entropy = self.actor.output_entropy[:original_batch_size]
+
+          # Compute KL divergence and adapt the learning rate
+          if self.desired_kl is not None and self.schedule == "adaptive":
+              with torch.inference_mode():
+                  kl = self.actor.get_kl_divergence(batch.old_distribution_params, distribution_params)  # type: ignore
+                  kl_mean = torch.mean(kl)
+
+                  # Reduce the KL divergence across all GPUs
+                  if self.is_multi_gpu:
+                      torch.distributed.all_reduce(kl_mean, op=torch.distributed.ReduceOp.SUM)
+                      kl_mean /= self.gpu_world_size
+
+                  # Update the learning rate only on the main process
+                  if self.gpu_global_rank == 0:
+                      if kl_mean > self.desired_kl * 2.0:
+                          self.learning_rate = max(1e-5, self.learning_rate / 1.5)
+                      elif kl_mean < self.desired_kl / 2.0 and kl_mean > 0.0:
+                          self.learning_rate = min(1e-2, self.learning_rate * 1.5)
+
+                  # Update the learning rate for all GPUs
+                  if self.is_multi_gpu:
+                      lr_tensor = torch.tensor(self.learning_rate, device=self.device)
+                      torch.distributed.broadcast(lr_tensor, src=0)
+                      self.learning_rate = lr_tensor.item()
+
+                  # Update the learning rate for all parameter groups
+                  for param_group in self.optimizer.param_groups:
+                      param_group["lr"] = self.learning_rate
+
+          # Surrogate loss
+          ratio = torch.exp(actions_log_prob - torch.squeeze(batch.old_actions_log_prob))  # type: ignore
+          surrogate = -torch.squeeze(batch.advantages) * ratio  # type: ignore
+          surrogate_clipped = -torch.squeeze(batch.advantages) * torch.clamp(  # type: ignore
+              ratio, 1.0 - self.clip_param, 1.0 + self.clip_param
+          )
+          surrogate_loss = torch.max(surrogate, surrogate_clipped).mean()
+
+          # Value function loss
+          if self.use_clipped_value_loss:
+              value_clipped = batch.values + (values - batch.values).clamp(-self.clip_param, self.clip_param)
+              value_losses = (values - batch.returns).pow(2)
+              value_losses_clipped = (value_clipped - batch.returns).pow(2)
+              value_loss = torch.max(value_losses, value_losses_clipped).mean()
+          else:
+              value_loss = (batch.returns - values).pow(2).mean()
+
+          loss = surrogate_loss + self.value_loss_coef * value_loss - self.entropy_coef * entropy.mean()
+
+          # ---------------------------------------------------- CAPS 공간 평활 항 (우리 추가)
+          # 여기 말고 다른 곳은 부모와 한 글자도 다르지 않다.
+          if self.caps_lambda_s > 0.0 or self.caps_lambda_t > 0.0 or self.lcp_lambda > 0.0:
+              caps_loss = self._caps_loss(batch, original_batch_size)
+              loss = loss + caps_loss
+              mean_caps_loss += float(caps_loss.item())
+
+          # RND loss
+          rnd_loss = self.rnd.compute_loss(batch.observations[:original_batch_size]) if self.rnd else None  # type: ignore
+
+          # Symmetry loss
+          if self.symmetry:
+              symmetry_loss = self.symmetry.compute_loss(self.actor, batch, original_batch_size)
+              if self.symmetry.use_mirror_loss:
+                  loss = loss + self.symmetry.mirror_loss_coeff * symmetry_loss
+
+          # Compute the gradients for PPO
+          self.optimizer.zero_grad()
+          loss.backward()
+          # Compute the gradients for RND
+          if self.rnd:
+              self.rnd.optimizer.zero_grad()
+              rnd_loss.backward()
+
+          # Collect gradients from all GPUs
+          if self.is_multi_gpu:
+              self.reduce_parameters()
+
+          # Apply the gradients for PPO
+          nn.utils.clip_grad_norm_(self.actor.parameters(), self.max_grad_norm)
+          nn.utils.clip_grad_norm_(self.critic.parameters(), self.max_grad_norm)
+          self.optimizer.step()
+          # Apply the gradients for RND
+          if self.rnd:
+              self.rnd.optimizer.step()
+
+          # Store the losses
+          mean_value_loss += value_loss.item()
+          mean_surrogate_loss += surrogate_loss.item()
+          mean_entropy += entropy.mean().item()
+          # RND loss
+          if mean_rnd_loss is not None:
+              mean_rnd_loss += rnd_loss.item()
+          # Symmetry loss
+          if mean_symmetry_loss is not None:
+              mean_symmetry_loss += symmetry_loss.item()
+
+      # Divide the losses by the number of updates
+      num_updates = self.num_learning_epochs * self.num_mini_batches
+      mean_value_loss /= num_updates
+      mean_surrogate_loss /= num_updates
+      mean_entropy /= num_updates
+      if mean_rnd_loss is not None:
+          mean_rnd_loss /= num_updates
+      if mean_symmetry_loss is not None:
+          mean_symmetry_loss /= num_updates
+
+      # Construct the loss dictionary
+      loss_dict = {
+          "value": mean_value_loss,
+          "surrogate": mean_surrogate_loss,
+          "entropy": mean_entropy,
+      }
+      if self.rnd:
+          loss_dict["rnd"] = mean_rnd_loss
+      if self.symmetry:
+          loss_dict["symmetry"] = mean_symmetry_loss
+
+      # Clear the storage
+      self.storage.clear()
+
+      loss_dict["smooth"] = mean_caps_loss / max(1, num_updates)
+      return loss_dict
