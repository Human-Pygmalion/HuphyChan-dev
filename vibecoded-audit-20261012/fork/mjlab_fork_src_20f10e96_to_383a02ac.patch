@@ -0,0 +1,202 @@
+"""Configuration for velocity policy evaluation."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from typing import Any
+
+
+@dataclass(frozen=True)
+class DisturbanceConfig:
+  """Simulation disturbance switches for evaluation."""
+
+  domain_randomization: bool = True
+  observation_noise: bool = True
+  push_robot: bool = True
+
+
+@dataclass(frozen=True)
+class CommandGridConfig:
+  """Command grid swept by the evaluator."""
+
+  linear_speeds: tuple[float, ...] = (0.5, 1.0)
+  angular_speeds: tuple[float, ...] = (0.5, 1.0)
+  directions: tuple[str, ...] = ("N", "NE", "E", "SE", "S", "SW", "W", "NW")
+
+
+@dataclass(frozen=True)
+class VelocityEvalConfig:
+  """Configuration for velocity policy evaluation."""
+
+  checkpoint: str = (
+    "logs/rsl_rl/pygmalion_velocity/"
+    "2026-06-23_16-33-46_no_torque_penalty/model_30000.pt"
+  )
+  task_id: str = "Mjlab-Velocity-Flat-Pygmalion"
+  envs_per_command: int = 128
+  max_parallel_envs: int = 4096
+  episode_length_s: float = 20.0
+  warmup_s: float = 2.0
+  device: str | None = None
+  seed: int | None = 0
+  output_root: str | None = None
+  eval_root: str = "logs/eval"
+  run_name: str | None = None
+  log_root: str = "logs/rsl_rl"
+  slip_speed_threshold: float = 0.1
+  plot_sample_limit: int = 200_000
+  plot_sample_stride: int = 10
+  save_plots: bool = True
+  save_raw_cfrc_components: bool = True
+  disturbances: DisturbanceConfig = field(default_factory=DisturbanceConfig)
+  commands: CommandGridConfig = field(default_factory=CommandGridConfig)
+
+  @classmethod
+  def from_file(cls, path: str | Path) -> VelocityEvalConfig:
+    """Load config from JSON or YAML."""
+    path = Path(path)
+    with path.open() as f:
+      if path.suffix.lower() in {".yaml", ".yml"}:
+        try:
+          import yaml
+        except ImportError as exc:
+          raise RuntimeError(
+            "YAML config files require PyYAML. Use JSON or install PyYAML."
+          ) from exc
+        data = yaml.safe_load(f)
+      else:
+        data = json.load(f)
+    if not isinstance(data, dict):
+      raise ValueError(f"Expected a mapping in {path}, got {type(data).__name__}.")
+    return cls.from_mapping(data)
+
+  @classmethod
+  def from_mapping(cls, data: dict[str, Any]) -> VelocityEvalConfig:
+    """Create a config from a partially specified mapping."""
+    default = cls()
+    disturbance_data = data.get("disturbances", {})
+    if not isinstance(disturbance_data, dict):
+      raise ValueError("`disturbances` must be a mapping.")
+    command_data = data.get("commands", {})
+    if not isinstance(command_data, dict):
+      raise ValueError("`commands` must be a mapping.")
+
+    disturbances = DisturbanceConfig(
+      domain_randomization=bool(
+        disturbance_data.get(
+          "domain_randomization", default.disturbances.domain_randomization
+        )
+      ),
+      observation_noise=bool(
+        disturbance_data.get(
+          "observation_noise", default.disturbances.observation_noise
+        )
+      ),
+      push_robot=bool(
+        disturbance_data.get("push_robot", default.disturbances.push_robot)
+      ),
+    )
+    commands = CommandGridConfig(
+      linear_speeds=_float_tuple(
+        command_data.get("linear_speeds", default.commands.linear_speeds)
+      ),
+      angular_speeds=_float_tuple(
+        command_data.get("angular_speeds", default.commands.angular_speeds)
+      ),
+      directions=tuple(
+        str(v).upper()
+        for v in command_data.get("directions", default.commands.directions)
+      ),
+    )
+    return cls(
+      checkpoint=str(data.get("checkpoint", default.checkpoint)),
+      task_id=str(data.get("task_id", default.task_id)),
+      envs_per_command=int(data.get("envs_per_command", default.envs_per_command)),
+      max_parallel_envs=int(data.get("max_parallel_envs", default.max_parallel_envs)),
+      episode_length_s=float(data.get("episode_length_s", default.episode_length_s)),
+      warmup_s=float(data.get("warmup_s", default.warmup_s)),
+      device=_optional_str(data.get("device", default.device)),
+      seed=_optional_int(data.get("seed", default.seed)),
+      output_root=_optional_str(data.get("output_root", default.output_root)),
+      eval_root=str(data.get("eval_root", default.eval_root)),
+      run_name=_optional_str(data.get("run_name", default.run_name)),
+      log_root=str(data.get("log_root", default.log_root)),
+      slip_speed_threshold=float(
+        data.get("slip_speed_threshold", default.slip_speed_threshold)
+      ),
+      plot_sample_limit=int(data.get("plot_sample_limit", default.plot_sample_limit)),
+      plot_sample_stride=int(
+        data.get("plot_sample_stride", default.plot_sample_stride)
+      ),
+      save_plots=bool(data.get("save_plots", default.save_plots)),
+      save_raw_cfrc_components=bool(
+        data.get("save_raw_cfrc_components", default.save_raw_cfrc_components)
+      ),
+      disturbances=disturbances,
+      commands=commands,
+    )
+
+  def resolved_output_root(self) -> Path:
+    """Return the concrete output root for this evaluation."""
+    if self.output_root is not None:
+      return Path(self.output_root)
+    return default_output_root_for_checkpoint(
+      self.checkpoint, log_root=self.log_root, eval_root=self.eval_root
+    )
+
+  def to_dict(self) -> dict[str, Any]:
+    """Return a JSON-serializable representation."""
+    return asdict(self)
+
+
+def default_output_root_for_checkpoint(
+  checkpoint: str | Path,
+  *,
+  log_root: str | Path = "logs/rsl_rl",
+  eval_root: str | Path = "logs/eval",
+) -> Path:
+  """Map a training checkpoint path to the default evaluation output root."""
+  checkpoint_path = Path(checkpoint)
+  log_root_path = Path(log_root)
+  eval_root_path = Path(eval_root)
+  rel_checkpoint = _relative_to_log_root(checkpoint_path, log_root_path)
+  if rel_checkpoint is None:
+    return eval_root_path / checkpoint_path.parent.name / checkpoint_path.stem
+  return eval_root_path / rel_checkpoint.parent / checkpoint_path.stem
+
+
+def _relative_to_log_root(path: Path, log_root: Path) -> Path | None:
+  try:
+    return path.relative_to(log_root)
+  except ValueError:
+    pass
+
+  path_parts = path.parts
+  log_parts = log_root.parts
+  if not log_parts:
+    return None
+  for start in range(len(path_parts) - len(log_parts) + 1):
+    if path_parts[start : start + len(log_parts)] == log_parts:
+      relative_parts = path_parts[start + len(log_parts) :]
+      return Path(*relative_parts) if relative_parts else Path()
+  return None
+
+
+def _float_tuple(value: Any) -> tuple[float, ...]:
+  if isinstance(value, (int, float)):
+    return (float(value),)
+  return tuple(float(v) for v in value)
+
+
+def _optional_str(value: Any) -> str | None:
+  if value is None:
+    return None
+  return str(value)
+
+
+def _optional_int(value: Any) -> int | None:
+  if value is None:
+    return None
+  return int(value)
