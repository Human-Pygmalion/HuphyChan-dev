+def _gait_phase(env: ManagerBasedRlEnv, period: float) -> torch.Tensor:
+  """Shared gait clock phase in [0,1) from episode time (stationary MDP needs
+  the same clock in the observation — see gait_clock)."""
+  t = env.episode_length_buf.float() * env.step_dt
+  return (t / period) % 1.0
