+"""RP-mode ankle actuator: joint-space PD on the serial ankle_pitch/ankle_roll hinges with
+the torque clamped to what the real 2-RSU mechanism can deliver at the current pose.
+
+The hardware has two RS03 cranks, each limited to +-peak N*m. At a pose (p, r) the ankle
+torque they can produce is the parallelogram {Jc(p,r)^T tau_c : |tau_c,i| <= peak}. The clamp
+is exactly the hardware's: map the PD ankle torque to crank torques with M = Jc^-T, clip each
+crank at +-peak, map back with Jc^T. Jc(p, r) comes from the IK/FK of the closed-loop model
+(tools/robot_model/ankle_rp_envelope.py) on a (pitch, roll) grid, interpolated bilinearly.
+This is the position-dependent, linearised torque limit of docs/92.
+"""
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+
+import mujoco
+import mujoco_warp as mjwarp
+import torch
+
+from mjlab.actuator.actuator import ActuatorCmd
+from mjlab.actuator.pd_actuator import IdealPdActuator, IdealPdActuatorCfg
+
+
+@dataclass(kw_only=True)
+class AnkleRpActuatorCfg(IdealPdActuatorCfg):
+  envelope_json: str
+  """ankle_rp_envelope.json (grid, per-leg JcT and M matrices, motor peak)."""
+  peak_override: float | None = None
+  """Crank torque clamp; None = the motor peak recorded in the json."""
+
+  def build(self, entity, target_ids, target_names):  # noqa: ANN001
+    return AnkleRpActuator(self, entity, target_ids, target_names)
+
+
+class AnkleRpActuator(IdealPdActuator[AnkleRpActuatorCfg]):
+  def initialize(
+    self, mj_model: mujoco.MjModel, model: mjwarp.Model, data: mjwarp.Data, device: str
+  ) -> None:
+    super().initialize(mj_model, model, data, device)
+    env = json.load(open(self.cfg.envelope_json))
+    self.peak = float(self.cfg.peak_override or env["motor"]["peak"])
+    self.pitch_axis = torch.tensor(env["grid"]["pitch_deg"], device=device).deg2rad()
+    self.roll_axis = torch.tensor(env["grid"]["roll_deg"], device=device).deg2rad()
+    names = list(self._target_names)
+    self.legs: list[tuple[int, int, torch.Tensor, torch.Tensor]] = []
+    for s in "LR":
+      try:
+        ip = names.index(f"{s}_ankle_pitch_joint")
+        ir = names.index(f"{s}_ankle_roll_joint")
+      except ValueError as e:
+        raise ValueError(
+          f"AnkleRpActuator needs both {s}_ankle_pitch_joint and {s}_ankle_roll_joint "
+          f"as targets, got {names}"
+        ) from e
+      leg = env["legs"][s]
+      JcT = torch.tensor(leg["JcT"], dtype=torch.float32, device=device)  # [nP,nR,2,2]
+      M = torch.tensor(leg["M"], dtype=torch.float32, device=device)
+      assert not torch.isnan(JcT).any(), f"{s}: envelope has unreachable grid nodes"
+      self.legs.append((ip, ir, JcT, M))
+    self._pos: torch.Tensor | None = None
+
+  def compute(self, cmd: ActuatorCmd) -> torch.Tensor:
+    self._pos = cmd.pos
+    return super().compute(cmd)
+
+  def _interp(self, table: torch.Tensor, p: torch.Tensor, r: torch.Tensor) -> torch.Tensor:
+    """Bilinear lookup of a [nP,nR,2,2] table at (p, r) [N] -> [N,2,2]; clamped to the grid."""
+    pa, ra = self.pitch_axis, self.roll_axis
+    fp = ((p - pa[0]) / (pa[-1] - pa[0]) * (len(pa) - 1)).clamp(0, len(pa) - 1 - 1e-6)
+    fr = ((r - ra[0]) / (ra[-1] - ra[0]) * (len(ra) - 1)).clamp(0, len(ra) - 1 - 1e-6)
+    i0 = fp.floor().long(); j0 = fr.floor().long()
+    wp = (fp - i0.float())[:, None, None]; wr = (fr - j0.float())[:, None, None]
+    t00 = table[i0, j0]; t10 = table[i0 + 1, j0]; t01 = table[i0, j0 + 1]; t11 = table[i0 + 1, j0 + 1]
+    return (1 - wp) * (1 - wr) * t00 + wp * (1 - wr) * t10 + (1 - wp) * wr * t01 + wp * wr * t11
+
+  def _clip_effort(self, effort: torch.Tensor) -> torch.Tensor:
+    assert self._pos is not None
+    out = effort.clone()
+    for ip, ir, JcT, M in self.legs:
+      p, r = self._pos[:, ip], self._pos[:, ir]
+      tau = torch.stack([effort[:, ip], effort[:, ir]], dim=-1).unsqueeze(-1)  # [N,2,1]
+      # interpolate Jc^T only and invert it per env: interpolating M separately leaves
+      # M_interp @ JcT_interp != I, and the crank clamp then leaks ~0.4 % past peak
+      JT = self._interp(JcT, p, r)
+      tau_c = (torch.linalg.inv(JT) @ tau).clamp(-self.peak, self.peak)
+      tau2 = (JT @ tau_c).squeeze(-1)
+      out[:, ip] = tau2[:, 0]
+      out[:, ir] = tau2[:, 1]
+    return out
