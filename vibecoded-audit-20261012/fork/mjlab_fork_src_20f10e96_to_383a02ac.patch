+def periodic_contact(
+  env: ManagerBasedRlEnv,
+  sensor_name: str,
+  asset_cfg: SceneEntityCfg,
+  period: float = 1.0,
+  stance_ratio: float = 0.6,
+  k_v: float = 8.0,
+  k_f: float = 0.02,
+  sharp: float = 20.0,
+  command_name: str | None = "twist",
+  command_threshold: float = 0.05,
+) -> torch.Tensor:
+  """Siekmann phase-clocked periodic contact reward (B3 backbone).
+
+  Feet half a cycle out of phase (L at phi, R at phi+0.5). Stance window
+  [0, stance_ratio]: reward LOW foot xy speed; swing window: reward LOW foot
+  contact force. Proven in our IsaacLab lineage at weight +1.5 (GRF asym
+  0.83->0.18, GRF peak 8->3.1xBW, CoT 2.6->1.22) and reproduced across 5+
+  papers (docs/reward_research/2026-07-02_gait_research_q123.md F1/F14/F15).
+  Standing failure mode (F11): when the command is ~zero, treat BOTH feet as
+  stance (low-foot-speed reward only, no swing forcing).
+  asset_cfg.site_names must be (left_foot, right_foot) in that order; the
+  contact sensor must report per-foot forces in the same order.
+  """
+  asset: Entity = env.scene[asset_cfg.name]
+  contact_sensor: ContactSensor = env.scene[sensor_name]
+  assert contact_sensor.data.force is not None
+  foot_force = torch.norm(contact_sensor.data.force, dim=-1)  # [B, 2]
+  foot_vel = torch.norm(
+    asset.data.site_lin_vel_w[:, asset_cfg.site_ids, :2], dim=-1
+  )  # [B, 2]
+  phi = _gait_phase(env, period)  # [B]
+  rew = torch.zeros_like(phi)
+  for i, off in enumerate((0.0, 0.5)):
+    ph = (phi + off) % 1.0
+    swing = torch.sigmoid(sharp * (ph - stance_ratio)) * torch.sigmoid(
+      sharp * (1.0 - ph)
+    )
+    rew = (
+      rew
+      + (1.0 - swing) * torch.exp(-k_v * foot_vel[:, i])
+      + swing * torch.exp(-k_f * foot_force[:, i])
+    )
+  rew = 0.5 * rew
+  if command_name is not None:
+    cmd = env.command_manager.get_command(command_name)
+    if cmd is not None:
+      total = torch.norm(cmd[:, :2], dim=1) + torch.abs(cmd[:, 2])
+      standing = total <= command_threshold
+      stand_rew = torch.exp(-k_v * foot_vel).mean(dim=-1)  # both feet quiet
+      rew = torch.where(standing, stand_rew, rew)
+  return rew
+
