+def write_scenario_plots(
+  scenario_dir: Path,
+  scenario_summary: dict[str, Any],
+  model_audit: dict[str, Any],
+) -> dict[str, str]:
+  """Write plots for one scenario from its saved raw arrays."""
+  plt = _pyplot()
+  if plt is None:
+    return {}
+  raw_path = _raw_path_for_scenario(scenario_dir, scenario_summary)
+  if raw_path is None:
+    return {}
+  plot_dir = scenario_dir / "plots"
+  plot_dir.mkdir(parents=True, exist_ok=True)
+  with np.load(raw_path, allow_pickle=False) as raw:
+    paths = {
+      "tracking": _tracking_plot(plt, plot_dir, raw, scenario_summary),
+      "joint_burden": _joint_burden_plot(plt, plot_dir, raw),
+      "torque_usage": _torque_usage_plot(plt, plot_dir, raw, model_audit),
+      "foot_contact_slip": _foot_plot(plt, plot_dir, raw),
+      "link_burden": _link_burden_plot(plt, plot_dir, raw),
+      "tau_v": _tau_v_plot(plt, plot_dir, raw, model_audit),
+    }
+  return {k: str(v) for k, v in paths.items() if v is not None}
+
+
+def _raw_path_for_scenario(
+  scenario_dir: Path, scenario_summary: dict[str, Any]
+) -> Path | None:
+  raw_path = scenario_dir / "raw.npz"
+  if raw_path.exists():
+    return raw_path
+  for value in scenario_summary.get("raw_files", []):
+    candidate = Path(str(value))
+    if candidate.exists():
+      return candidate
+  return None
+
+
+def _tracking_plot(
+  plt: Any,
+  plot_dir: Path,
+  raw: Any,
+  scenario_summary: dict[str, Any],
+) -> Path:
+  time = raw["time"]
+  command = raw["command"]
+  root_lin = raw["root_lin_vel_b"]
+  yaw = raw["root_ang_vel_b_z"]
+  measured_mask = _measured_success_mask(raw)
+  vx_mean = _masked_env_mean(root_lin[:, :, 0], measured_mask)
+  vy_mean = _masked_env_mean(root_lin[:, :, 1], measured_mask)
+  yaw_mean = _masked_env_mean(yaw, measured_mask)
+
+  fig, ax = plt.subplots(figsize=(11, 4.5), constrained_layout=True)
+  series = (
+    ("vx", vx_mean, float(command[0]), "#2d6f9f"),
+    ("vy", vy_mean, float(command[1]), "#5f8f3f"),
+    ("wz", yaw_mean, float(command[2]), "#8a5a9f"),
+  )
+  for label, actual, commanded, color in series:
+    ax.plot(time, actual, label=f"actual {label}", color=color)
+    ax.axhline(commanded, linestyle="--", color=color, label=f"cmd {label}")
+  ax.set_ylabel("velocity component [m/s or rad/s]")
+  ax.axvline(float(raw["warmup_steps"]) * (time[1] - time[0]), color="0.4", alpha=0.6)
+  ax.set_title(f"{scenario_summary['name']} tracking")
+  ax.set_xlabel("time [s]")
+  ax.legend(loc="best")
+  path = plot_dir / "tracking.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return path
+
+
+def _masked_env_mean(values: np.ndarray, mask: np.ndarray) -> np.ndarray:
+  count = mask.sum(axis=1)
+  mean = np.full(values.shape[0], np.nan, dtype=float)
+  np.divide(
+    np.where(mask, values, 0.0).sum(axis=1),
+    count,
+    out=mean,
+    where=count > 0,
+  )
+  return mean
+
+
+def _measured_success_mask(raw: Any) -> np.ndarray:
+  mask = raw["measured"].astype(bool)
+  if "success" in raw.files:
+    mask &= raw["success"].astype(bool)[None, :]
+  return mask
+
+
+def _array_names(values: np.ndarray) -> list[str]:
+  names: list[str] = []
+  for value in values:
+    if isinstance(value, bytes):
+      names.append(value.decode("utf-8"))
+    else:
+      names.append(str(value))
+  return names
+
+
+def _component_stats(
+  values: np.ndarray,
+  mask: np.ndarray,
+  *,
+  abs_value: bool = True,
+  percentile: float = 99.0,
+) -> tuple[np.ndarray, np.ndarray]:
+  values = np.asarray(values, dtype=float)
+  mean = np.zeros(values.shape[-1], dtype=float)
+  pctl = np.zeros(values.shape[-1], dtype=float)
+  for index in range(values.shape[-1]):
+    component = values[..., index]
+    component_mask = mask[..., index] if mask.ndim == values.ndim else mask
+    selected = component[component_mask]
+    selected = selected[np.isfinite(selected)]
+    if abs_value:
+      selected = np.abs(selected)
+    if selected.size == 0:
+      continue
+    mean[index] = float(np.mean(selected))
+    pctl[index] = float(np.percentile(selected, percentile))
+  return mean, pctl
+
+
+def _component_fraction(
+  values: np.ndarray,
+  mask: np.ndarray,
+  *,
+  threshold: float,
+) -> np.ndarray:
+  values = np.asarray(values, dtype=float)
+  fraction = np.zeros(values.shape[-1], dtype=float)
+  for index in range(values.shape[-1]):
+    component = values[..., index]
+    component_mask = mask[..., index] if mask.ndim == values.ndim else mask
+    selected = component[component_mask]
+    selected = selected[np.isfinite(selected)]
+    if selected.size == 0:
+      continue
+    fraction[index] = float(np.mean(selected >= threshold))
+  return fraction
+
+
+def _barh_mean_p99(
+  ax: Any,
+  y: np.ndarray,
+  labels: list[str],
+  mean: np.ndarray,
+  p99: np.ndarray,
+  *,
+  title: str,
+  xlabel: str,
+  show_labels: bool,
+) -> None:
+  ax.barh(y - 0.18, mean, height=0.36, label="mean", color="#3a7ca5")
+  ax.barh(y + 0.18, p99, height=0.36, label="p99", color="#a6683a")
+  ax.set_yticks(y, labels if show_labels else [])
+  ax.set_title(title)
+  ax.set_xlabel(xlabel)
+  ax.legend(loc="best")
+
+
+def _bar_mean_p99(
+  ax: Any,
+  x: np.ndarray,
+  labels: list[str],
+  mean: np.ndarray,
+  p99: np.ndarray,
+  *,
+  title: str,
+  ylabel: str,
+) -> None:
+  ax.bar(x - 0.18, mean, width=0.36, label="mean", color="#3a7ca5")
+  ax.bar(x + 0.18, p99, width=0.36, label="p99", color="#a6683a")
+  ax.set_xticks(x, labels)
+  ax.set_title(title)
+  ax.set_ylabel(ylabel)
+  ax.legend(loc="best")
+
+
+def _joint_burden_plot(plt: Any, plot_dir: Path, raw: Any) -> Path:
+  names = _array_names(raw["joint_names"])
+  mask = _measured_success_mask(raw)
+  vel_mean, vel_p99 = _component_stats(raw["joint_vel"], mask)
+  acc_mean, acc_p99 = _component_stats(raw["joint_acc"], mask)
+  y = np.arange(len(names))
+  fig, axes = plt.subplots(1, 2, figsize=(13, 6), constrained_layout=True)
+  _barh_mean_p99(
+    axes[0],
+    y,
+    names,
+    vel_mean,
+    vel_p99,
+    title="|joint velocity| mean and p99",
+    xlabel="rad/s",
+    show_labels=True,
+  )
+  _barh_mean_p99(
+    axes[1],
+    y,
+    names,
+    acc_mean,
+    acc_p99,
+    title="|joint acceleration| mean and p99",
+    xlabel="rad/s^2",
+    show_labels=False,
+  )
+  path = plot_dir / "joint_burden.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return path
+
+
+def _torque_usage_plot(
+  plt: Any,
+  plot_dir: Path,
+  raw: Any,
+  model_audit: dict[str, Any],
+) -> Path:
+  names = _array_names(raw["actuator_names"])
+  mask = _measured_success_mask(raw)
+  effort = np.asarray(model_audit.get("effort_limit", np.ones(len(names))), dtype=float)
+  effort = np.maximum(effort, 1.0e-6)
+  tau_ratio = np.abs(raw["tau_cmd_unclipped"]) / effort[None, None, :]
+  force_ratio = np.abs(raw["actuator_force"]) / effort[None, None, :]
+  tau_mean, tau_p99 = _component_stats(tau_ratio, mask, abs_value=False)
+  force_mean, force_p99 = _component_stats(force_ratio, mask, abs_value=False)
+  soft = _component_fraction(tau_ratio, mask, threshold=0.7)
+  sat = _component_fraction(force_ratio, mask, threshold=0.99)
+  y = np.arange(len(names))
+  fig, axes = plt.subplots(1, 3, figsize=(16, 6), constrained_layout=True)
+  _barh_mean_p99(
+    axes[0],
+    y,
+    names,
+    tau_mean,
+    tau_p99,
+    title="unclipped tau / limit",
+    xlabel="ratio",
+    show_labels=True,
+  )
+  axes[0].axvline(1.0, linestyle="--", color="0.2", linewidth=0.9)
+  axes[0].axvline(0.7, linestyle=":", color="0.4", linewidth=0.9)
+  _barh_mean_p99(
+    axes[1],
+    y,
+    names,
+    force_mean,
+    force_p99,
+    title="actuator force / limit",
+    xlabel="ratio",
+    show_labels=False,
+  )
+  axes[1].axvline(1.0, linestyle="--", color="0.2", linewidth=0.9)
+  axes[1].axvline(0.7, linestyle=":", color="0.4", linewidth=0.9)
+  axes[2].barh(y - 0.18, soft, height=0.36, label="> 0.7 tau", color="#b5893a")
+  axes[2].barh(y + 0.18, sat, height=0.36, label="> 0.99 force", color="#a53a3a")
+  axes[2].set_yticks(y, [])
+  axes[2].set_title("limit exposure fraction")
+  axes[2].set_xlabel("fraction")
+  axes[2].legend(loc="best")
+  path = plot_dir / "torque_usage.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return path
+
+
+def _foot_plot(plt: Any, plot_dir: Path, raw: Any) -> Path:
+  names = _array_names(raw["foot_names"])
+  mask = _measured_success_mask(raw)
+  contact = raw["foot_contact"].astype(bool)
+  prev_contact = np.concatenate(
+    [np.zeros_like(contact[:1], dtype=bool), contact[:-1]], axis=0
+  )
+  landing_mask = contact & ~prev_contact & mask[:, :, None]
+  stance_mask = contact & mask[:, :, None]
+  landing_mean, landing_p99 = _component_stats(
+    raw["foot_force"], landing_mask, abs_value=False
+  )
+  slip_mean, slip_p99 = _component_stats(
+    raw["slip_speed"], stance_mask, abs_value=False
+  )
+  x = np.arange(len(names))
+  fig, axes = plt.subplots(1, 2, figsize=(10, 4), constrained_layout=True)
+  _bar_mean_p99(
+    axes[0],
+    x,
+    names,
+    landing_mean,
+    landing_p99,
+    title="landing force mean and p99",
+    ylabel="N",
+  )
+  _bar_mean_p99(
+    axes[1],
+    x,
+    names,
+    slip_mean,
+    slip_p99,
+    title="stance slip speed mean and p99",
+    ylabel="m/s",
+  )
+  path = plot_dir / "foot_contact_slip.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return path
+
+
+def _link_burden_plot(plt: Any, plot_dir: Path, raw: Any, top_k: int = 12) -> Path:
+  names = _array_names(raw["body_names"])
+  mask = _measured_success_mask(raw)
+  ext_mean, ext_p99 = _component_stats(
+    raw["cfrc_ext_wrench_norm"], mask, abs_value=False
+  )
+  int_mean, int_p99 = _component_stats(
+    raw["cfrc_int_wrench_norm"], mask, abs_value=False
+  )
+  order = np.argsort(np.maximum(ext_p99, int_p99))[-top_k:]
+  labels = [names[i] for i in order]
+  y = np.arange(len(order))
+  fig, axes = plt.subplots(1, 2, figsize=(13, 5), constrained_layout=True)
+  _barh_mean_p99(
+    axes[0],
+    y,
+    labels,
+    ext_mean[order],
+    ext_p99[order],
+    title="external wrench mean and p99",
+    xlabel="wrench norm",
+    show_labels=True,
+  )
+  _barh_mean_p99(
+    axes[1],
+    y,
+    labels,
+    int_mean[order],
+    int_p99[order],
+    title="internal wrench mean and p99",
+    xlabel="wrench norm",
+    show_labels=False,
+  )
+  path = plot_dir / "link_burden.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return path
+
+
+def _tau_v_plot(
+  plt: Any,
+  plot_dir: Path,
+  raw: Any,
+  model_audit: dict[str, Any],
+  max_points: int = 120_000,
+) -> Path:
+  tau = raw["tau_cmd_unclipped"]
+  vel = raw["actuator_velocity"]
+  force = raw["actuator_force"]
+  actuator_names = [str(v) for v in raw["actuator_names"]]
+  measured = raw["measured"]
+  measured_ids = np.argwhere(measured)
+  if len(measured_ids) == 0:
+    measured_ids = np.argwhere(raw["active"])
+  if len(measured_ids) == 0:
+    measured_ids = np.zeros((0, 2), dtype=int)
+  stride = max(1, int(np.ceil(len(measured_ids) * len(actuator_names) / max_points)))
+  measured_ids = measured_ids[::stride]
+  step_ids = measured_ids[:, 0] if len(measured_ids) else np.asarray([], dtype=int)
+  env_ids = measured_ids[:, 1] if len(measured_ids) else np.asarray([], dtype=int)
+  tau_s = tau[step_ids, env_ids].reshape(-1)
+  vel_s = vel[step_ids, env_ids].reshape(-1)
+  force_s = force[step_ids, env_ids].reshape(-1)
+  actuator_index = np.tile(np.arange(len(actuator_names)), len(measured_ids))
+  groups = np.asarray([_actuator_group(actuator_names[i]) for i in actuator_index])
+
+  fig, axes = plt.subplots(1, 2, figsize=(14, 5), constrained_layout=True)
+  group_names = sorted(set(groups.tolist()))
+  colors = plt.cm.tab10(np.linspace(0.0, 1.0, max(1, len(group_names))))
+  effort = np.asarray(model_audit.get("effort_limit", []), dtype=float)
+  for color, group in zip(colors, group_names, strict=False):
+    mask = groups == group
+    axes[0].scatter(vel_s[mask], tau_s[mask], s=3, alpha=0.25, color=color, label=group)
+    axes[1].scatter(
+      vel_s[mask], force_s[mask], s=3, alpha=0.25, color=color, label=group
+    )
+    if effort.size == len(actuator_names):
+      idx = [
+        i for i, name in enumerate(actuator_names) if _actuator_group(name) == group
+      ]
+      if idx:
+        limit = float(np.max(effort[idx]))
+        axes[0].axhline(limit, color=color, linewidth=0.8, alpha=0.6)
+        axes[0].axhline(-limit, color=color, linewidth=0.8, alpha=0.6)
+        axes[1].axhline(limit, color=color, linewidth=0.8, alpha=0.6)
+        axes[1].axhline(-limit, color=color, linewidth=0.8, alpha=0.6)
+  axes[0].set_title("unclipped PD demand")
+  axes[0].set_xlabel("joint velocity [rad/s]")
+  axes[0].set_ylabel("tau [Nm]")
+  axes[1].set_title("MuJoCo actuator force")
+  axes[1].set_xlabel("joint velocity [rad/s]")
+  axes[1].set_ylabel("force [Nm]")
+  axes[1].legend(loc="best", markerscale=4)
+  path = plot_dir / "tau_v.png"
+  fig.savefig(path, dpi=160)
+  plt.close(fig)
+  return path
+
+
+def _pyplot() -> Any | None:
+  try:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+  except ImportError:
+    return None
+  return plt
+
+
+def _actuator_group(name: str) -> str:
+  if "ankle_roll" in name:
+    return "ankle_roll"
+  if "hip_yaw" in name or "ankle_pitch" in name:
+    return "hip_yaw_ankle_pitch"
+  if "knee" in name:
+    return "knee"
+  if "hip_pitch" in name or "hip_roll" in name:
+    return "hip_pitch_roll"
+  return "other"
