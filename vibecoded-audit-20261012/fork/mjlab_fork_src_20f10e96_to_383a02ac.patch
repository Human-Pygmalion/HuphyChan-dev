+"""Pygmalion constants."""
+
+import os
+from pathlib import Path
+
+import mujoco
+import numpy as np
+
+from mjlab import MJLAB_SRC_PATH
+from mjlab.actuator import BuiltinPositionActuatorCfg
+from mjlab.entity import EntityArticulationInfoCfg, EntityCfg
+from mjlab.utils.actuator import (
+  ElectricActuator,
+)
+from mjlab.utils.spec_config import CollisionCfg
+from mjlab.utils.string import filter_exp
+
+##
+# MJCF and assets.
+##
+
+# PYG_HIP_CANT30=1 (2026-07-14, user/docs 67 §3): CAD-confirmed hip geometry
+# variant — hip_pitch axis canted 30° inner-up (frontal plane), pitch↔yaw made
+# exactly intersecting (skew 3.4mm→0), hip_roll axis offset 29.7mm perp from
+# the pitch∩yaw point (lat 28.3 / vert 8.6 / fwd 2.3 mm), roll axis keeps its
+# intentional 15° up-cant. Zero-pose link positions identical to base (only
+# joint pos/axis edited), keyframe joint VALUES unchanged. Same toggle pattern
+# as PYG_INIT_BENT. Verified: analysis/verify_cant30_geometry.py.
+_HIP_CANT30 = bool(os.environ.get("PYG_HIP_CANT30"))
+
+# PYG_ROLLOFF30=1 (2026-07-14, user/docs 67 §9): hip_roll axis ONLY translated
+# 30mm outboard (world lateral); yaw/knee/ankle/pitch stay at their ORIGINAL
+# positions (thigh_link pos compensated -30mm to cancel the roll shift for all
+# descendants). So the roll->yaw link gains a fixed 30mm lateral offset; stance
+# width unchanged (foot at original spot). Load hypothesis: the leg load line
+# (through yaw) is now 30mm inboard of the roll axis -> constant F_z*0.03 moment
+# on hip_roll (~+15 N·m stance / +20 P99). Verified: roll dY = ∓30mm exact,
+# yaw/knee/ankle 0.0mm. Same toggle pattern as PYG_HIP_CANT30.
+_ROLLOFF30 = bool(os.environ.get("PYG_ROLLOFF30"))
+
+# PYG_HIP_CANT20=1 (2026-07-16): 20-deg variant of the cant (docs/67 §6 sweet
+# spot). Same construction as cant30 (axis cos20/±sin20, skew re-solved to
+# 0.002mm, CAD roll offset kept); feet-parallel bent init uses hip_yaw ∓0.113
+# (solved: bent toe-out ±6.2° → 0.000°). A/B target: does ankle_pitch recover
+# from cant30fp's 100% RS03 peak (docs/67 §10)?
+_HIP_CANT20 = bool(os.environ.get("PYG_HIP_CANT20"))
+
+# PYG_V2=1 (2026-08-20): the robot rebuilt from the FINAL CAD (tools/robot_model/):
+# exact per-body mass/COM/inertia from the STEP (OCC volume integrals, catalogue
+# motor masses), measured joint axes (three concurrent hip axes, no 15 deg roll
+# cant), knee 370 / shank 490 mm, serial pitch->roll ankle with both RS03 on the
+# shin, sole 43 mm under the ankle axis. Upper body is a placeholder lump until the
+# Fusion export carries the arms. Standing height comes from the model's own
+# validation file so the keyframe never drifts from the geometry.
+_V2 = bool(os.environ.get("PYG_V2"))
+# MJLAB_SRC_PATH = <repo>/mujoco-sim/mjlab/src/mjlab -> parents[3] is the repo root
+_V2_VALID = (
+  MJLAB_SRC_PATH.parents[3]
+  / "pygmalion_locomotion"
+  / "assets"
+  / "pygmalion_v2"
+  / "validation.json"
+)
+
+# PYG_V2_XML=pygmalion_v3_printed.xml (2026-08-23): the same robot with the 3D-printed
+# lower body at its measured density (docs/89 s5) - 35.35 kg instead of 42.30. Same
+# geometry, joints and keyframes; only the mass properties differ.
+# PYG_ANKLE_LOOP=1 (2026-08-23): train WITH the 2-RSU closed loop instead of the serial
+# pitch/roll approximation. The XML (build_robot.py --ankle=loop) carries, per leg, two
+# crank hinges (the RS03 rotors), two push rods on universal joints and four
+# `equality/connect` constraints that close the rod ends on the foot's ball joints; the
+# ankle_pitch/ankle_roll hinges stay in the tree but are PASSIVE. Verified in plain MuJoCo
+# (tools/robot_model/loop_ankle_verify.py, docs/91): closure < 0.61 mm over the +-40 deg
+# crank grid, transmission pitch -1.21 / roll -1.42 per crank, every design-ROM corner
+# reachable, ground contact through the box sole. Implies PYG_V2.
+# PYG_ANKLE_MODE (2026-08-23, user): the two ankle cases trained side by side.
+#   AB  the closed loop above - the policy commands the two crank motors (= PYG_ANKLE_LOOP=1)
+#   RP  the serial pitch/roll hinges, but the torque is clamped to what the mechanism can
+#       deliver at the current pose (AnkleRpActuator: ankle -> crank torque through the loop
+#       Jacobian, +-60 N*m per crank, back), and the joints carry the motors' inertia,
+#       damping and friction reflected through the loop (ankle_rp_envelope.json).
+#   ""  legacy serial model (fixed 90/50 N*m caps) - the pre-2026-08-23 runs.
+# Position limits are the ankle pitch/roll ranges in every mode (the loop model keeps the
+# passive ankle hinges' ranges; the crank range +-1.2 rad never binds first).
+ANKLE_MODE = os.environ.get("PYG_ANKLE_MODE", "").upper()
+assert ANKLE_MODE in ("", "AB", "RP"), (
+  f"PYG_ANKLE_MODE must be AB or RP, got {ANKLE_MODE!r}"
+)
+_ANKLE_LOOP = bool(os.environ.get("PYG_ANKLE_LOOP")) or ANKLE_MODE == "AB"
+_ANKLE_RP = ANKLE_MODE == "RP"
+if _ANKLE_LOOP and _ANKLE_RP:
+  raise ValueError("PYG_ANKLE_LOOP=1 contradicts PYG_ANKLE_MODE=RP")
+
+# Motor parameters at the output shaft: rotor+gear inertia J, viscous damping b, Coulomb
+# friction tc.  PYG_MOTOR_MEAS=0 keeps the old catalogue armature (0.007/0.005, no friction)
+# for re-running older configs.
+#
+# 2026-09-10: re-measured with the CAN adapter wired straight to a Raspberry Pi, so the
+# control loop runs at ~4 kHz instead of 230 Hz (docs/130 for the method, docs/131 for the
+# handoff).  Inertia comes from two independent routes that agree - a coast-down with the
+# torque released, and the slope of torque against acceleration where friction cancels in
+# the subtraction - and is confirmed model-free by the resonance frequency, which sits at
+# 2.48 Hz at kp=20 where sqrt(kp/J)/2pi puts it.  Friction and viscous drag come from the
+# pure coast-down and check out against the triangle-wave lag (friction/kp) to 1%.
+#
+# ★ The row that stood here until now (RS04 0.016333 / 0.009492 / 0.269456) was a
+# transcription error - it did not match the bench numbers it cited, which were
+# 0.030605 / 0.026008 / 0.526084.  Every policy trained between 2026-08-23 and now learned
+# hip pitch, hip roll and knee from those wrong numbers.  docs/131 has the audit.
+MOTOR_MEAS = {
+  "RS04": dict(armature=0.0773, damping=0.0275, frictionloss=0.519),
+  "RS03": dict(armature=0.0638, damping=0.0252, frictionloss=0.251),
+}
+# 2026-09-12: PYG_MOTOR_MEAS_LEGACY=1 puts back the row that stood here before e3c67da2,
+# so a checkpoint from that era can be replayed on the motors it actually trained with
+# instead of on today's heavier ones.  Comparing two generations is only a single-variable
+# comparison if each policy runs on its own body.  MEASUREMENT ONLY - it prints a warning
+# because a training run must never see these numbers again.
+_MOTOR_MEAS_LEGACY = os.environ.get("PYG_MOTOR_MEAS_LEGACY", "0") not in ("", "0")
+if _MOTOR_MEAS_LEGACY:
+  MOTOR_MEAS = {
+    "RS04": dict(armature=0.016333, damping=0.009492, frictionloss=0.269456),
+    "RS03": dict(armature=0.015265, damping=0.022342, frictionloss=0.285370),
+  }
+  print(
+    "[motor-legacy] PYG_MOTOR_MEAS_LEGACY=1 - using the pre-2026-09-10 motor numbers "
+    "(RS04 armature 0.016333, RS03 0.015265). Replay only; never train with this set."
+  )
+_MOTOR_MEAS = os.environ.get("PYG_MOTOR_MEAS", "1") != "0"
+ANKLE_RP_ENVELOPE = (
+  MJLAB_SRC_PATH.parents[3]
+  / "pygmalion_locomotion"
+  / "assets"
+  / "pygmalion_v2"
+  / "ankle_rp_envelope.json"
+)
+
+
+# Measured torque-speed curves (Motor_Spec/<family>_TN_curve_48V.csv, output shaft; the csv
+# starts at the corner speed where the peak begins to roll off, and the official no-load
+# speed is 200 rpm for both). PYG_TN=0 falls back to the MuJoCo position actuators with the
+# flat peak clamp (pre-2026-08-23 behaviour).
+_TN = os.environ.get("PYG_TN", "1") != "0"
+_MOTOR_SPEC = MJLAB_SRC_PATH.parents[3] / "Motor_Spec"
+NO_LOAD_RPM = {"RS04": 200.0, "RS03": 200.0}
+
+
+def tn_curve(family: str) -> tuple[tuple[float, float], ...]:
+  import csv
+
+  f = _MOTOR_SPEC / f"{family}_TN_curve_48V.csv"
+  assert f.exists(), f"T-N curve missing: {f}"
+  rows = [
+    (float(r["speed_rpm"]), float(r["torque_Nm"])) for r in csv.DictReader(open(f))
+  ]
+  rows.append((NO_LOAD_RPM[family], 0.0))
+  rpm = 2 * 3.141592653589793 / 60
+  return tuple((w * rpm, t) for w, t in rows)
+
+
+from mjlab.asset_zoo.robots.pygmalion.tn_actuator import (  # noqa: E402
+  AnkleRpTnActuatorCfg,
+  TnPdActuatorCfg,
+)
+
+
+def _pd(family: str, **kw):
+  """Position PD actuator cfg: T-N clamped (Python PD, per substep) or the MuJoCo builtin."""
+  if _TN:
+    return TnPdActuatorCfg(tn_curve=tn_curve(family), **kw)
+  return BuiltinPositionActuatorCfg(**kw)
+
+
+def _motor(family: str) -> dict:
+  """armature/frictionloss/viscous_damping kwargs for a BuiltinPositionActuatorCfg."""
+  if not _MOTOR_MEAS:
+    return dict(armature={"RS04": 0.007, "RS03": 0.005}[family])
+  m = MOTOR_MEAS[family]
+  return dict(
+    armature=m["armature"], frictionloss=m["frictionloss"], viscous_damping=m["damping"]
+  )
+
+
+def _ankle_reflected() -> dict[str, dict[str, float]]:
+  """Motor params reflected to the serial ankle hinges through the loop (centre pose)."""
+  import json
+
+  assert ANKLE_RP_ENVELOPE.exists(), (
+    f"need {ANKLE_RP_ENVELOPE} (tools/robot_model/ankle_rp_envelope.py)"
+  )
+  c = json.load(open(ANKLE_RP_ENVELOPE))["legs"]["L"]["reflected_center"]
+  return {
+    "pitch": dict(
+      armature=c["armature"][0],
+      frictionloss=c["frictionloss"][0],
+      viscous_damping=c["damping"][0],
+    ),
+    "roll": dict(
+      armature=c["armature"][1],
+      frictionloss=c["frictionloss"][1],
+      viscous_damping=c["damping"][1],
+    ),
+  }
+
+
+# PYG_MODEL_V4=1 (2026-08-26): the rebuild that carries the measured IMU site and the
+# reworked shoulder at printed density (docs/105). Default OFF so every existing launcher,
+# measurement and replay keeps loading the v3 model the 15 current policies trained on.
+# NOTE the loop branch had no PYG_V2_XML override, so AB could not reach a non-v3 model at all.
+_V4 = os.environ.get("PYG_MODEL_V4", "").strip().lower() not in ("", "0", "false", "no")
+_MODEL_TAG = os.environ.get("PYG_MODEL_TAG", "").strip()
+if _MODEL_TAG:
+  # Model tags are filenames, not arbitrary paths.  Keeping the override this narrow
+  # lets prototype mass builds be selected without weakening the asset-root boundary.
+  import re as _re
+
+  if not _re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", _MODEL_TAG):
+    raise ValueError(f"invalid PYG_MODEL_TAG={_MODEL_TAG!r}")
+_XML_NAME = (
+  (
+    (_MODEL_TAG + "_loop.xml")
+    if _MODEL_TAG
+    else ("pygmalion_v4_printed_loop.xml" if _V4 else "pygmalion_v3_printed_loop.xml")
+  )
+  if _ANKLE_LOOP
+  # RP is the serial twin of the loop build: same printed masses, box sole, capsules -
+  # the only difference between the two arms must be the ankle mechanism
+  else os.environ.get(
+    "PYG_V2_XML", "pygmalion_v4_printed.xml" if _V4 else "pygmalion_v3_printed.xml"
+  )
+  if _ANKLE_RP
+  else os.environ.get("PYG_V2_XML", "pygmalion_v2.xml")
+  if _V2
+  else "pygmalion_cant30.xml"
+  if _HIP_CANT30
+  else "pygmalion_cant20.xml"
+  if _HIP_CANT20
+  else "pygmalion_rolloff30.xml"
+  if _ROLLOFF30
+  else "pygmalion.xml"
+)
+PYG_XML: Path = (
+  MJLAB_SRC_PATH / "asset_zoo" / "robots" / "pygmalion" / "xmls" / _XML_NAME
+)
+assert PYG_XML.exists()
+
+
+# PYG_ANKLE_ROLL15=1 (2026-08-04, docs/71 §7i-§7l): clamp ankle roll ROM to the
+# G1-class +-15 deg (0.261799 rad) for the 2-RSU / JS6 swing-cone feasibility
+# A/B. Base XML is +-20 deg. Same toggle pattern as PYG_HIP_CANT30.
+_ANKLE_ROLL15 = bool(os.environ.get("PYG_ANKLE_ROLL15"))
+
+_ANKLE_ROLL15_RANGE = (-0.261799, 0.261799)
+
+##
+# Mechanical ranges and mirror-aware posture signs (2026-09-03).
+#
+# Up to v4 the left and right legs shared one joint-angle convention, so a single regex
+# (".*_knee_joint": -0.35) said the same thing to both legs.  v30 does NOT: its generator
+# mirrors the axes, so L_knee is axis +Y range [0, +120] deg and R_knee is axis -Y range
+# [-120, 0] deg -- both meaning "0 = straight, +120 = fully flexed", with OPPOSITE q signs.
+# One regex then puts the left knee's default 20 deg outside its own range and its command
+# clip entirely outside the reachable band: usable window 0 deg, motor pinned against the
+# stop at 21.8 N*m for a whole episode (legonly_ab_v1, docs/experiments/
+# 2026-09-03_legonly_gait_kinematics.md; docs/reward_research/
+# 2026-09-03_stiff_knee_root_cause.md).
+#
+# The fix is to stop writing signed numbers by hand.  Posture is stated ONCE as a physical
+# MAGNITUDE (flexion 20 deg) and signed per joint from that joint's own MJCF range, so the
+# config follows whatever the model says.  On a symmetric model every derived value equals
+# the number that used to be hardcoded, so nothing about the v2/v3/v4 policies changes.
+# The MODEL IS NEVER EDITED here: docs/117's model audit stays valid.
+##
+
+
+def _joint_ranges(xml: Path) -> dict[str, tuple[float, float]]:
+  """(lo, hi) in radians for every range-carrying joint in an MJCF, by joint name.
+
+  Joints with no ``range`` attribute (the free root, the loop's rod universals) are
+  unlimited and simply absent.
+  """
+  import xml.etree.ElementTree as ElementTree
+
+  out: dict[str, tuple[float, float]] = {}
+  for j in ElementTree.parse(str(xml)).getroot().iter("joint"):
+    name, rng = j.get("name"), j.get("range")
+    if name and rng:
+      lo, hi = (float(v) for v in rng.split())
+      out[name] = (lo, hi)
+  return out
+
+
+PYG_JOINT_RANGE: dict[str, tuple[float, float]] = _joint_ranges(PYG_XML)
+if _ANKLE_ROLL15:
+  # mirror the ROM override get_spec() applies, so every derived number below describes
+  # the model the trainer actually compiles.
+  for _n in ("L_ankle_roll_joint", "R_ankle_roll_joint"):
+    if _n in PYG_JOINT_RANGE:
+      PYG_JOINT_RANGE[_n] = _ANKLE_ROLL15_RANGE
+
+
+def joint_travel_sign(name: str) -> float:
+  """Sign of q that moves ``name`` along its DOMINANT travel direction (+1 or -1).
+
+  A leg joint's range is asymmetric because one direction is the useful one: the knee
+  flexes 120 deg and hyperextends 0-10, the hip pitch flexes 120 and extends 25, the hip
+  roll abducts 85 and adducts 25.  So the far end of the range identifies the direction
+  without any per-model table, and it flips exactly when the model mirrors the axis.
+
+  A SYMMETRIC range (hip yaw, the cranks, ankle roll) carries no direction: this returns
+  +1 there, and callers must not ask such a joint for a posture sign.
+  """
+  lo, hi = PYG_JOINT_RANGE[name]
+  return -1.0 if abs(lo) > abs(hi) else 1.0
+
+
+def assert_unmirrored(*stems: str) -> None:
+  """Fail the import if a joint still addressed by ONE regex is mirrored in this model.
+
+  Every remaining ``.*_<stem>_joint`` entry is a promise that both legs read the same
+  number the same way.  The v30 knee broke that promise silently; this makes the next one
+  loud, at import, before a single iteration is spent.
+  """
+  for stem in stems:
+    lo_hi = [PYG_JOINT_RANGE.get(f"{s}_{stem}_joint") for s in ("L", "R")]
+    if None in lo_hi or lo_hi[0] == lo_hi[1]:
+      continue
+    raise AssertionError(
+      f"{stem}: L range {lo_hi[0]} != R range {lo_hi[1]} in {PYG_XML.name}. A single "
+      f"'.*_{stem}_joint' default/clip means different postures on the two legs - state "
+      f"it as a magnitude through signed_pose() instead (see the v30 knee, "
+      f"docs/reward_research/2026-09-03_stiff_knee_root_cause.md)."
+    )
+
+
+def signed_pose(magnitudes: dict[str, float]) -> dict[str, float]:
+  """Expand {"knee": 0.35} into explicit per-leg joint targets, signed by each range.
+
+  Keys are joint-name stems ("knee" -> "L_knee_joint"/"R_knee_joint"); values are POSITIVE
+  magnitudes along the joint's dominant travel direction (flexion / abduction).  Stems
+  absent from the model are skipped, so the same call works for a leg-only build.
+  Explicit names, not a regex, are what makes the two legs independently addressable.
+  """
+  out: dict[str, float] = {}
+  for stem, mag in magnitudes.items():
+    for side in ("L", "R"):
+      name = f"{side}_{stem}_joint"
+      if name in PYG_JOINT_RANGE:
+        out[name] = joint_travel_sign(name) * mag
+  return out
+
+
+def shoulder_roll_abduction_sign(name: str) -> float:
+  """Sign of q on ``name`` that ABDUCTS that arm (moves it away from the centreline),
+  derived from the joint's own range - same idea as ``joint_travel_sign``, but as its own
+  named function because the two callers (``get_spec``'s weld path and ``_bent_joint_pos``)
+  used to hardcode CONTRADICTORY signs for this one joint (docs/reward_research/
+  2026-09-03_stiff_knee_root_cause.md section 3c) and a shared, range-derived answer is what
+  makes that impossible to repeat.
+
+  Both branches below are verified by direct forward-kinematics probe (rotate the joint,
+  read the arm-link geom's world Y relative to its own shoulder - see
+  ``mujoco-sim/mjlab/tests/test_pygmalion_arm_abduction.py``), not just inferred from a
+  comment - the pre-fix comments on both call sites turned out to be wrong about WHICH axis
+  is mirrored:
+
+  * pre-v30 (``pygmalion_v3/v4_printed[_loop].xml``): L/R share one numeric range
+    (``[-32, +30]`` deg) but their JOINT AXIS is genuinely mirrored (L ``[1,0,0]``, R
+    ``[-1,0,0]``). ``joint_travel_sign`` already returns -1.0 for both names here (32 > 30),
+    which the probe confirms abducts both arms - this is the LEGACY convention every
+    existing v3/v4 policy was trained under, so this branch must never change.
+  * v30 (``..._v30_proxyfix*.xml``): L/R share one JOINT AXIS (``[-1,0,0]`` on both - NOT
+    mirrored, contrary to both old comments) but the RANGE itself is mirrored (L
+    ``[-15,+130]`` deg, R ``[-130,+15]`` deg). ``joint_travel_sign`` derives +1.0 (L) /
+    -1.0 (R) from that, which the same probe confirms ALSO abducts both arms.
+
+  A perfectly symmetric range (``abs(lo) == abs(hi)``, not currently true for either model)
+  carries no direction by ``joint_travel_sign``'s own contract (it returns +1.0, an arbitrary
+  default) - here it falls back to the legacy -1.0 instead, so a hypothetical future model
+  with an exactly-symmetric shoulder_roll range still reproduces the convention every
+  existing policy trained under, rather than silently flipping to the other one.
+  """
+  lo, hi = PYG_JOINT_RANGE[name]
+  if abs(abs(lo) - abs(hi)) < 1e-9:
+    return -1.0
+  return joint_travel_sign(name)
+
+
+# PYG_UPPER_DOF=1 (2026-08-22): free the upper body. pygmalion_v2.xml now carries the
+# ARTICULATED upper body the CAD actually has - waist yaw, and shoulder pitch/roll on each
+# arm (docs/88 s2). Those five joints change the action space from 12 to 17 and would hang
+# limp under a leg-only policy, so by DEFAULT they are welded away here: the torso and arms
+# stay as mass exactly where the CAD puts them, and every existing task, policy and keyframe
+# keeps its 12-DOF meaning. Set the variable to train with the upper body moving.
+def _env_flag(name: str, default: bool = False) -> bool:
+  """Parse a boolean environment flag without treating ``NAME=0`` as true."""
+  value = os.environ.get(name)
+  if value is None:
+    return default
+  return value.strip().lower() not in ("", "0", "false", "no", "off")
+
+
+_UPPER_DOF = _env_flag("PYG_UPPER_DOF")
+UPPER_JOINTS = (
+  "waist_yaw_joint",
+  "L_shoulder_pitch_joint",
+  "R_shoulder_pitch_joint",
+  "L_shoulder_roll_joint",
+  "R_shoulder_roll_joint",
+)
+
+
+def _quat_mul(a, b):
+  """Hamilton product of two (w, x, y, z) quaternions."""
+  w1, x1, y1, z1 = a
+  w2, x2, y2, z2 = b
+  return np.array(
+    [
+      w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2,
+      w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2,
+      w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2,
+      w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2,
+    ]
+  )
+
+
+def get_spec() -> mujoco.MjSpec:
+  spec = mujoco.MjSpec.from_file(str(PYG_XML))
+  if _ANKLE_ROLL15:
+    for j in spec.joints:
+      if j.name in ("L_ankle_roll_joint", "R_ankle_roll_joint"):
+        j.range = list(_ANKLE_ROLL15_RANGE)
+  if not _UPPER_DOF:
+    # PYG_ARM_ABD_DEG (2026-08-23, user): the upper body stays welded, but the arms are held
+    # ABDUCTED by this angle (multiple of 5) before the weld - hanging straight down the arm
+    # capsule overlaps the hip_roll link by 14 mm and the walking envelope by 55 mm
+    # (tools/robot_model/arm_clearance.py). 15 deg clears the nominal pose by 108 mm and the
+    # walking envelope (hip roll -25, yaw +-20, knee -120) by 64 mm; only full-ROM corners
+    # still touch, which the self-collision penalty handles. The sign that abducts a given
+    # side is NOT one constant across model generations (2026-09-04 fix, see
+    # shoulder_roll_abduction_sign's docstring for the forward-kinematics probe that found
+    # this): a single hardcoded "-abd" here quietly abducted the right arm and ADDUCTED the
+    # left one on the v30 build, because v30 mirrors the RANGE (not the axis, contrary to
+    # what this comment used to claim) - joint_travel_sign already reads that per joint.
+    abd = float(os.environ.get("PYG_ARM_ABD_DEG", "15"))
+    for j in [j for j in spec.joints if j.name in UPPER_JOINTS]:
+      if j.name.endswith("_shoulder_roll_joint") and abd:
+        body = j.parent
+        ax = np.asarray(j.axis, dtype=float)
+        ax /= np.linalg.norm(ax)
+        sign = shoulder_roll_abduction_sign(j.name)
+        half = np.radians(sign * abd) / 2
+        q_rot = np.array([np.cos(half), *(np.sin(half) * ax)])
+        body.quat = _quat_mul(np.asarray(body.quat, dtype=float), q_rot)
+      spec.delete(j)  # weld: the links keep their mass and geometry
+    if abd:
+      # the arm-hip contact excludes existed only because the straight arm pierced the hip;
+      # with the arm out they would hide real contacts from the self-collision penalty
+      for ex in [
+        e
+        for e in spec.excludes
+        if "arm" in e.bodyname1 + e.bodyname2 and "hip" in e.bodyname1 + e.bodyname2
+      ]:
+        spec.delete(ex)
+  if _UPPER_DOF:
+    # v2u1 (2026-08-28, user): trim the freed upper-body ROM to walking-relevant ranges.
+    # shoulder_pitch's -180/+60 is a DECLARED human range, not a mechanical stop (the arm is a
+    # dummy rod, nothing collides in +-200/90); for a WALKING policy an arm swinging to -180
+    # only invites degenerate postures, so the user set -90/+60. waist_yaw's cable-limited
+    # +-60 is narrowed to +-45. Env-overridable for future tuning; only applies with UPPER_DOF,
+    # so a welded (leg-only) run is byte-identical.
+    def _rom(env, dflt):
+      v = os.environ.get(env)
+      lo, hi = (float(x) for x in v.split(",")) if v else dflt
+      return [float(np.radians(lo)), float(np.radians(hi))]
+
+    _sp = _rom("PYG_SHOULDER_PITCH_ROM", (-90.0, 60.0))
+    _wy = _rom("PYG_WAIST_YAW_ROM", (-45.0, 45.0))
+    for j in spec.joints:
+      if j.name.endswith("_shoulder_pitch_joint"):
+        j.range = _sp
+      elif j.name == "waist_yaw_joint":
+        j.range = _wy
+  if _ANKLE_RP:
+    # the RP actuator cfg spans pitch AND roll, so the reflected motor params go on the
+    # joints here (ankle_rp_envelope.json reflected_center: J = Jc^T diag(Jm) Jc etc.)
+    #
+    # 2026-08-26: this block used to be gated on _MOTOR_MEAS, so PYG_MOTOR_MEAS=0 left the
+    # RP ankle joints with armature / damping / frictionloss all at ZERO - a massless,
+    # frictionless joint driven by a PD tuned for 0.0209 armature. The policy stopped
+    # walking (0.18 m/s against a 1.6 command). AB's fallback substitutes plausible nominal
+    # values instead, so the two modes were not comparable under that toggle. Now the
+    # reflected inertia is always applied and PYG_MOTOR_MEAS only selects WHICH motor
+    # numbers feed the reflection.
+    refl = _ankle_reflected()
+    for j in spec.joints:
+      for ax in ("pitch", "roll"):
+        if j.name.endswith(f"_ankle_{ax}_joint"):
+          j.armature = refl[ax]["armature"]
+          j.frictionloss = refl[ax]["frictionloss"]
+          j.damping[0] = refl[ax]["viscous_damping"]
+  if _ANKLE_LOOP and (
+    os.environ.get("PYG_LOOP_SOLIMP") or os.environ.get("PYG_LOOP_SOLREF")
+  ):
+    # A/B hook only. The XML already carries the near-rigid rod ends (solimp 0.999
+    # 0.9999 1e-4, docs/91 s4): MuJoCo's default soft connect (d0 0.9; solref 0.002 is
+    # clamped to 2*dt = 10 ms by refsafe) added a fake series spring at the ankle - hanging,
+    # 10 N*m on the foot opened the loop 2.7 mm and deflected the ankle 23 deg where the
+    # serial servo gives 20; with 0.999 it is 0.04 mm / 19.9 deg and no oscillation under
+    # contact load (tools/robot_model/loop_ankle_verify.py --mjlab).
+    for eq in spec.equalities:
+      if os.environ.get("PYG_LOOP_SOLIMP"):
+        v = [float(x) for x in os.environ["PYG_LOOP_SOLIMP"].split()]
+        eq.solimp[: len(v)] = v
+      if os.environ.get("PYG_LOOP_SOLREF"):
+        v = [float(x) for x in os.environ["PYG_LOOP_SOLREF"].split()]
+        eq.solref[: len(v)] = v
+  return spec
+
+
+##
+# Actuator config.
+##
+
+# Motor specs
+
+# Path: kbot/ksim-kbot/ksim_kbot/kscale-assets/kbot/robot.mjcf
+# <default class="motor_00">
+#   <joint armature="0.0005" frictionloss="0.1" actuatorfrcrange="-20.0 20.0" />
+#   <motor ctrlrange="-20.0 20.0" />
+# </default>
+# <default class="motor_02">
+#   <joint armature="0.0015" frictionloss="0.1" actuatorfrcrange="-30.0 30.0" />
+#   <motor ctrlrange="-30.0 30.0" />
+# </default>
+# <default class="motor_03">
+#   <joint armature="0.005" frictionloss="0.001" actuatorfrcrange="-100.0 100.0" />
+#   <motor ctrlrange="-100.0 100.0" />
+# </default>
+# <default class="motor_04">
+#   <joint armature="0.007" frictionloss="0.0015" actuatorfrcrange="-200.0 200.0" />
+#   <motor ctrlrange="-200.0 200.0" />
+# </default>
+
+# Path: kbot/ksim-kbot/ksim_kbot/kscale-assets/kbot-v2/robot.mjcf
+# <default class="motor_00">
+#   <joint armature="0.0005" frictionloss="0.1" actuatorfrcrange="-14.0 14.0" />
+#   <motor ctrlrange="-14.0 14.0" />
+# </default>
+# <default class="motor_02">
+#   <joint armature="0.002" frictionloss="0.1" actuatorfrcrange="-17.0 17.0" />
+#   <motor ctrlrange="-17.0 17.0" />
+# </default>
+# <default class="motor_03">
+#   <joint armature="0.005" frictionloss="0.3" actuatorfrcrange="-60.0 60.0" />
+#   <motor ctrlrange="-60.0 60.0" />
+# </default>
+# <default class="motor_04">
+#   <joint armature="0.007" frictionloss="0.1" actuatorfrcrange="-120.0 120.0" />
+#   <motor ctrlrange="-120.0 120.0" />
+# </default>
+
+ARMATURE_00 = 0.0005
+ARMATURE_03 = 0.0050
+ARMATURE_04 = 0.0070
+ARMATURE_04_KNEES = 0.0070
+
+# velocity_limit, effort_limit
+# https://www.scribd.com/document/932254876/ROBSTRIDE-00-Motor-Instruction-Manual
+# https://www.scribd.com/document/932254882/ROBSTRIDE-04-Motor-Instruction-Manual
+
+ACTUATOR_00 = ElectricActuator(
+  reflected_inertia=ARMATURE_00,
+  velocity_limit=33.0,
+  effort_limit=14.0,
+)
+ACTUATOR_03 = ElectricActuator(
+  reflected_inertia=ARMATURE_03,
+  velocity_limit=20.0,
+  effort_limit=60.0,
+)
+ACTUATOR_04 = ElectricActuator(
+  reflected_inertia=ARMATURE_04,
+  velocity_limit=15.0,
+  effort_limit=120.0,
+)
+ACTUATOR_04_KNEES = ElectricActuator(
+  reflected_inertia=ARMATURE_04_KNEES,
+  velocity_limit=15.0,
+  effort_limit=120.0,
+)
+
+NATURAL_FREQ = 10 * 2.0 * 3.1415926535  # 10Hz
+DAMPING_RATIO = 2.0
+
+STIFFNESS_00 = ARMATURE_00 * NATURAL_FREQ**2
+STIFFNESS_03 = ARMATURE_03 * NATURAL_FREQ**2
+STIFFNESS_04 = ARMATURE_04 * NATURAL_FREQ**2
+STIFFNESS_04_KNEES = ARMATURE_04_KNEES * NATURAL_FREQ**2
+
+DAMPING_00 = 2.0 * DAMPING_RATIO * ARMATURE_00 * NATURAL_FREQ
+DAMPING_03 = 2.0 * DAMPING_RATIO * ARMATURE_03 * NATURAL_FREQ
+DAMPING_04 = 2.0 * DAMPING_RATIO * ARMATURE_04 * NATURAL_FREQ
+DAMPING_04_KNEES = 2.0 * DAMPING_RATIO * ARMATURE_04_KNEES * NATURAL_FREQ
+
+# BuiltinPositionActuatorCfg Class의 attribute로
+# frictionloss와 viscous_damping을 설정할 수 있음
+# 우선은 비워놓고 진행 (2026-06-22)
+
+# A1 gains (2026-07-02): the armature-only sizing (Kp = armature*wn^2) left the
+# big joints 1-2 orders of magnitude too soft against the TRUE link inertia
+# (hip f_eff 0.56 Hz vs intended 10 Hz -> wobble/kneeling/poor tracking).
+# New gains from the offline exact-weld chirp test (analysis/chirp_gain_test.py,
+# docs/mujoco/2026-07-02_analysis_reward_audit_critique.md §5): largest Kp with
+# saturation duty <30% at gait-band swings, zeta~0.5 (crit-damping Kd would
+# self-saturate: |Kd*qd|>limit 59% of the time at the hip). Ankles keep the
+# armature-derived gains (already 3.9-5.7 Hz, near spec).
+# 2-RSU ankle (2026-07-04): adopting the G1/Digit-style 2-RSU parallel ankle
+# (both pitch & roll driven by 2 co-actuating motors up the shin). The old gains
+# were armature-derived (rotor-inertia only -> Kp 1.97 ankle_roll = 14x SOFTER
+# than G1's 28.5 -> near-zero position authority, only "worked" because loads
+# were tiny). Match G1's ankle actuator spec: Kp 28.5 / Kd 1.81 / effort 50 N*m
+# per DOF (G1 is 33kg; Pygmalion 51.5kg = 1.55x, so 50 is the G1-baseline, a
+# 1.5x scale -> ~75 is the conservative alt; our measured ankle_pitch peak 65 is
+# covered by 2-RSU co-actuation ~32/motor). ankle_roll now symmetric with pitch
+# (2-RSU gives both DOF similar capability, unlike the old RS03/RS00 serial split).
+ANKLE_2RSU_KP = 28.5  # G1-class ankle stiffness (position gain, per DOF)
+ANKLE_2RSU_KD = 1.81
+# effort per DOF from mech_design_eval.py (J^T f, 2x RS03 motors, crank~30mm):
+# PITCH = co-actuation of 2 motors -> ~120 joint cap, derated to 90 (continuous
+# /geometry). ROLL = differential -> ~50. This asymmetry IS the 2-RSU physics
+# (pitch stronger than roll), unlike the earlier symmetric-50 oversimplification.
+# Real HW: 2x RS03 covers converged demand (pitch peak 65<90, motor 36<60/188<191rpm).
+ANKLE_2RSU_EFF_PITCH = 90.0
+ANKLE_2RSU_EFF_ROLL = 50.0
+# v2 (2026-08-20 red team): both ankle DOF are driven by the two RS03 through the 2-RSU
+# with measured lever ratios pitch 1.25 / roll 1.68 (docs/87 s5), so the reflected rotor
+# inertia at the joint is 2 x 0.005 / ratio^2 = 0.0064 (pitch) / 0.0035 (roll) - not the
+# RS00 value the old serial model used for roll.
+_ANKLE_ROLL_ARM = (
+  2 * ACTUATOR_03.reflected_inertia / 1.68**2 if _V2 else ACTUATOR_00.reflected_inertia
+)
+_ANKLE_PITCH_ARM = (
+  2 * ACTUATOR_03.reflected_inertia / 1.25**2 if _V2 else ACTUATOR_03.reflected_inertia
+)
+PYG_ACTUATOR_00 = BuiltinPositionActuatorCfg(
+  target_names_expr=(".*_ankle_roll_joint",),
+  stiffness=ANKLE_2RSU_KP,
+  damping=ANKLE_2RSU_KD,
+  effort_limit=ANKLE_2RSU_EFF_ROLL,
+  **(
+    _ankle_reflected()["roll"]
+    if (_MOTOR_MEAS and _V2)
+    else dict(armature=_ANKLE_ROLL_ARM)
+  ),
+)
+
+# PYG_BEYONDMIMIC=1 (2026-07-07, user): swap the reference-scaled hip/knee Kd for
+# physically critical-damped Kd (ζ≈1) computed from our mass-matrix inertia — the
+# BeyondMimic method. Kd 6 gave ζ≈0.16 (hip) / 0.36 (knee) = under-damped -> tends
+# to learn oscillations. Critical Kd from Kd=2√(Kp·I_eff): hip 35, hip_yaw 14,
+# knee 16. Toggle so the current under-damped run stays reproducible for A/B.
+# Derivation: docs/mujoco/2026-07-07_kpkd_beyondmimic_derivation.md.
+_BM = bool(os.environ.get("PYG_BEYONDMIMIC"))
+_HIP_KD = 35.0 if _BM else 6.0
+_HIP_YAW_KD = 14.0 if _BM else 6.0
+_KNEE_KD = 16.0 if _BM else 6.0
+
+# RS03 split: hip_yaw + ankle_pitch. Hip gains reference-scaled (2026-07-06).
+PYG_ACTUATOR_03_HIP_YAW = _pd(
+  "RS03",
+  target_names_expr=(".*_hip_yaw_joint",),
+  # 2026-07-06 (user): 400/9 chirp gains were ~4x G1 -> lowered to reference-scaled
+  # 150/6. G1 hip 100/2 & K-bot (same RS04) hip 100/10 at ~35 kg -> mass-scaled
+  # x(51.5/35=1.47) -> Kp 150; Kd from G1-scaled 3 .. K-bot-scaled 15 -> 6
+  # (K-bot over-damped, discounted). Uniform across hip DOFs like G1/K-bot.
+  stiffness=150.0,
+  damping=_HIP_YAW_KD,
+  effort_limit=ACTUATOR_03.effort_limit,
+  **_motor("RS03"),
+)
+
+PYG_ACTUATOR_03_ANKLE = BuiltinPositionActuatorCfg(
+  target_names_expr=(".*_ankle_pitch_joint",),
+  stiffness=ANKLE_2RSU_KP,  # 2-RSU: match G1 (was armature-derived 19.7)
+  damping=ANKLE_2RSU_KD,
+  effort_limit=ANKLE_2RSU_EFF_PITCH,  # 2-RSU co-act (mech_design_eval)
+  **(
+    _ankle_reflected()["pitch"]
+    if (_MOTOR_MEAS and _V2)
+    else dict(armature=_ANKLE_PITCH_ARM)
+  ),
+)
+
+# RP mode: one actuator over all four ankle hinges (the clamp couples pitch and roll of a
+# leg). Joint-space gains as the serial model; the torque cap is the pose-dependent
+# parallelogram, so effort_limit here is only the XML forcerange (outer bound = largest
+# extent in the envelope, 105 N*m). Joint armature/damping/friction = reflected RS03 via
+# get_spec (one cfg cannot carry two values).
+from mjlab.asset_zoo.robots.pygmalion.ankle_rp_actuator import (  # noqa: E402
+  AnkleRpActuatorCfg,
+)
+
+PYG_ACTUATOR_ANKLE_RP = (AnkleRpTnActuatorCfg if _TN else AnkleRpActuatorCfg)(
+  target_names_expr=(".*_ankle_pitch_joint", ".*_ankle_roll_joint"),
+  stiffness=ANKLE_2RSU_KP,
+  damping=ANKLE_2RSU_KD,
+  effort_limit=110.0,
+  envelope_json=str(ANKLE_RP_ENVELOPE),
+  **(dict(tn_curve=tn_curve("RS03")) if _TN else {}),
+)
+
+# PYG_ANKLE_LOOP crank servo: the RS03 sits directly on the crank hinge, so the joint
+# sees the bare rotor inertia (ARMATURE_03) and the motor's own 60 Nm peak. Gains are the
+# serial per-DOF ankle gains reflected through the co-actuation lever: theta_ankle =
+# r * theta_crank with both cranks moving together, virtual work gives K_ankle =
+# 2 K_crank / r^2 -> K_crank = K_ankle r^2 / 2 = 28.5 * 1.25^2 / 2 = 22.3 (docs/87 s5
+# lever 1.25; the MuJoCo-measured pitch ratio 1.21 gives 19.5 - same band). Same for Kd.
+# These are the gains loop_ankle_verify.py used for every verification figure.
+CRANK_KP = ANKLE_2RSU_KP * 1.25**2 / 2  # 22.3
+CRANK_KD = ANKLE_2RSU_KD * 1.25**2 / 2  # 1.41
+PYG_ACTUATOR_03_CRANK = _pd(
+  "RS03",
+  target_names_expr=(".*_crank_[AB]_joint",),
+  stiffness=CRANK_KP,
+  damping=CRANK_KD,
+  effort_limit=ACTUATOR_03.effort_limit,
+  **_motor("RS03"),
+)
+
+PYG_ACTUATOR_04 = _pd(
+  "RS04",
+  target_names_expr=(
+    ".*_hip_pitch_joint",
+    ".*_hip_roll_joint",
+  ),
+  # 2026-07-06 (user): 400/28 chirp gains were ~4x G1 Kp and heavily over-damped
+  # -> reference-scaled to 150/6 (G1 100/2 & K-bot 100/10 @35kg, mass x1.47,
+  # K-bot over-damping discounted). Same as hip_yaw -> uniform hip like G1/K-bot.
+  stiffness=150.0,
+  damping=_HIP_KD,
+  effort_limit=ACTUATOR_04.effort_limit,
+  **_motor("RS04"),
+)
+
+# 2026-07-07 (user): knee 400 was ~2.7x G1's 150 -> reference-scaled down to
+# 220/6, same method as the hip (G1 knee 150/4 & K-bot RS04 knee 100/10 at ~35 kg
+# -> mass x(51.5/35=1.47) -> Kp 220; Kd 6 with K-bot over-damping discounted).
+# Supersedes the A1b 400/8 (which itself rebalanced the over-stiff 800/12).
+PYG_ACTUATOR_04_KNEES = _pd(
+  "RS04",
+  target_names_expr=(".*_knee_joint",),
+  stiffness=220.0,
+  damping=_KNEE_KD,
+  effort_limit=ACTUATOR_04_KNEES.effort_limit,
+  **_motor("RS04"),
+)
+
+# Upper body (PYG_UPPER_DOF=1). Waist yaw is an RS04, both shoulder joints RS03; gains
+# follow the same reference-scaled family as the hips rather than inventing a new tuning.
+PYG_ACTUATOR_04_WAIST = _pd(
+  "RS04",
+  target_names_expr=("waist_yaw_joint",),
+  stiffness=150.0,
+  damping=_HIP_KD,
+  effort_limit=ACTUATOR_04.effort_limit,
+  **_motor("RS04"),
+)
+
+PYG_ACTUATOR_03_SHOULDER = _pd(
+  "RS03",
+  target_names_expr=(".*_shoulder_pitch_joint", ".*_shoulder_roll_joint"),
+  stiffness=150.0,
+  damping=_HIP_YAW_KD,
+  effort_limit=ACTUATOR_03.effort_limit,
+  **_motor("RS03"),
+)
+
+##
+# Keyframe config.
+##
+
+
+def _v2_standing_z(default):
+  """Base height with the soles on the ground, from the v2 validation run."""
+  if not _V2:
+    return default
+  import json
+
+  f = _V2_VALID.resolve()
+  assert f.exists(), f"PYG_V2 needs {f} (run tools/robot_model/validate_robot.py)"
+  return float(json.load(open(f))["standing_base_z"]) + 0.005
+
+
+HOME_KEYFRAME = EntityCfg.InitialStateCfg(
+  pos=(0, 0, _v2_standing_z(0.87)),
+  joint_pos={".*": 0.0},
+  joint_vel={".*": 0.0},
+)
+
+# PYG_INIT_MID=1 (2026-08-26): a MIDDLE init pose. The bent default puts a human-like
+# touchdown knee (-5 deg) at action +2.33, past the policy's own p95 (+1.76), so the policy
+# lands with the knee still at -30/-38 deg. Halving the crouch moves that to +1.05, inside
+# the everyday range, without returning to the straight init that lost the 2026-07-08 A/B
+# on knee torque (+98 %). Research: docs/reward_research/2026-08-26_human_landing_bundle.md
+_INIT_MID = bool(os.environ.get("PYG_INIT_MID"))
+
+
+def _bent_joint_pos() -> dict[str, float]:
+  """KNEES_BENT joint targets. In loop mode the ankle is passive, so the crouch has to be
+  stated through the cranks - and the rods/ankle written consistently, or every reset
+  starts with the loop torn open (ankle 0.36 rad with cranks at 0 = ~20 mm of rod-end
+  error snapping shut). The consistent set is solved offline in plain MuJoCo
+  (loop_ankle_verify.py --bent -> pygmalion_v3_printed_loop_bent.json, closure 0.000 mm)."""
+  # Stated as FLEXION MAGNITUDES and signed per leg from the model's own ranges
+  # (signed_pose): the MID crouch is hip 10.03 deg / knee 20.05 deg of flexion, the deep
+  # one hip 18.3 / knee 38.4.  Numerically identical to the previous
+  # {".*_hip_pitch_joint": -0.175, ".*_knee_joint": -0.35} on every model whose two legs
+  # share a convention; on v30 it is what stops the left knee being commanded out of its
+  # own range.
+  base = signed_pose(
+    {"hip_pitch": 0.175, "knee": 0.35}
+    if _INIT_MID
+    else {"hip_pitch": 0.32, "knee": 0.67}
+  )
+  # Keep the v2u1 free-upper-body A/B at the same visible starting pose as v2s1, whose arms
+  # are welded after PYG_ARM_ABD_DEG is applied. This USED TO be one regex with a single
+  # hardcoded "+q = abduction", which was the MIRROR-OPPOSITE bug from get_spec()'s (this
+  # abducted the left arm and adducted the right one on v30) - see
+  # shoulder_roll_abduction_sign's docstring (2026-09-04 fix, docs/reward_research/
+  # 2026-09-03_stiff_knee_root_cause.md section 3c). Explicit per-side keys, signed from
+  # each joint's own range, the same way signed_pose does it for the legs.
+  if _UPPER_DOF:
+    abd_rad = np.radians(float(os.environ.get("PYG_ARM_ABD_DEG", "0")))
+    for _side in ("L", "R"):
+      _name = f"{_side}_shoulder_roll_joint"
+      if _name in PYG_JOINT_RANGE:
+        base[_name] = float(shoulder_roll_abduction_sign(_name) * abd_rad)
+  if not _ANKLE_LOOP:
+    # ankle_pitch keeps ONE regex on purpose: unlike the knee/hip it is not mirrored in
+    # any build (both sides axis -Y, range [-50, +30] deg), and +0.36 rad is the SHORT
+    # end of that range, so signed_pose - which points at the long end - would flip it.
+    # assert_unmirrored turns a future mirrored ankle into an import error instead of
+    # another silent left-right asymmetry.
+    assert_unmirrored("ankle_pitch")
+    return {**base, ".*_ankle_pitch_joint": 0.36}
+  import json
+
+  f = _bent_json_path()
+  if not f.exists():
+    # This runs at import (the keyframe is a module constant), so only fail when the bent
+    # keyframe is actually selected - PYG_ANKLE_LOOP alone must stay importable (red team).
+    assert not os.environ.get("PYG_INIT_BENT"), (
+      f"PYG_ANKLE_LOOP + PYG_INIT_BENT needs {f}"
+    )
+    return base
+  jp = json.load(open(f))["joint_pos"]
+  return {**base, **{k: v for k, v in jp.items() if "hip" not in k and "knee" not in k}}
+
+
+def _bent_json_path():
+  """Which solved bent-crouch file the loop keyframe reads.
+
+  The crank/rod/ankle angles of the crouch are a property of ONE build's loop geometry.
+  `pygmalion_v3_printed_loop_bent.json` was solved on the v3 build; on v30 the crank hinge
+  axes are mirrored per side (L_crank_A -Y / L_crank_B +Y / R_crank_A +Y / R_crank_B -Y),
+  so those numbers put L_crank_A and R_crank_B on the wrong side of the linkage and every
+  reset started with the four `connect` equalities torn open (37.23 mm measured on the raw
+  keyframe, 2026-09-05; docs/106 backlog). Prefer a file solved on THIS model tag
+  (`tools/robot_model/loop_bent_keyframe.py --tag <tag>_loop` writes
+  `<tag>_loop_bent.json`, closure 0.000 mm); fall back to the v3 file otherwise.
+
+  PYG_BENT_KEYFRAME_LEGACY=1 forces the v3 file. Use it ONLY to measure or replay a
+  checkpoint trained before 2026-09-05: its policy learned obs = q - default and
+  target = default + scale*a against the OLD crank defaults, so re-expressing the cranks
+  under it shifts L_crank_A/R_crank_B by ~34 deg and invalidates the measurement.
+
+  PYG_BENT_KEYFRAME_FILE=<path> points at any solved file. The v3 fallback above covers
+  one specific old build, but the per-tag file has been re-solved twice since (the leg
+  rename on 2026-09-13, the toes-up ankle on 2026-09-14), and each re-solve moves the
+  action offsets every policy trained before it was learning against - the ankle fix
+  alone moved the cranks by 8.8 deg. Measuring an older checkpoint on today's file is
+  therefore not a single-variable comparison. Recover that run's own file out of git
+  (`git show <commit>:<path>`) and point this at it. MEASUREMENT ONLY, same as
+  PYG_MOTOR_MEAS_LEGACY: a training run must always solve on its own current geometry.
+  """
+  override = os.environ.get("PYG_BENT_KEYFRAME_FILE")
+  if override:
+    f = Path(override)
+    if not f.exists():
+      raise FileNotFoundError(f"PYG_BENT_KEYFRAME_FILE={override} does not exist")
+    print(f"[bent-keyframe] override: reading the crouch from {f}", flush=True)
+    return f
+  legacy = _V2_VALID.parent / "pygmalion_v3_printed_loop_bent.json"
+  if os.environ.get("PYG_BENT_KEYFRAME_LEGACY"):
+    return legacy
+  if _MODEL_TAG:
+    f = _V2_VALID.parent / f"{_MODEL_TAG}_loop_bent.json"
+    if f.exists():
+      return f
+  return legacy
+
+
+def _bent_base_z(default: float) -> float:
+  """Reset height of the bent crouch.
+
+  The solved bent file carries `base_z`: the height that puts the lowest sole collision geom
+  5 mm above the floor in that crouch (whole robot, pure kinematics). Without it the old rule
+  `standing_z - 0.04` buried the v30 soles 31 mm under the floor on the raw keyframe (docs/106
+  quoted 38.6 mm) and the contact solver popped the feet out over the first steps of every
+  episode. Falls back to `default` when the file has no `base_z`.
+  """
+  import json
+
+  f = _bent_json_path()
+  if f.exists():
+    z = json.load(open(f)).get("base_z")
+    if z is not None:
+      return float(z)
+  return default
+
+
+KNEES_BENT_KEYFRAME = EntityCfg.InitialStateCfg(
+  # base_z solved per model tag (see _bent_base_z); the legacy "standing - 0.04" rule stays
+  # as the fallback for builds without a solved bent file.
+  pos=(0, 0, _bent_base_z(_v2_standing_z(0.87) - 0.04)),
+  joint_pos=_bent_joint_pos(),
+  joint_vel={".*": 0.0},
+)
+
+# cant30 feet-parallel init (2026-07-15, user): the canted hip_pitch axis injects
+# yaw when flexed, so the BENT crouch toes the feet OUT ±9°. Add a hip_yaw offset
+# (L −9.455° / R +9.455° = ∓0.165 rad) so the feet start & stand parallel to +X.
+# Solved so foot heading = 0° at the bent flexion (analysis/axis_viz feet check).
+# Used only when PYG_HIP_CANT30 (base/rolloff30 feet are already parallel).
+KNEES_BENT_CANT_KEYFRAME = EntityCfg.InitialStateCfg(
+  pos=(0, 0, 0.83),
+  joint_pos={
+    **signed_pose({"hip_pitch": 0.32, "knee": 0.67}),
+    ".*_ankle_pitch_joint": 0.36,
+    # hip_yaw is symmetric, so its sign is not derivable from the range: these two are a
+    # genuine left/right MIRROR (toe-out compensation), not a convention artefact.
+    # 2026-09-12: the two values are SWAPPED here relative to what stood before, because
+    # the model's L_/R_ names were swapped that day (the chain named L_ was the physical
+    # right leg -- docs/136). Swapping both keeps the simulated pose bit-identical; it is
+    # the label that moved, not the posture.
+    "L_hip_yaw_joint": 0.165,
+    "R_hip_yaw_joint": -0.165,
+  },
+  joint_vel={".*": 0.0},
+)
+
+# PYG_INIT_BENT=1 (2026-07-08, user A/B): start from a bent-knee crouch (knee -38deg,
+# base 0.83) instead of straight (HOME, knee 0, base 0.87). The pose reward targets
+# default_joint_pos (= init keyframe joint angles, entity.py:682 -> rewards.py:641),
+# so this shifts BOTH the initial pose AND the standing posture target -> "walk with
+# bent knees" vs "walk straight". Sole variable for the init-pose A/B (else identical:
+# Kd6, seed 42). Straight arm reuses run 2026-07-07_18-51-51 (Bbase_kd6). See docs 54.
+# cant20 feet-parallel bent init (solved like cant30: heading 0.000°)
+KNEES_BENT_CANT20_KEYFRAME = EntityCfg.InitialStateCfg(
+  pos=(0, 0, 0.83),
+  joint_pos={
+    **signed_pose({"hip_pitch": 0.32, "knee": 0.67}),
+    ".*_ankle_pitch_joint": 0.36,
+    # 2026-09-12 좌우 이름 맞바꿈과 함께 두 값도 맞바꿈 (docs/136). 자세는 그대로.
+    "L_hip_yaw_joint": 0.113,
+    "R_hip_yaw_joint": -0.113,
+  },
+  joint_vel={".*": 0.0},
+)
+
+# Joints the policy observes and the pose reward shapes. In loop mode the eight rod
+# universal hinges are excluded: they are not measurable on the robot (no encoder) and are
+# a deterministic function of the cranks anyway. The passive ankle hinges STAY - the
+# hardware can compute them from the crank encoders through the mechanism - so the pose
+# reward keeps shaping the foot, not the motor, and the ankle stds keep their meaning.
+OBS_JOINT_NAMES: tuple[str, ...] = (
+  (
+    ".*_hip_.*_joint",
+    ".*_knee_joint",
+    ".*_crank_[AB]_joint",
+    ".*_ankle_.*_joint",
+    *(UPPER_JOINTS if _UPPER_DOF else ()),
+  )
+  if _ANKLE_LOOP
+  else (".*",)
+)
+# Encoder contract for the 12-action lower-body policy.  In loop mode the passive
+# ankle-pitch/roll and rod hinges are deliberately absent: only these 12 motor shafts
+# exist in the real policy input/output contract.
+MOTOR_OBS_JOINT_NAMES: tuple[str, ...] = (
+  (".*_hip_.*_joint", ".*_knee_joint", ".*_crank_[AB]_joint")
+  if _ANKLE_LOOP
+  else (".*_hip_.*_joint", ".*_knee_joint", ".*_ankle_(pitch|roll)_joint")
+)
+POSE_JOINT_NAMES: tuple[str, ...] = (
+  (
+    ".*_hip_.*_joint",
+    ".*_knee_joint",
+    ".*_ankle_.*_joint",
+    *(UPPER_JOINTS if _UPPER_DOF else ()),
+  )
+  if _ANKLE_LOOP
+  else (".*",)
+)
+
+if os.environ.get("PYG_INIT_BENT"):
+  if _HIP_CANT30:
+    _INIT_STATE = KNEES_BENT_CANT_KEYFRAME
+  elif _HIP_CANT20:
+    _INIT_STATE = KNEES_BENT_CANT20_KEYFRAME
+  else:
+    _INIT_STATE = KNEES_BENT_KEYFRAME
+else:
+  _INIT_STATE = HOME_KEYFRAME
+
+##
+# Collision config.
+##
+
+# This enables all collisions, including self collisions.
+# Self-collisions are given condim=1
+# while foot collisions are given condim=3.
+FULL_COLLISION = CollisionCfg(
+  geom_names_expr=(".*_collision",),
+  condim={r"^(L|R)_foot[1-7]_collision$": 3, ".*_collision": 1},
+  priority={r"^(L|R)_foot[1-7]_collision$": 1},
+  friction={r"^(L|R)_foot[1-7]_collision$": (0.6,)},
+)
+
+FULL_COLLISION_WITHOUT_SELF = CollisionCfg(
+  geom_names_expr=(".*_collision",),
+  contype=0,
+  conaffinity=1,
+  condim={r"^(L|R)_foot[1-7]_collision$": 3, ".*_collision": 1},
+  priority={r"^(L|R)_foot[1-7]_collision$": 1},
+  friction={r"^(L|R)_foot[1-7]_collision$": (0.6,)},
+)
+
+# This disables all collisions except the feet.
+# Feet get condim=3, all other geoms are disabled.
+FEET_ONLY_COLLISION = CollisionCfg(
+  geom_names_expr=(r"^(L|R)_foot[1-7]_collision$",),
+  contype=0,
+  conaffinity=1,
+  condim=3,
+  priority=1,
+  friction=(0.6,),
+)
+
+##
+# Final config.
+##
+
+PYG_ARTICULATION = EntityArticulationInfoCfg(
+  actuators=(
+    *((PYG_ACTUATOR_04_WAIST, PYG_ACTUATOR_03_SHOULDER) if _UPPER_DOF else ()),
+    # loop: the two ankle hinges are passive, the four cranks are the ankle motors
+    *(
+      (PYG_ACTUATOR_03_CRANK,)
+      if _ANKLE_LOOP
+      else (PYG_ACTUATOR_ANKLE_RP,)
+      if _ANKLE_RP
+      else (PYG_ACTUATOR_00, PYG_ACTUATOR_03_ANKLE)
+    ),
+    PYG_ACTUATOR_03_HIP_YAW,
+    PYG_ACTUATOR_04,
+    PYG_ACTUATOR_04_KNEES,
+  ),
+  soft_joint_pos_limit_factor=0.9,
+)
+
+
+def safe_target_clip() -> dict[str, tuple[float, float]]:
+  """PYG_SAFE_TARGET_CLIP bounds: the centered soft-limit envelope, PER JOINT.
+
+  Same arithmetic as ``Entity``'s ``soft_joint_pos_limits`` (centre +- factor/2 x range),
+  so the clamp the policy's target passes through and the clamp the simulator enforces are
+  one contract, and the deployment runtime has an exact rule to copy.
+
+  Deriving it per joint instead of per regex is the whole point: the hardcoded table this
+  replaces had ONE knee tuple, (-114, -6) deg, which is the correct 90 % envelope of a
+  [-120, 0] knee and has NO overlap at all with v30's [0, +120] left knee.  Every value
+  produced here for a v2/v3/v4 model is bit-for-bit the number that used to be typed in
+  (hip_pitch -112.75/17.75, hip_roll -79.5/19.5, hip_yaw +-40.5, knee -114/-6, crank
+  +-61.8795, ankle_pitch -46/26, ankle_roll +-18 deg).
+
+  Only ACTUATED joints are listed: the loop build's passive ankle/rod hinges are not action
+  targets, and ``resolve_matching_names_values`` rejects a clip key that matches none.
+  """
+  factor = PYG_ARTICULATION.soft_joint_pos_limit_factor
+  names = tuple(PYG_JOINT_RANGE)
+  clip: dict[str, tuple[float, float]] = {}
+  for act in PYG_ARTICULATION.actuators:
+    for name in filter_exp(list(act.target_names_expr), names):
+      lo, hi = PYG_JOINT_RANGE[name]
+      centre, half = (lo + hi) / 2, (hi - lo) / 2 * factor
+      clip[name] = (centre - half, centre + half)
+  return clip
+
+
+def get_pygmalion_robot_cfg() -> EntityCfg:
+  """Get a fresh Pygmalion robot configuration instance.
+
+  Returns a new EntityCfg instance each time to avoid mutation issues when
+  the config is shared across multiple places.
+  """
+  return EntityCfg(
+    # 2026-07-06 (user): straight-knee default. HOME = all joints 0deg (knee 0
+    # = no bend), vs KNEES_BENT (knee -0.67 = -38deg crouch). The pose reward
+    # targets default_joint_pos, so this also makes the STANDING target straight
+    # (knee won't re-bend at rest). Knee hyperextension already hard-capped at
+    # +10deg (+0.1745 rad range) in the MJCF -> reverse-joint protected.
+    init_state=_INIT_STATE,
+    collisions=(FULL_COLLISION,),
+    spec_fn=get_spec,
+    articulation=PYG_ARTICULATION,
+  )
+
+
+PYG_ACTION_SCALE: dict[str, float] = {}
+for a in PYG_ARTICULATION.actuators:
+  assert isinstance(
+    a, (BuiltinPositionActuatorCfg, AnkleRpActuatorCfg, TnPdActuatorCfg)
+  )
+  for n in a.target_names_expr:
+    # Flat 0.25 rad per unit action -- the standard locomotion action scale
+    # (IsaacLab G1 / Unitree). The previous 0.25*effort/stiffness gave 0.8-1.8,
+    # far too hot: a policy output of 1.0 commanded up to ~1.8 rad (>100 deg)
+    # of joint deflection -> over-aggressive motion, inflated torque demand, and
+    # a large command-vs-actual gap. 2026-07-02 (dongyeop action_scale finding).
+    PYG_ACTION_SCALE[n] = 0.25
+
+
+if __name__ == "__main__":
+  import mujoco.viewer as viewer
+
+  from mjlab.entity.entity import Entity
+
+  robot = Entity(get_pygmalion_robot_cfg())
