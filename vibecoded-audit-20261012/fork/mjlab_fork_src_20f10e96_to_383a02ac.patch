+    self.actual_ang_vel_sum = torch.zeros(num_scenarios)
+    self.base_height_min = torch.full((num_scenarios,), float("inf"))
+
+    self.joint_pos_abs_sum = torch.zeros(num_scenarios, j)
+    self.joint_pos_sq_sum = torch.zeros(num_scenarios, j)
+    self.joint_pos_abs_max = torch.zeros(num_scenarios, j)
+    self.joint_vel_abs_sum = torch.zeros(num_scenarios, j)
+    self.joint_vel_sq_sum = torch.zeros(num_scenarios, j)
+    self.joint_vel_abs_max = torch.zeros(num_scenarios, j)
+    self.joint_acc_abs_sum = torch.zeros(num_scenarios, j)
+    self.joint_acc_sq_sum = torch.zeros(num_scenarios, j)
+    self.joint_acc_abs_max = torch.zeros(num_scenarios, j)
+
+    self.tau_cmd_abs_sum = torch.zeros(num_scenarios, a)
+    self.tau_cmd_sq_sum = torch.zeros(num_scenarios, a)
+    self.tau_cmd_abs_max = torch.zeros(num_scenarios, a)
+    self.actuator_force_abs_sum = torch.zeros(num_scenarios, a)
+    self.actuator_force_sq_sum = torch.zeros(num_scenarios, a)
+    self.actuator_force_abs_max = torch.zeros(num_scenarios, a)
+    self.qfrc_actuator_abs_sum = torch.zeros(num_scenarios, a)
+    self.qfrc_actuator_sq_sum = torch.zeros(num_scenarios, a)
+    self.qfrc_actuator_abs_max = torch.zeros(num_scenarios, a)
+    self.torque_saturation_count = torch.zeros(num_scenarios, a)
+    self.torque_soft_limit_count = torch.zeros(num_scenarios, a)
+    self.power_abs_sum = torch.zeros(num_scenarios, a)
+    self.power_abs_max = torch.zeros(num_scenarios, a)
+
+    self.contact_count = torch.zeros(num_scenarios, f)
+    self.contact_force_sum = torch.zeros(num_scenarios, f)
+    self.contact_force_sq_sum = torch.zeros(num_scenarios, f)
+    self.contact_force_max = torch.zeros(num_scenarios, f)
+    self.contact_force_norm_sum = torch.zeros(num_scenarios, f)
+    self.contact_force_norm_max = torch.zeros(num_scenarios, f)
+    self.contact_impulse_sum = torch.zeros(num_scenarios, f)
+    self.contact_impulse_norm_sum = torch.zeros(num_scenarios, f)
+    self.loading_rate_max = torch.zeros(num_scenarios, f)
+    self.loading_rate_norm_max = torch.zeros(num_scenarios, f)
+    self.landing_count = torch.zeros(num_scenarios, f)
+    self.landing_force_sum = torch.zeros(num_scenarios, f)
+    self.landing_force_max = torch.zeros(num_scenarios, f)
+    self.landing_force_norm_sum = torch.zeros(num_scenarios, f)
+    self.landing_force_norm_max = torch.zeros(num_scenarios, f)
+    self.landing_loading_rate_max = torch.zeros(num_scenarios, f)
+    self.landing_loading_rate_norm_max = torch.zeros(num_scenarios, f)
+    self.slip_speed_sum = torch.zeros(num_scenarios, f)
+    self.slip_speed_sq_sum = torch.zeros(num_scenarios, f)
+    self.slip_speed_max = torch.zeros(num_scenarios, f)
+    self.slip_distance_sum = torch.zeros(num_scenarios, f)
+    self.slip_over_threshold_count = torch.zeros(num_scenarios, f)
+
+    self.cfrc_int_wrench_sum = torch.zeros(num_scenarios, b)
+    self.cfrc_int_wrench_max = torch.zeros(num_scenarios, b)
+    self.cfrc_int_force_sum = torch.zeros(num_scenarios, b)
+    self.cfrc_int_force_max = torch.zeros(num_scenarios, b)
+    self.cfrc_int_torque_sum = torch.zeros(num_scenarios, b)
+    self.cfrc_int_torque_max = torch.zeros(num_scenarios, b)
+    self.cfrc_ext_wrench_sum = torch.zeros(num_scenarios, b)
+    self.cfrc_ext_wrench_max = torch.zeros(num_scenarios, b)
+    self.cfrc_ext_force_sum = torch.zeros(num_scenarios, b)
+    self.cfrc_ext_force_max = torch.zeros(num_scenarios, b)
+    self.cfrc_ext_torque_sum = torch.zeros(num_scenarios, b)
+    self.cfrc_ext_torque_max = torch.zeros(num_scenarios, b)
+
+  def merge(
+    self,
+    chunk: ChunkMetricAccumulator,
+    *,
+    success: torch.Tensor,
+    failed: torch.Tensor,
+    failure_reasons: dict[str, torch.Tensor],
+  ) -> None:
+    """Merge one completed chunk."""
+    scenario_ids = chunk.scenario_ids.cpu()
+    success_cpu = success.cpu()
+    failed_cpu = failed.cpu()
+    for scenario_id in range(self.num_scenarios):
+      scenario_mask = scenario_ids == scenario_id
+      self.episodes[scenario_id] += scenario_mask.sum()
+      self.successes[scenario_id] += (scenario_mask & success_cpu).sum()
+      self.failures[scenario_id] += (scenario_mask & failed_cpu).sum()
+      merge_mask = scenario_mask.to(chunk.device) & success
+      if not merge_mask.any():
+        continue
+      self._merge_successful_envs(chunk, scenario_id, merge_mask)
+
+    for reason, values in failure_reasons.items():
+      if reason not in self.failure_reasons:
+        self.failure_reasons[reason] = torch.zeros(self.num_scenarios)
+      values_cpu = values.cpu()
+      for scenario_id in range(self.num_scenarios):
+        scenario_mask = scenario_ids == scenario_id
+        self.failure_reasons[reason][scenario_id] += (
+          values_cpu & scenario_mask & failed_cpu
+        ).sum()
+
+    self.samples.tau_cmd.extend(chunk.samples.tau_cmd)
+    self.samples.actuator_force.extend(chunk.samples.actuator_force)
+    self.samples.qvel.extend(chunk.samples.qvel)
+    self.samples.actuator_index.extend(chunk.samples.actuator_index)
+    self.samples.scenario_index.extend(chunk.samples.scenario_index)
+    self.samples._count += chunk.samples._count
+
+  def _merge_successful_envs(
+    self, chunk: ChunkMetricAccumulator, scenario_id: int, mask: torch.Tensor
+  ) -> None:
+    mask_f = mask.float()
+    count = chunk.count[mask].sum().cpu()
+    self.measured_count[scenario_id] += count
+    self.tracking_lin_error_sum[scenario_id] += (
+      chunk.tracking_lin_error_sum[mask].sum().cpu()
+    )
+    self.tracking_lin_error_sq_sum[scenario_id] += (
+      chunk.tracking_lin_error_sq_sum[mask].sum().cpu()
+    )
+    self.tracking_lin_error_max[scenario_id] = torch.maximum(
+      self.tracking_lin_error_max[scenario_id],
+      chunk.tracking_lin_error_max[mask].max().cpu(),
+    )
+    self.tracking_ang_error_sum[scenario_id] += (
+      chunk.tracking_ang_error_sum[mask].sum().cpu()
+    )
+    self.tracking_ang_error_sq_sum[scenario_id] += (
+      chunk.tracking_ang_error_sq_sum[mask].sum().cpu()
+    )
+    self.tracking_ang_error_max[scenario_id] = torch.maximum(
+      self.tracking_ang_error_max[scenario_id],
+      chunk.tracking_ang_error_max[mask].max().cpu(),
+    )
+    self.actual_lin_vel_sum[scenario_id] += (
+      chunk.actual_lin_vel_sum[mask].sum(dim=0).cpu()
+    )
+    self.actual_ang_vel_sum[scenario_id] += chunk.actual_ang_vel_sum[mask].sum().cpu()
+    self.base_height_min[scenario_id] = torch.minimum(
+      self.base_height_min[scenario_id], chunk.base_height_min[mask].min().cpu()
+    )
+
+    self._merge_sum_sq_max(
+      scenario_id,
+      mask,
+      chunk.joint_pos_abs_sum,
+      self.joint_pos_abs_sum,
+      chunk.joint_pos_sq_sum,
+      self.joint_pos_sq_sum,
+      chunk.joint_pos_abs_max,
+      self.joint_pos_abs_max,
+    )
+    self._merge_sum_sq_max(
+      scenario_id,
+      mask,
+      chunk.joint_vel_abs_sum,
+      self.joint_vel_abs_sum,
+      chunk.joint_vel_sq_sum,
+      self.joint_vel_sq_sum,
+      chunk.joint_vel_abs_max,
+      self.joint_vel_abs_max,
+    )
+    self._merge_sum_sq_max(
+      scenario_id,
+      mask,
+      chunk.joint_acc_abs_sum,
+      self.joint_acc_abs_sum,
+      chunk.joint_acc_sq_sum,
+      self.joint_acc_sq_sum,
+      chunk.joint_acc_abs_max,
+      self.joint_acc_abs_max,
+    )
+    self._merge_sum_sq_max(
+      scenario_id,
+      mask,
+      chunk.tau_cmd_abs_sum,
+      self.tau_cmd_abs_sum,
+      chunk.tau_cmd_sq_sum,
+      self.tau_cmd_sq_sum,
+      chunk.tau_cmd_abs_max,
+      self.tau_cmd_abs_max,
+    )
+    self._merge_sum_sq_max(
+      scenario_id,
+      mask,
+      chunk.actuator_force_abs_sum,
+      self.actuator_force_abs_sum,
+      chunk.actuator_force_sq_sum,
+      self.actuator_force_sq_sum,
+      chunk.actuator_force_abs_max,
+      self.actuator_force_abs_max,
+    )
+    self._merge_sum_sq_max(
+      scenario_id,
+      mask,
+      chunk.qfrc_actuator_abs_sum,
+      self.qfrc_actuator_abs_sum,
+      chunk.qfrc_actuator_sq_sum,
+      self.qfrc_actuator_sq_sum,
+      chunk.qfrc_actuator_abs_max,
+      self.qfrc_actuator_abs_max,
+    )
+
+    self.torque_saturation_count[scenario_id] += (
+      chunk.torque_saturation_count[mask].sum(dim=0).cpu()
+    )
+    self.torque_soft_limit_count[scenario_id] += (
+      chunk.torque_soft_limit_count[mask].sum(dim=0).cpu()
+    )
+    self.power_abs_sum[scenario_id] += chunk.power_abs_sum[mask].sum(dim=0).cpu()
+    self.power_abs_max[scenario_id] = torch.maximum(
+      self.power_abs_max[scenario_id], chunk.power_abs_max[mask].max(dim=0).values.cpu()
+    )
+
+    for src_name, dst_name in _SUM_ONLY_FIELDS:
+      src = getattr(chunk, src_name)
+      dst = getattr(self, dst_name)
+      dst[scenario_id] += src[mask].sum(dim=0).cpu()
+    for src_name, dst_name in _MAX_FIELDS:
+      src = getattr(chunk, src_name)
+      dst = getattr(self, dst_name)
+      dst[scenario_id] = torch.maximum(
+        dst[scenario_id], src[mask].max(dim=0).values.cpu()
+      )
+    del mask_f
+
+  def _merge_sum_sq_max(
+    self,
+    scenario_id: int,
+    mask: torch.Tensor,
+    src_sum: torch.Tensor,
+    dst_sum: torch.Tensor,
+    src_sq: torch.Tensor,
+    dst_sq: torch.Tensor,
+    src_max: torch.Tensor,
+    dst_max: torch.Tensor,
+  ) -> None:
+    dst_sum[scenario_id] += src_sum[mask].sum(dim=0).cpu()
+    dst_sq[scenario_id] += src_sq[mask].sum(dim=0).cpu()
+    dst_max[scenario_id] = torch.maximum(
+      dst_max[scenario_id], src_max[mask].max(dim=0).values.cpu()
+    )
+
+  def to_summary(self) -> dict[str, Any]:
+    """Return raw aggregate tensors as JSON-friendly lists."""
+    fields: dict[str, Any] = {
+      name: value.tolist()
+      for name, value in self.__dict__.items()
+      if isinstance(value, torch.Tensor)
+    }
+    fields["failure_reasons"] = {
+      name: value.tolist() for name, value in self.failure_reasons.items()
+    }
+    fields["names"] = {
+      "joint_names": list(self.names.joint_names),
+      "actuator_names": list(self.names.actuator_names),
+      "body_names": list(self.names.body_names),
+      "foot_names": list(self.names.foot_names),
+    }
+    return fields
+
+
+_SUM_ONLY_FIELDS = (
+  ("contact_count", "contact_count"),
+  ("contact_force_sum", "contact_force_sum"),
+  ("contact_force_sq_sum", "contact_force_sq_sum"),
+  ("contact_force_norm_sum", "contact_force_norm_sum"),
+  ("contact_impulse_sum", "contact_impulse_sum"),
+  ("contact_impulse_norm_sum", "contact_impulse_norm_sum"),
+  ("landing_count", "landing_count"),
+  ("landing_force_sum", "landing_force_sum"),
+  ("landing_force_norm_sum", "landing_force_norm_sum"),
+  ("slip_speed_sum", "slip_speed_sum"),
+  ("slip_speed_sq_sum", "slip_speed_sq_sum"),
+  ("slip_distance_sum", "slip_distance_sum"),
+  ("slip_over_threshold_count", "slip_over_threshold_count"),
+  ("cfrc_int_wrench_sum", "cfrc_int_wrench_sum"),
+  ("cfrc_int_force_sum", "cfrc_int_force_sum"),
+  ("cfrc_int_torque_sum", "cfrc_int_torque_sum"),
+  ("cfrc_ext_wrench_sum", "cfrc_ext_wrench_sum"),
+  ("cfrc_ext_force_sum", "cfrc_ext_force_sum"),
+  ("cfrc_ext_torque_sum", "cfrc_ext_torque_sum"),
+)
+
+_MAX_FIELDS = (
+  ("contact_force_max", "contact_force_max"),
+  ("contact_force_norm_max", "contact_force_norm_max"),
+  ("loading_rate_max", "loading_rate_max"),
+  ("loading_rate_norm_max", "loading_rate_norm_max"),
+  ("landing_force_max", "landing_force_max"),
+  ("landing_force_norm_max", "landing_force_norm_max"),
+  ("landing_loading_rate_max", "landing_loading_rate_max"),
+  ("landing_loading_rate_norm_max", "landing_loading_rate_norm_max"),
+  ("slip_speed_max", "slip_speed_max"),
+  ("cfrc_int_wrench_max", "cfrc_int_wrench_max"),
+  ("cfrc_int_force_max", "cfrc_int_force_max"),
+  ("cfrc_int_torque_max", "cfrc_int_torque_max"),
+  ("cfrc_ext_wrench_max", "cfrc_ext_wrench_max"),
+  ("cfrc_ext_force_max", "cfrc_ext_force_max"),
+  ("cfrc_ext_torque_max", "cfrc_ext_torque_max"),
+)
