@@ -0,0 +1,333 @@
+"""Evaluate a trained velocity policy across fixed command scenarios."""
+
+from __future__ import annotations
+
+import math
+import sys
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import cast
+
+import torch
+import tyro
+
+from mjlab.envs import ManagerBasedRlEnv, ManagerBasedRlEnvCfg
+from mjlab.rl import MjlabOnPolicyRunner, RslRlVecEnvWrapper
+from mjlab.tasks.registry import load_env_cfg, load_rl_cfg, load_runner_cls
+from mjlab.tasks.velocity.evaluation.config import VelocityEvalConfig
+from mjlab.tasks.velocity.evaluation.metrics import (
+  ChunkMetricAccumulator,
+  GlobalMetricAccumulator,
+  MetricNames,
+)
+from mjlab.tasks.velocity.evaluation.outputs import write_evaluation_outputs
+from mjlab.tasks.velocity.evaluation.raw import RawScenarioRecorder
+from mjlab.tasks.velocity.evaluation.report import collect_model_audit
+from mjlab.tasks.velocity.evaluation.scenarios import (
+  VelocityCommandScenario,
+  build_command_scenarios,
+)
+from mjlab.tasks.velocity.mdp import UniformVelocityCommand, UniformVelocityCommandCfg
+from mjlab.utils.torch import configure_torch_backends
+
+
+@dataclass(frozen=True)
+class EvaluateCliArgs:
+  """CLI arguments for velocity evaluation."""
+
+  config_file: str | None = None
+  """Optional JSON/YAML config. Defaults evaluate Pygmalion model_30000."""
+
+
+def run_evaluate(cfg: VelocityEvalConfig) -> dict:
+  """Run the velocity evaluation sweep."""
+  configure_torch_backends()
+  checkpoint = Path(cfg.checkpoint)
+  if not checkpoint.exists():
+    raise FileNotFoundError(f"Checkpoint not found: {checkpoint}")
+  if cfg.envs_per_command <= 0:
+    raise ValueError("envs_per_command must be positive.")
+  if cfg.max_parallel_envs <= 0:
+    raise ValueError("max_parallel_envs must be positive.")
+
+  device = cfg.device or ("cuda:0" if torch.cuda.is_available() else "cpu")
+  scenarios = build_command_scenarios(cfg.commands)
+  total_episodes = len(scenarios) * cfg.envs_per_command
+  output_root = cfg.resolved_output_root()
+  agent_cfg = load_rl_cfg(cfg.task_id)
+  runner_cls = load_runner_cls(cfg.task_id) or MjlabOnPolicyRunner
+
+  print(
+    f"[INFO] Evaluating {checkpoint} on {len(scenarios)} command scenarios "
+    f"({total_episodes} total episodes, {cfg.envs_per_command} per command)."
+  )
+  print(f"[INFO] Output root: {output_root}")
+
+  global_metrics: GlobalMetricAccumulator | None = None
+  model_audit: dict | None = None
+  raw_files_by_scenario: dict[str, list[Path]] = {s.name: [] for s in scenarios}
+
+  for scenario_index, scenario in enumerate(scenarios):
+    scenario_dir = output_root / scenario.name
+    processed = 0
+    chunk_index = 0
+    print(
+      f"[INFO] Scenario {scenario_index + 1}/{len(scenarios)}: "
+      f"{scenario.name} command={scenario.command}"
+    )
+    while processed < cfg.envs_per_command:
+      chunk_size = min(cfg.max_parallel_envs, cfg.envs_per_command - processed)
+      next_processed = processed + chunk_size
+      print(
+        f"[INFO]   chunk {chunk_index}: episodes {processed}-"
+        f"{next_processed - 1} ({chunk_size} envs)"
+      )
+      chunk_scenario_ids = torch.full(
+        (chunk_size,), scenario_index, device=device, dtype=torch.long
+      )
+      wrapped: RslRlVecEnvWrapper | None = None
+      try:
+        env_cfg = make_eval_env_cfg(cfg, num_envs=chunk_size, scenarios=scenarios)
+        env = ManagerBasedRlEnv(cfg=env_cfg, device=device)
+        wrapped = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
+        runner = runner_cls(wrapped, asdict(agent_cfg), device=device)
+        runner.load(
+          str(checkpoint),
+          load_cfg={"actor": True},
+          strict=True,
+          map_location=device,
+        )
+        policy = runner.get_inference_policy(device=device)
+
+        command_tensor = _commands_for_chunk(scenarios, chunk_scenario_ids, device)
+        _set_fixed_commands(wrapped.unwrapped, command_tensor)
+        chunk_metrics = ChunkMetricAccumulator(
+          wrapped.unwrapped,
+          chunk_scenario_ids,
+          slip_speed_threshold=cfg.slip_speed_threshold,
+          plot_sample_limit=cfg.plot_sample_limit,
+          plot_sample_stride=cfg.plot_sample_stride,
+        )
+        if global_metrics is None:
+          global_metrics = GlobalMetricAccumulator(
+            len(scenarios),
+            MetricNames(
+              joint_names=chunk_metrics.names.joint_names,
+              actuator_names=chunk_metrics.names.actuator_names,
+              body_names=chunk_metrics.names.body_names,
+              foot_names=chunk_metrics.names.foot_names,
+            ),
+          )
+          model_audit = collect_model_audit(wrapped.unwrapped)
+
+        warmup_steps = int(math.ceil(cfg.warmup_s / wrapped.unwrapped.step_dt))
+        raw_recorder = RawScenarioRecorder(
+          wrapped.unwrapped,
+          chunk_metrics,
+          scenario,
+          command_tensor[0],
+          max_steps=wrapped.unwrapped.max_episode_length,
+          warmup_steps=warmup_steps,
+          save_cfrc_components=cfg.save_raw_cfrc_components,
+        )
+        success, failed, failure_reasons = _rollout_chunk(
+          wrapped,
+          policy,
+          chunk_metrics,
+          command_tensor,
+          cfg,
+          raw_recorder=raw_recorder,
+        )
+        raw_name = (
+          "raw.npz"
+          if cfg.envs_per_command <= cfg.max_parallel_envs
+          else f"raw_chunk_{chunk_index:03d}.npz"
+        )
+        raw_path = scenario_dir / raw_name
+        raw_recorder.save(
+          raw_path,
+          success=success,
+          failed=failed,
+          failure_reasons=failure_reasons,
+        )
+        raw_files_by_scenario[scenario.name].append(raw_path)
+        global_metrics.merge(
+          chunk_metrics,
+          success=success,
+          failed=failed,
+          failure_reasons=failure_reasons,
+        )
+      finally:
+        if wrapped is not None:
+          wrapped.close()
+
+      processed = next_processed
+      chunk_index += 1
+
+  assert global_metrics is not None
+  assert model_audit is not None
+  summary = write_evaluation_outputs(
+    cfg=cfg,
+    scenarios=scenarios,
+    metrics=global_metrics,
+    model_audit=model_audit,
+    output_root=output_root,
+    raw_files_by_scenario=raw_files_by_scenario,
+  )
+  print(f"[INFO] Summary written to {output_root / 'summary.json'}")
+  return summary
+
+
+def make_eval_env_cfg(
+  cfg: VelocityEvalConfig,
+  *,
+  num_envs: int,
+  scenarios: list[VelocityCommandScenario],
+) -> ManagerBasedRlEnvCfg:
+  """Build an evaluation-specific env config from the task registry config."""
+  env_cfg = load_env_cfg(cfg.task_id, play=False)
+  env_cfg.scene.num_envs = num_envs
+  env_cfg.episode_length_s = cfg.episode_length_s
+  env_cfg.curriculum = {}
+  env_cfg.auto_reset = True
+
+  if "actor" in env_cfg.observations:
+    env_cfg.observations["actor"].enable_corruption = cfg.disturbances.observation_noise
+  if not cfg.disturbances.push_robot:
+    env_cfg.events.pop("push_robot", None)
+  if not cfg.disturbances.domain_randomization:
+    for event_name in ("foot_friction", "encoder_bias", "base_com"):
+      env_cfg.events.pop(event_name, None)
+
+  twist_cfg = env_cfg.commands.get("twist")
+  if not isinstance(twist_cfg, UniformVelocityCommandCfg):
+    raise ValueError(f"Task {cfg.task_id} does not expose a velocity `twist` command.")
+  max_lin = max(
+    (max(abs(s.lin_vel_x), abs(s.lin_vel_y)) for s in scenarios), default=0.0
+  )
+  max_ang = max((abs(s.ang_vel_z) for s in scenarios), default=0.0)
+  twist_cfg.heading_command = False
+  twist_cfg.ranges.heading = None
+  twist_cfg.rel_standing_envs = 0.0
+  twist_cfg.rel_heading_envs = 0.0
+  twist_cfg.rel_world_envs = 0.0
+  twist_cfg.rel_forward_envs = 0.0
+  twist_cfg.init_velocity_prob = 0.0
+  twist_cfg.resampling_time_range = (
+    cfg.episode_length_s + cfg.warmup_s + 10.0,
+    cfg.episode_length_s + cfg.warmup_s + 10.0,
+  )
+  twist_cfg.ranges.lin_vel_x = (-max_lin, max_lin)
+  twist_cfg.ranges.lin_vel_y = (-max_lin, max_lin)
+  twist_cfg.ranges.ang_vel_z = (-max_ang, max_ang)
+  return env_cfg
+
+
+def _rollout_chunk(
+  env: RslRlVecEnvWrapper,
+  policy,
+  metrics: ChunkMetricAccumulator,
+  command_tensor: torch.Tensor,
+  cfg: VelocityEvalConfig,
+  *,
+  raw_recorder: RawScenarioRecorder | None = None,
+) -> tuple[torch.Tensor, torch.Tensor, dict[str, torch.Tensor]]:
+  unwrapped = env.unwrapped
+  max_steps = unwrapped.max_episode_length
+  warmup_steps = int(math.ceil(cfg.warmup_s / unwrapped.step_dt))
+  done = torch.zeros(env.num_envs, dtype=torch.bool, device=unwrapped.device)
+  success = torch.zeros_like(done)
+  failed = torch.zeros_like(done)
+  failure_reasons = {
+    name: torch.zeros_like(done) for name in unwrapped.termination_manager.active_terms
+  }
+  failure_reasons["early_done"] = torch.zeros_like(done)
+
+  obs = env.get_observations()
+  for step in range(max_steps):
+    active = ~done
+    measured = active & (step >= warmup_steps)
+    if raw_recorder is not None:
+      raw_recorder.record(step, active=active, measured=measured)
+    metrics.update(active=measured, command=command_tensor, step_index=step)
+    _set_fixed_commands(unwrapped, command_tensor)
+    with torch.no_grad():
+      actions = policy(obs)
+    obs, _, dones, _ = env.step(actions)
+    _set_fixed_commands(unwrapped, command_tensor)
+
+    newly_done = dones.bool() & ~done
+    if newly_done.any():
+      terminated = unwrapped.termination_manager.terminated.clone()
+      timed_out = unwrapped.termination_manager.time_outs.clone()
+      failed_this_step = newly_done & (terminated | (step < max_steps - 1))
+      success_this_step = newly_done & timed_out & ~failed_this_step
+      failed |= failed_this_step
+      success |= success_this_step
+      done |= newly_done
+      for reason in unwrapped.termination_manager.active_terms:
+        failure_reasons[reason] |= (
+          unwrapped.termination_manager.get_term(reason).clone() & failed_this_step
+        )
+      failure_reasons["early_done"] |= failed_this_step & ~_any_reason(
+        failure_reasons, failed_this_step
+      )
+
+    if done.all():
+      break
+
+  success |= ~done & ~failed
+  failed |= done & ~success
+  return success, failed, failure_reasons
+
+
+def _any_reason(
+  failure_reasons: dict[str, torch.Tensor], failed_this_step: torch.Tensor
+) -> torch.Tensor:
+  value = torch.zeros_like(failed_this_step)
+  for reason, reason_value in failure_reasons.items():
+    if reason == "early_done":
+      continue
+    value |= reason_value & failed_this_step
+  return value
+
+
+def _commands_for_chunk(
+  scenarios: list[VelocityCommandScenario],
+  scenario_ids: torch.Tensor,
+  device: str,
+) -> torch.Tensor:
+  commands = torch.tensor([s.command for s in scenarios], device=device)
+  return commands[scenario_ids]
+
+
+def _set_fixed_commands(env: ManagerBasedRlEnv, command_tensor: torch.Tensor) -> None:
+  command_term = cast(UniformVelocityCommand, env.command_manager.get_term("twist"))
+  command_term.vel_command_b[:] = command_tensor
+  command_term.vel_command_w[:] = command_tensor
+  command_term.heading_target[:] = 0.0
+  command_term.heading_error[:] = 0.0
+  command_term.is_heading_env[:] = False
+  command_term.is_standing_env[:] = False
+  command_term.is_world_env[:] = False
+  command_term.is_forward_env[:] = False
+
+
+def main() -> None:
+  import mjlab.tasks  # noqa: F401
+
+  args = tyro.cli(EvaluateCliArgs, config=mjlab.TYRO_FLAGS)
+  cfg = (
+    VelocityEvalConfig.from_file(args.config_file)
+    if args.config_file is not None
+    else VelocityEvalConfig()
+  )
+  try:
+    run_evaluate(cfg)
+  except KeyboardInterrupt:
+    print("\n[INFO] Evaluation interrupted.")
+    sys.exit(130)
+
+
+if __name__ == "__main__":
+  main()
