+def base_height_deadband(
+  env: ManagerBasedRlEnv,
+  target: float = 0.87,
+  deadband: float = 0.03,
+  asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+  """Penalise base height outside a deadband around ``target``.
+
+  mjlab inherited no height anchor at all (docs/62 un-ablated item 6), so nothing rewards
+  standing tall: the policy lands with the knee still at -30/-38 deg while a human touches
+  down near -5. A FIXED target is the wrong fix - it suppresses the vault a robot needs to
+  clear an obstacle - so this is quadratic only OUTSIDE +-deadband and exactly zero inside.
+  Research: docs/reward_research/2026-08-26_human_landing_bundle.md
+  """
+  asset: Entity = env.scene[asset_cfg.name]
+  h = asset.data.root_link_pos_w[:, 2]
+  excess = torch.clamp(torch.abs(h - target) - deadband, min=0.0)
+  env.extras["log"]["Metrics/base_height_mean"] = h.mean()
+  return excess**2
