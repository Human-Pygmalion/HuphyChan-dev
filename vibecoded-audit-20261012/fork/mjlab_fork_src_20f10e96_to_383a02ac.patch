+"""Regenerate plots for saved velocity evaluation outputs."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import tyro
+
+from mjlab.tasks.velocity.evaluation.config import VelocityEvalConfig
+from mjlab.tasks.velocity.evaluation.visualization import regenerate_plots_from_output
+
+
+@dataclass(frozen=True)
+class VisualizeEvalCliArgs:
+  """CLI arguments for velocity evaluation visualization."""
+
+  output_root: str = str(VelocityEvalConfig().resolved_output_root())
+  """Evaluation output root containing summary.json and scenario folders."""
+
+
+def main() -> None:
+  args = tyro.cli(VisualizeEvalCliArgs)
+  output_root = Path(args.output_root)
+  regenerate_plots_from_output(output_root)
+  print(f"[INFO] Plots regenerated under {output_root}")
+
+
+if __name__ == "__main__":
+  main()
