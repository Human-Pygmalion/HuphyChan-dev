+"""Report and plot generation for velocity evaluation."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import numpy as np
+import torch
+
+from mjlab.tasks.velocity.evaluation.metrics import GlobalMetricAccumulator
+from mjlab.tasks.velocity.evaluation.scenarios import VelocityCommandScenario
+
+if TYPE_CHECKING:
+  from mjlab.envs import ManagerBasedRlEnv
+
+
+def collect_model_audit(env: ManagerBasedRlEnv) -> dict[str, Any]:
+  """Collect compiled actuator constants used by the evaluator."""
+  robot = env.scene["robot"]
+  ctrl_ids = robot.indexing.ctrl_ids
+  model = env.sim.model
+  audit: dict[str, Any] = {
+    "joint_names": list(robot.joint_names),
+    "actuator_names": list(robot.actuator_names),
+    "body_names": list(robot.body_names),
+    "ctrl_ids": ctrl_ids.detach().cpu().tolist(),
+  }
+  for field in (
+    "actuator_gear",
+    "actuator_forcerange",
+    "actuator_gainprm",
+    "actuator_biasprm",
+  ):
+    value = getattr(model, field, None)
+    if value is not None:
+      audit[field] = _slice_model_field(value, ctrl_ids)
+    try:
+      default_value = env.sim.get_default_field(field)
+    except (AttributeError, KeyError):
+      default_value = None
+    if default_value is not None:
+      audit[f"default_{field}"] = _slice_model_field(default_value, ctrl_ids)
+
+  forcerange = env.sim.get_default_field("actuator_forcerange")[ctrl_ids]
+  effort_limit = torch.maximum(forcerange[:, 0].abs(), forcerange[:, 1].abs())
+  audit["effort_limit"] = effort_limit.detach().cpu().tolist()
+  return audit
+
+
+def build_scenario_summary(
+  metrics: GlobalMetricAccumulator,
+  scenario: VelocityCommandScenario,
+  index: int,
+) -> dict[str, Any]:
+  """Build a JSON-friendly summary for one command scenario."""
+  return _scenario_summary(metrics, scenario, index)
+
+
+def _scenario_summary(
+  metrics: GlobalMetricAccumulator,
+  scenario: VelocityCommandScenario,
+  index: int,
+) -> dict[str, Any]:
+  count = float(metrics.measured_count[index].item())
+  contact_count = metrics.contact_count[index]
+  landing_count = metrics.landing_count[index]
+  actuator_names = metrics.names.actuator_names
+  joint_names = metrics.names.joint_names
+  foot_names = metrics.names.foot_names
+  body_names = metrics.names.body_names
+  failure_reasons = {
+    name: int(values[index].item())
+    for name, values in metrics.failure_reasons.items()
+    if int(values[index].item()) > 0
+  }
+  return {
+    "name": scenario.name,
+    "kind": scenario.kind,
+    "command": {
+      "lin_vel_x": scenario.lin_vel_x,
+      "lin_vel_y": scenario.lin_vel_y,
+      "ang_vel_z": scenario.ang_vel_z,
+      "speed": scenario.speed,
+      "direction": scenario.direction,
+    },
+    "episodes": int(metrics.episodes[index].item()),
+    "successes": int(metrics.successes[index].item()),
+    "failures": int(metrics.failures[index].item()),
+    "success_rate": _safe_scalar(
+      metrics.successes[index].item(), metrics.episodes[index].item()
+    ),
+    "failure_reasons": failure_reasons,
+    "tracking": {
+      "linear_error_mean": _safe_scalar(
+        metrics.tracking_lin_error_sum[index].item(), count
+      ),
+      "linear_error_rms": _safe_sqrt_div(
+        metrics.tracking_lin_error_sq_sum[index].item(), count
+      ),
+      "linear_error_max": metrics.tracking_lin_error_max[index].item(),
+      "angular_error_mean": _safe_scalar(
+        metrics.tracking_ang_error_sum[index].item(), count
+      ),
+      "angular_error_rms": _safe_sqrt_div(
+        metrics.tracking_ang_error_sq_sum[index].item(), count
+      ),
+      "angular_error_max": metrics.tracking_ang_error_max[index].item(),
+      "actual_lin_vel_mean": _safe_vector(metrics.actual_lin_vel_sum[index], count),
+      "actual_ang_vel_mean": _safe_scalar(
+        metrics.actual_ang_vel_sum[index].item(), count
+      ),
+      "base_height_min": metrics.base_height_min[index].item(),
+    },
+    "joints": {
+      name: {
+        "pos_abs_mean": _safe_scalar(metrics.joint_pos_abs_sum[index, j].item(), count),
+        "pos_rms": _safe_sqrt_div(metrics.joint_pos_sq_sum[index, j].item(), count),
+        "pos_abs_max": metrics.joint_pos_abs_max[index, j].item(),
+        "vel_abs_mean": _safe_scalar(metrics.joint_vel_abs_sum[index, j].item(), count),
+        "vel_rms": _safe_sqrt_div(metrics.joint_vel_sq_sum[index, j].item(), count),
+        "vel_abs_max": metrics.joint_vel_abs_max[index, j].item(),
+        "acc_abs_mean": _safe_scalar(metrics.joint_acc_abs_sum[index, j].item(), count),
+        "acc_rms": _safe_sqrt_div(metrics.joint_acc_sq_sum[index, j].item(), count),
+        "acc_abs_max": metrics.joint_acc_abs_max[index, j].item(),
+      }
+      for j, name in enumerate(joint_names)
+    },
+    "actuators": {
+      name: {
+        "tau_cmd_abs_mean": _safe_scalar(
+          metrics.tau_cmd_abs_sum[index, a].item(), count
+        ),
+        "tau_cmd_rms": _safe_sqrt_div(metrics.tau_cmd_sq_sum[index, a].item(), count),
+        "tau_cmd_abs_max": metrics.tau_cmd_abs_max[index, a].item(),
+        "actuator_force_abs_mean": _safe_scalar(
+          metrics.actuator_force_abs_sum[index, a].item(), count
+        ),
+        "actuator_force_rms": _safe_sqrt_div(
+          metrics.actuator_force_sq_sum[index, a].item(), count
+        ),
+        "actuator_force_abs_max": metrics.actuator_force_abs_max[index, a].item(),
+        "qfrc_actuator_abs_mean": _safe_scalar(
+          metrics.qfrc_actuator_abs_sum[index, a].item(), count
+        ),
+        "qfrc_actuator_rms": _safe_sqrt_div(
+          metrics.qfrc_actuator_sq_sum[index, a].item(), count
+        ),
+        "qfrc_actuator_abs_max": metrics.qfrc_actuator_abs_max[index, a].item(),
+        "torque_saturation_fraction": _safe_scalar(
+          metrics.torque_saturation_count[index, a].item(), count
+        ),
+        "torque_soft_limit_fraction": _safe_scalar(
+          metrics.torque_soft_limit_count[index, a].item(), count
+        ),
+        "power_abs_mean": _safe_scalar(metrics.power_abs_sum[index, a].item(), count),
+        "power_abs_max": metrics.power_abs_max[index, a].item(),
+      }
+      for a, name in enumerate(actuator_names)
+    },
+    "feet": {
+      name: {
+        "contact_samples": int(contact_count[f].item()),
+        "contact_force_mean": _safe_scalar(
+          metrics.contact_force_sum[index, f].item(), contact_count[f].item()
+        ),
+        "contact_force_rms": _safe_sqrt_div(
+          metrics.contact_force_sq_sum[index, f].item(), contact_count[f].item()
+        ),
+        "contact_force_max": metrics.contact_force_max[index, f].item(),
+        "contact_force_normalized_mean": _safe_scalar(
+          metrics.contact_force_norm_sum[index, f].item(), contact_count[f].item()
+        ),
+        "contact_force_normalized_max": metrics.contact_force_norm_max[index, f].item(),
+        "impulse_sum": metrics.contact_impulse_sum[index, f].item(),
+        "impulse_normalized_sum": metrics.contact_impulse_norm_sum[index, f].item(),
+        "loading_rate_max": metrics.loading_rate_max[index, f].item(),
+        "loading_rate_normalized_max": metrics.loading_rate_norm_max[index, f].item(),
+        "landing_count": int(landing_count[f].item()),
+        "landing_force_mean": _safe_scalar(
+          metrics.landing_force_sum[index, f].item(), landing_count[f].item()
+        ),
+        "landing_force_max": metrics.landing_force_max[index, f].item(),
+        "landing_force_normalized_mean": _safe_scalar(
+          metrics.landing_force_norm_sum[index, f].item(), landing_count[f].item()
+        ),
+        "landing_force_normalized_max": metrics.landing_force_norm_max[index, f].item(),
+        "landing_loading_rate_max": metrics.landing_loading_rate_max[index, f].item(),
+        "landing_loading_rate_normalized_max": metrics.landing_loading_rate_norm_max[
+          index, f
+        ].item(),
+        "slip_speed_mean": _safe_scalar(
+          metrics.slip_speed_sum[index, f].item(), contact_count[f].item()
+        ),
+        "slip_speed_rms": _safe_sqrt_div(
+          metrics.slip_speed_sq_sum[index, f].item(), contact_count[f].item()
+        ),
+        "slip_speed_max": metrics.slip_speed_max[index, f].item(),
+        "slip_distance_sum": metrics.slip_distance_sum[index, f].item(),
+        "slip_over_threshold_fraction": _safe_scalar(
+          metrics.slip_over_threshold_count[index, f].item(), contact_count[f].item()
+        ),
+      }
+      for f, name in enumerate(foot_names)
+    },
+    "links": {
+      name: {
+        "cfrc_int_wrench_mean": _safe_scalar(
+          metrics.cfrc_int_wrench_sum[index, b].item(), count
+        ),
+        "cfrc_int_wrench_max": metrics.cfrc_int_wrench_max[index, b].item(),
+        "cfrc_int_force_mean": _safe_scalar(
+          metrics.cfrc_int_force_sum[index, b].item(), count
+        ),
+        "cfrc_int_force_max": metrics.cfrc_int_force_max[index, b].item(),
+        "cfrc_int_torque_mean": _safe_scalar(
+          metrics.cfrc_int_torque_sum[index, b].item(), count
+        ),
+        "cfrc_int_torque_max": metrics.cfrc_int_torque_max[index, b].item(),
+        "cfrc_ext_wrench_mean": _safe_scalar(
+          metrics.cfrc_ext_wrench_sum[index, b].item(), count
+        ),
+        "cfrc_ext_wrench_max": metrics.cfrc_ext_wrench_max[index, b].item(),
+        "cfrc_ext_force_mean": _safe_scalar(
+          metrics.cfrc_ext_force_sum[index, b].item(), count
+        ),
+        "cfrc_ext_force_max": metrics.cfrc_ext_force_max[index, b].item(),
+        "cfrc_ext_torque_mean": _safe_scalar(
+          metrics.cfrc_ext_torque_sum[index, b].item(), count
+        ),
+        "cfrc_ext_torque_max": metrics.cfrc_ext_torque_max[index, b].item(),
+      }
+      for b, name in enumerate(body_names)
+    },
+  }
+
+
+def _slice_model_field(value: torch.Tensor, ctrl_ids: torch.Tensor) -> list[Any]:
+  if value.ndim == 1:
+    sliced = value[ctrl_ids]
+  elif value.ndim == 2:
+    sliced = value[ctrl_ids]
+  else:
+    sliced = value[0, ctrl_ids]
+  return sliced.detach().cpu().tolist()
+
+
+def _safe_scalar(numerator: float, denominator: float) -> float:
+  if denominator <= 0.0:
+    return 0.0
+  return float(numerator / denominator)
+
+
+def _safe_sqrt_div(numerator: float, denominator: float) -> float:
+  if denominator <= 0.0:
+    return 0.0
+  return float(np.sqrt(max(0.0, numerator / denominator)))
+
+
+def _safe_vector(value: torch.Tensor, denominator: float) -> list[float]:
+  if denominator <= 0.0:
+    return [0.0 for _ in range(value.numel())]
+  return (value / denominator).tolist()
