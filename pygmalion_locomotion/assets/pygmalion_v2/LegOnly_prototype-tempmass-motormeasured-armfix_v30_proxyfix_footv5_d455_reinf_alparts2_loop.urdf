  <joint name="R_hip_pitch_joint" type="revolute">
    <origin xyz="0 -0.1237 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="R_hip_pitch_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0943951023931953" upper="0.4363323129985824" effort="120" velocity="20"/>
    <dynamics damping="0.0275" friction="0.519"/>
    <!-- armature (reflected rotor inertia) = 0.0773 kg*m^2 : no standard URDF field; see the sidecar .motor_params.json -->
  </joint>
  <joint name="R_hip_roll_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="R_hip_pitch_link"/>
    <child link="R_hip_roll_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.4363323129985824" upper="1.4835298641951802" effort="120" velocity="20"/>
    <dynamics damping="0.0275" friction="0.519"/>
    <!-- armature (reflected rotor inertia) = 0.0773 kg*m^2 : no standard URDF field; see the sidecar .motor_params.json -->
  </joint>
  <joint name="R_hip_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
