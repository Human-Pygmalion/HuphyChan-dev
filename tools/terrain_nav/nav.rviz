Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Map 10 cm
      Enabled: true
      Topic:
        Value: /map_cloud_010
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Color Transformer: RGB8
      Alpha: 1.0
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Map 5 cm
      Enabled: false
      Topic:
        Value: /map_cloud_005
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 1
      Size (m): 0.05
      Color Transformer: RGB8
      Alpha: 1.0
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Map full (17.5 M points)
      Enabled: false
      Topic:
        Value: /map_cloud_full
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 1
      Size (m): 0.05
      Color Transformer: RGB8
      Alpha: 1.0
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Terrain mesh (= collider)
      Enabled: true
      Topic:
        Value: /terrain_mesh
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain classes
      Enabled: false
      Topic:
        Value: /semantic_cloud
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Flat Squares
      Size (Pixels): 2
      Size (m): 0.25
      Color Transformer: RGB8
      Alpha: 0.45
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot
      Enabled: true
      Topic:
        Value: /robot_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Path
      Enabled: true
      Topic:
        Value: /plan_line
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Start / goal
      Enabled: true
      Topic:
        Value: /nav_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
  Global Options:
    Background Color: 12; 15; 20
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: -0.1
      Pitch: 0.32
      Yaw: 3.55
      Near Clip Distance: 0.05
      Target Frame: base_link
Window Geometry:
  Height: 1080
  Width: 1920
  X: 0
  Y: 0
